(mi)
(lt)
(start 'play (get-continue-by-name *game-info* "game-start"))
(set! (-> *pc-settings* gfx-msaa) 4)
(set! (-> *pc-settings* hires-clouds?) #t)
(set! (-> *pc-settings* lod-force-tfrag) 0)
(set! (-> *pc-settings* lod-force-tie) 0)
(pc-set-display-mode! 'windowed 1600 900)
(send-event (ppointer->process *time-of-day*) 'change 'ratio 0.0)
(send-event (ppointer->process *time-of-day*) 'change 'hour 9)
(set! (-> *screen-shot-settings* width) 1920)
(set! (-> *screen-shot-settings* height) 1080)
(set! (-> *screen-shot-settings* msaa) 4)
(format 0 "ARENA-BASELINE-READY~%")
