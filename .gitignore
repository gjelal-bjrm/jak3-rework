# ---- Fichiers objets MSVC produits par les tests
*.obj

# ---- Sauvegarde locale des habitants a l echelle 1 (scale_actors.py)
**/scale-backup/

# ---- Lot R5 marche : export natif volumineux, regenerable par le bridge
city-remaster/city-block-v3/market-windows-r5/native-market.json
city-remaster/city-block-v3/market-windows-r5/survey.json

# ---- Remise en etat des maisons pilotes : export natif volumineux, regenerable
city-remaster/city-block-v3/pilot-houses-restore/native-pilot-current.json
# ---- Captures du tour de controle du lanceur (--tour)
/qa/

# ---- Exports natifs autour de chaque fenetre (fit_rooms.py), regenerables
city-remaster/city-block-v3/interiors/fit/

city-remaster/city-block-v3/east-house-restore/native-east-current.json
models-v2/shore/beach-native.json
lanceur-choix.json

# Kit ChatGPT de l arene : contient des textures du jeu
/arena-remaster/chatgpt/
# Objets de l arene : exports natifs et .blend (geometrie et textures du jeu) hors Git
/arena-remaster/objects/*-native.json
/arena-remaster/objects/*.blend
/arena-remaster/objects/*.blend1
# Falaises de l arene : export natif, patch (geometrie derivee du jeu), apercus (textures du jeu), journaux
/arena-remaster/rocks/*-native.json
/arena-remaster/rocks/*-patch.json
/arena-remaster/rocks/preview/
/arena-remaster/rocks/*.log
/arena-remaster/rocks/log-*.txt
# Textures HD de l arene (derivees des textures du jeu) et journaux
/arena-remaster/textures/out/
/arena-remaster/textures/textures-*.json
/arena-remaster/textures/*.log
# Replaquage des textures de l arene : exports natifs, patchs, selections
/arena-remaster/uv/*-native.json
/arena-remaster/uv/sel-*.json
/arena-remaster/uv/log-*.txt
# Kit Codex de tout le decor (contient des textures du jeu)
/textures-remaster/codex/
