;; REMASTER-SAND-STEPS-BEGIN
;; Private launcher: no particle/group ID is allocated or overwritten.
(defmacro remaster-sand-private-launcher (specs)
  (set! *last-field-id* -1)
  `(new 'static 'sparticle-launcher
        :init-specs (new 'static 'inline-array sp-field-init-spec ,(1+ (length specs))
                        ,@(apply process-init-spec specs)
                        (new 'static 'sp-field-init-spec :field (sp-field-id spt-end))
                        ))
  )

(define *remaster-sand-step-launcher*
  (remaster-sand-private-launcher
    ((:texture (dirtpuff01 level-default-sprite))
     (:num 2.0)
     (:x (meters -0.035) (meters 0.07))
     (:y (meters 0.018))
     (:z (meters -0.035) (meters 0.07))
     (:scale-x (meters 0.11) (meters 0.045))
     (:rot-z (degrees 0) (degrees 360))
     (:scale-y (meters 0.055) (meters 0.025))
     (:r 112.0)
     (:g 100.0)
     (:b 76.0)
     (:a 10.0 4.0)
     (:vel-x (meters -0.00075) (meters 0.0015))
     (:vel-y (meters 0.002) (meters 0.0015))
     (:vel-z (meters -0.00075) (meters 0.0015))
     (:scalevel-x (meters 0.0025))
     (:scalevel-y (meters 0.001))
     (:fade-a -0.7)
     (:friction 0.92)
     (:timer (seconds 0.24) (seconds 0.06))
     (:flags (sp-cpuinfo-flag-2 sp-cpuinfo-flag-13 sp-cpuinfo-flag-14))
     ))
  )

(define *remaster-sand-step-enabled* #t)
(define *remaster-sand-step-events* 0)
(define *remaster-sand-step-eligible* 0)
(define *remaster-sand-step-emitted* 0)
(define *remaster-sand-step-npc-emitted* 0)
(define *remaster-sand-step-suppressed-poofs* 0)
(define *remaster-sand-step-last-material* -1)
(define *remaster-sand-step-last-level* 'none)
(define *remaster-sand-step-last-joint* -1)
(define *remaster-sand-step-last-position* (new 'static 'vector :w 1.0))
(define *remaster-sand-step-visual-rejected* 0)

(defun remaster-sand-npc-foot-joint ((proc process-drawable))
  ;; Wlander footstep tags omit effect-joint. Both native rigs contain Lball
  ;; and Rball: choose the foot closest to the real contact plane this frame.
  (let* ((left (cspace-index-by-name proc "Lball"))
         (right (cspace-index-by-name proc "Rball"))
         (moving (the-as collide-shape-moving (-> proc root)))
         )
    (cond
      ((and (>= left 0) (>= right 0))
       (let* ((lp (vector<-cspace! (new 'stack-no-clear 'vector) (-> proc node-list data left)))
              (rp (vector<-cspace! (new 'stack-no-clear 'vector) (-> proc node-list data right)))
              (ground (-> moving ground-touch-point))
              (normal (-> moving ground-poly-normal))
              )
         (vector-! lp lp ground)
         (vector-! rp rp ground)
         (if (<= (fabs (vector-dot lp normal)) (fabs (vector-dot rp normal))) left right)))
      ((>= left 0) left)
      ((>= right 0) right)
      (else -1)
      )
    )
  )

(defun remaster-sand-visible-at? ((pos vector))
  ;; The grid narrows the candidates only. Actual triangle membership and
  ;; interpolated height decide whether the visible surface is sand.
  (let* ((x (- (* (-> pos x) 0.000244140625) remaster-sand-origin-x))
         (z (- (* (-> pos z) 0.000244140625) remaster-sand-origin-z))
         (y (* (-> pos y) 0.000244140625))
         (found #f)
         )
    (when (and (>= x 0.0) (>= z 0.0)
               (< x (* 8.0 (the float remaster-sand-grid-x)))
               (< z (* 8.0 (the float remaster-sand-grid-z))))
      (let* ((cell (+ (the int (* x 0.125))
                     (* remaster-sand-grid-x (the int (* z 0.125)))))
             (cursor (-> *remaster-sand-cell-starts* cell))
             (end (-> *remaster-sand-cell-starts* (+ cell 1)))
             )
        (while (< cursor end)
          (let* ((row (* 11 (-> *remaster-sand-cell-tris* cursor)))
                 (dx (- x (-> *remaster-sand-triangles* row)))
                 (dz (- z (-> *remaster-sand-triangles* (+ row 1))))
                 (v (* (- (* dx (-> *remaster-sand-triangles* (+ row 5)))
                          (* dz (-> *remaster-sand-triangles* (+ row 4))))
                       (-> *remaster-sand-triangles* (+ row 9))))
                 (w (* (- (* (-> *remaster-sand-triangles* (+ row 2)) dz)
                          (* (-> *remaster-sand-triangles* (+ row 3)) dx))
                       (-> *remaster-sand-triangles* (+ row 9))))
                 )
            (when (and (>= v -0.00002) (>= w -0.00002) (<= (+ v w) 1.00002)
                       (<= (fabs (- y (+ (-> *remaster-sand-triangles* (+ row 6))
                                         (* v (-> *remaster-sand-triangles* (+ row 7)))
                                         (* w (-> *remaster-sand-triangles* (+ row 8))))))
                           0.18))
              ;; A road, rock, plank, stair or other surface over the sand wins.
              (if (= (-> *remaster-sand-triangles* (+ row 10)) 0.0)
                  (return #f)
                  (set! found #t)))
            )
          (+! cursor 1)
          )
        )
      )
    found
    )
  )

(defun remaster-sand-foot-position ((ec effect-control) (joint int) (pos vector))
  (let* ((proc (-> ec process))
         (moving (the-as collide-shape-moving (-> proc root)))
         (ground (-> moving ground-touch-point))
         (normal (-> moving ground-poly-normal))
         )
    (if (and (>= joint 0) (-> proc node-list) (< joint (-> proc node-list length)))
        (vector<-cspace! pos (-> proc node-list data joint))
        (vector-copy! pos ground))
    (if (> (-> normal y) 0.45)
        (set! (-> pos y)
              (- (-> ground y)
                 (/ (+ (* (- (-> pos x) (-> ground x)) (-> normal x))
                       (* (- (-> pos z) (-> ground z)) (-> normal z)))
                    (-> normal y))))
        (set! (-> pos y) (-> ground y)))
    (set! (-> pos w) 1.0)
    pos
    )
  )

(defun remaster-sand-step-contact? ((ec effect-control) (surface pat-surface) (joint int))
  (let* ((proc (-> ec process))
         (focus (as-type proc process-focusable))
         (moving (as-type (-> proc root) collide-shape-moving))
         (level (level-get-target-inside *level*))
         )
    (and *remaster-sand-step-enabled*
         level
         (or (= (-> level name) 'wascitya) (= (-> level name) 'wascityb))
         focus moving
         ;; WCA's visible sand uses the same PAT dirt as some hard surfaces.
         ;; Material is a first filter, never a substitute for the mesh test.
         (or (= (-> surface material) (pat-material sand))
             (= (-> surface material) (pat-material dirt)))
         (= (-> moving ground-pat material) (-> surface material))
         (logtest? (-> moving status) (collide-status on-ground))
         (not (focus-test? focus in-air))
         (not (focus-test? focus touch-water))
         (let ((visible? (remaster-sand-visible-at?
                           (remaster-sand-foot-position ec joint (new 'stack-no-clear 'vector)))))
           (unless visible? (+! *remaster-sand-step-visual-rejected* 1))
           visible?)
         )
    )
  )

(defun remaster-sand-step-emit ((ec effect-control) (joint int))
  (let* ((proc (-> ec process))
         (mat (matrix-identity! (new 'stack-no-clear 'matrix)))
         (pos (-> mat trans))
         )
    ;; Use the animation's actual foot joint; project onto the native contact
    ;; plane so the small dust patch follows slopes and stays close to the sand.
    (remaster-sand-foot-position ec joint pos)
    (vector-copy! *remaster-sand-step-last-position* pos)
    (set! *remaster-sand-step-last-joint* joint)
    (sp-launch-particles-var *sp-particle-system-2d* *remaster-sand-step-launcher*
                            mat (the-as sparticle-launch-state #f)
                            (the-as sparticle-launch-control #f) 1.0)
    (+! *remaster-sand-step-emitted* 1)
    (when (!= proc (the-as process-drawable *target*))
      (+! *remaster-sand-step-npc-emitted* 1))
    )
  (none)
  )
;; REMASTER-SAND-STEPS-END
