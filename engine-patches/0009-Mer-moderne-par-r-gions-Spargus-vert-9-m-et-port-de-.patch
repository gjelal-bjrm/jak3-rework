+  }
+  static bool inside(const OceanRegion& r, float x, float y, float z) {
+    return x >= r.origin_x && x < r.origin_x + r.size * 3.f && z >= r.origin_z && z < r.origin_z + r.size * 3.f &&
+           y > r.y_min && y < r.y_max;
