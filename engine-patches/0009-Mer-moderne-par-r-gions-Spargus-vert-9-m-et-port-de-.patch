+// Region de mer : niveau, palette, masque de cote et bornes. La region est choisie d'apres les niveaux
+// charges (Spargus : was*, Haven : cty*) puis la position de la camera dans la carte d'ocean native.
+struct OceanRegion {
+  const char* name;
+  const char* level_prefix;            // prefixe des niveaux natifs de la region
+  float level;                         // hauteur de la mer (m) = y du start-corner de la carte native
+  float y_min, y_max;                  // hauteurs de camera ou le rendu est actif
+  float origin_x, origin_z; int size;  // carte d'ocean native, cellules de 3 m
+  bool (*cell)(int, int);
+  bool (*contains)(float, float);
+  float shallow[3], deep[3], far_[3], absorb[3], tint[3], body[3];
+  float swell;                         // amplitude des grandes vagues (1 = large, 0,35 = bassin abrite)
+};
+// Spargus : eau vert d'eau (validee par l'utilisateur).
+inline const OceanRegion OCEAN_SPARGUS{"spargus", "was", 9.f, -60.f, 180.f,
+  OceanCoastMask::ORIGIN_X, OceanCoastMask::ORIGIN_Z, OceanCoastMask::SIZE, OceanCoastMask::cell, OceanCoastMask::contains,
+  {.21f, .54f, .45f}, {.03f, .21f, .17f}, {.22f, .35f, .29f}, {.62f, .16f, .24f}, {.93f, 1.f, .92f}, {.061f, .091f, .077f}, 1.f};
+// Haven : eau bleu sombre. Reference : port natif mesure a (0,06 0,15 0,16) pres et (0,15 0,22 0,23) loin,
+// tire vers le bleu a la demande de l'utilisateur.
+inline const OceanRegion OCEAN_HAVEN{"haven", "cty", OceanCoastMaskCity::LEVEL, -80.f, 260.f,
+  OceanCoastMaskCity::ORIGIN_X, OceanCoastMaskCity::ORIGIN_Z, OceanCoastMaskCity::SIZE, OceanCoastMaskCity::cell, OceanCoastMaskCity::contains,
+  {.09f, .22f, .36f}, {.015f, .05f, .13f}, {.13f, .19f, .30f}, {.70f, .36f, .14f}, {.92f, .95f, 1.f}, {.02f, .06f, .12f}, .35f};
