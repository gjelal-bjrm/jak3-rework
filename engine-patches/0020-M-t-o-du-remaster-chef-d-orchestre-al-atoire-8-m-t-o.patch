diff --git a/game/graphics/opengl_renderer/WeatherState.h b/game/graphics/opengl_renderer/WeatherState.h
new file mode 100644
index 00000000..931e80fb
--- /dev/null
+++ b/game/graphics/opengl_renderer/WeatherState.h
@@ -0,0 +1,182 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <random>
+
+#include "common/log/log.h"
+
+// Meteo du remaster : un chef d'orchestre choisit une meteo au hasard (ponderee par region et par
+// heure), la fait durer quelques minutes puis passe a la suivante par un fondu. Il pilote :
+//  - le systeme natif de Jak 3 (mood-control : tables de lumiere couverte, pluie native, eclairs,
+//    tonnerre, son de pluie, neige), via l'echange pc-remaster-weather appele par mood.gc ;
+//  - le rendu moderne : nuages volumiques (couverture, type, bases sombres, vent), pluie, neige, sable,
+//    brouillard (ModernWeather.h), sol mouille / flaques / neige au sol (tfrag3.frag).
+// Le sol seche et la neige fond lentement apres la fin des precipitations.
+namespace WeatherState {
+
+enum Kind { CLEAR = 0, HAZY, OVERCAST, DRIZZLE, STORM, SNOW, SANDSTORM, FOG, COUNT };
+inline const char* const kNames[COUNT] = {"beau-temps", "voile", "couvert", "pluie", "orage",
+                                          "neige", "tempete-de-sable", "brouillard"};
+
+struct Params {
+  float native_cloud, native_fog;       // mood-control (lumiere couverte native ; fog .5 = neutre)
+  float rain, snow, sand, fog;          // intensites 0..1 du rendu moderne
+  float coverage, type, density, darkness, cirrus;   // nuages
+  float wind;                           // m/s (nuages, pluie oblique, neige, sable)
+  float lightning;                      // 1 : eclairs et tonnerre natifs
+  float sun;                            // lumiere directe restante (reflets, eclat du soleil)
+};
+
+inline Params preset(int k) {
+  switch (k) {
+    //                 cloud fog   rain snow sand fog   cov  type dens dark cirr  wind  light sun
+    case HAZY:      return {.40f, .50f, 0.f, 0.f, 0.f, .10f, .38f, .30f, .85f, .10f, 1.f, 5.f, 0.f, .75f};
+    case OVERCAST:  return {.62f, .50f, 0.f, 0.f, 0.f, .08f, .86f, .55f, 1.1f, .45f, .3f, 6.f, 0.f, .25f};
+    case DRIZZLE:   return {.78f, .55f, .45f, 0.f, 0.f, .22f, .94f, .50f, 1.2f, .60f, 0.f, 6.f, 0.f, .12f};
+    case STORM:     return {1.0f, .65f, 1.0f, 0.f, 0.f, .32f, 1.0f, .90f, 1.4f, .90f, 0.f, 11.f, 1.f, .04f};
+    case SNOW:      return {.66f, .55f, 0.f, 1.0f, 0.f, .28f, .92f, .40f, 1.1f, .35f, 0.f, 3.f, 0.f, .15f};
+    case SANDSTORM: return {.55f, .50f, 0.f, 0.f, 1.0f, 0.f, .30f, .35f, .8f, .20f, .2f, 14.f, 0.f, .35f};
+    case FOG:       return {.45f, .50f, 0.f, 0.f, 0.f, 1.0f, .60f, .30f, .9f, .20f, .1f, 1.5f, 0.f, .45f};
+    default:        return {.20f, .50f, 0.f, 0.f, 0.f, 0.f, .44f, .40f, 1.f, 0.f, .6f, 4.f, 0.f, 1.f};
+  }
+}
+inline Params mix(const Params& a, const Params& b, float t) {
+  Params r;
+  const float* pa = &a.native_cloud; const float* pb = &b.native_cloud; float* pr = &r.native_cloud;
+  for (size_t i = 0; i < sizeof(Params) / sizeof(float); ++i) pr[i] = pa[i] + (pb[i] - pa[i]) * t;
+  return r;
+}
+
+enum Region { REGION_OTHER = 0, REGION_SPARGUS, REGION_HAVEN, REGION_DESERT };
+
+// ---- etat partage (fil de rendu <-> fil du jeu)
+inline std::mutex mutex;
+inline Params current = preset(CLEAR);
+inline int from_kind = CLEAR, to_kind = CLEAR;
+inline float blend = 1.f;                 // 0 = from, 1 = to
+inline float transition = 60.f;           // duree du fondu en cours (s)
+inline float remaining = 300.f;           // temps restant avant la meteo suivante (s)
+inline int forced = -1;                   // meteo imposee (commande de test) ou -1
+inline bool started = false;
+inline float wetness = 0.f, puddles = 0.f, snow_cover = 0.f;
+inline float outdoor = 1.f;               // exterior-level natif (0 a l'interieur)
+inline float native_flash = 0.f;          // eclair natif en cours (lumiere)
+inline int native_flash_index = 0;
+inline float flash = 0.f;                 // eclair dans les nuages (0..1)
+inline std::array<float, 3> flash_dir{0.f, .3f, 1.f};
+inline float flash_seed = 0.f;           // forme du trait de foudre
+inline int region = REGION_OTHER;
+inline float test_flash = 0.f;            // commande de test : eclair tenu (s)
+inline std::mt19937 rng{std::random_device{}()};
+
+inline float urand(float a, float b) { return std::uniform_real_distribution<float>(a, b)(rng); }
+
+// Tirage de la meteo suivante : poids par region, brouillard seulement le matin, pas deux fois de suite
+// la meme meteo speciale.
+inline int pick(int reg, float hour, int previous) {
+  std::array<float, COUNT> w{};
+  switch (reg) {
+    case REGION_SPARGUS: w = {42, 18, 12, 8, 4, 0, 12, 0}; break;
+    case REGION_DESERT:  w = {45, 15, 8, 3, 2, 0, 25, 0}; break;
+    case REGION_HAVEN:   w = {28, 16, 16, 15, 10, 5, 0, 10}; break;
+    default:             w = {40, 20, 20, 10, 5, 0, 0, 5}; break;
+  }
+  const bool morning = hour > 4.5f && hour < 10.f;
+  if (!morning) w[FOG] = 0;
+  else w[FOG] *= 2.5f;
+  if (previous >= DRIZZLE) w[previous] *= .25f;
+  float total = 0; for (float x : w) total += x;
+  float r = urand(0.f, total);
+  for (int k = 0; k < COUNT; ++k) { if (r < w[k]) return k; r -= w[k]; }
+  return CLEAR;
+}
+
+// Appele une fois par image par le rendu. `hour` : heure du jour ; dt en secondes.
+inline void update(float dt, int reg, float hour) {
+  std::lock_guard<std::mutex> guard(mutex);
+  static Params from_params = preset(CLEAR);
+  region = reg;
+  if (!started) {
+    started = true;
+    to_kind = pick(reg, hour, -1); from_kind = to_kind; blend = 1.f;
+    current = preset(to_kind); from_params = current;
+    remaining = urand(240.f, 540.f);
+    lg::info("Meteo initiale : {}", kNames[to_kind]);
+  }
+  auto begin = [&](int kind, float fade) {
+    from_params = current; from_kind = to_kind; to_kind = kind;
+    transition = std::max(fade, .01f); blend = fade <= 0.f ? 1.f : 0.f;
+    lg::info("Meteo : {} (fondu {:.0f} s)", kNames[kind], fade);
+  };
+  if (forced >= 0 && forced != to_kind) begin(forced, 4.f);
+  if (forced < 0) {
+    remaining -= dt;
+    if (remaining <= 0.f) {
+      begin(pick(reg, hour, to_kind), urand(45.f, 90.f));
+      remaining = urand(240.f, 600.f);
+    }
+  }
+  // Changement de region (Spargus -> Haven) : une tempete de sable n'a rien a faire au port.
+  if (forced < 0 && to_kind == SANDSTORM && reg == REGION_HAVEN) begin(OVERCAST, 20.f);
+  if (forced < 0 && (to_kind == SNOW || to_kind == FOG) && (reg == REGION_SPARGUS || reg == REGION_DESERT))
+    begin(CLEAR, 20.f);
+  blend = std::min(1.f, blend + dt / transition);
+  const float s = blend * blend * (3.f - 2.f * blend);
+  current = mix(from_params, preset(to_kind), s);
+
+  // Sol mouille : se mouille en ~25 s sous la pluie, seche en ~3 min ; flaques plus lentes.
+  const float rain = current.rain * outdoor, snow = current.snow * outdoor;
+  auto approach = [dt](float& v, float target, float up, float down) {
+    const float tau = target > v ? up : down;
+    v += (target - v) * (1.f - std::exp(-dt / tau));
+  };
+  approach(wetness, rain > .05f ? std::min(1.f, .55f + rain) : 0.f, 25.f, 180.f);
+  approach(puddles, rain > .05f ? rain : 0.f, 60.f, 240.f);
+  approach(snow_cover, snow > .05f ? snow : 0.f, 70.f, 300.f);
+  if (forced >= 0 && blend >= 1.f && dt > 0.f) {
+    // meteo imposee pour un test : etat installe tout de suite (captures)
+    const float wet_target = rain > .05f ? std::min(1.f, .55f + rain) : 0.f;
+    wetness = wet_target; puddles = rain > .05f ? rain : 0.f; snow_cover = snow > .05f ? snow : 0.f;
+  }
+
+  // Eclairs dans les nuages : suivent l'eclair natif (meme instant que le tonnerre et la lumiere).
+  static float last_native = 0.f;
+  float native = native_flash;
+  if (test_flash > 0.f) { test_flash -= dt; native = std::max(native, .5f); }
+  if (native > .01f && last_native <= .01f) {
+    const float az = urand(0.f, 6.2831853f), el = urand(.08f, .45f);
+    flash_dir = {std::cos(az) * std::cos(el), std::sin(el), std::sin(az) * std::cos(el)};
+    flash_seed = urand(0.f, 97.f);
+    lg::info("Meteo : eclair (intensite native {:.2f}, indice {})", native_flash, native_flash_index);
+  }
+  last_native = native;
+  flash = std::clamp(native * 3.f, 0.f, 1.f) * std::max(current.lightning, test_flash > 0.f ? 1.f : 0.f);
+}
+
+// Echange avec GOAL (fil du jeu), appele par mood.gc (init-weather!) a chaque image.
+// io[0] = max-rain du niveau, io[1] = eclair natif, io[2] = indice d'eclair, io[4] = exterieur (1/0)
+// io[8] = actif, io[9] = nuages natifs, io[10] = brouillard natif, io[11] = pluie native,
+// io[12] = neige native, io[13] = eclairs natifs autorises
+inline void exchange(float* io) {
+  std::lock_guard<std::mutex> guard(mutex);
+  if (std::isfinite(io[4])) outdoor = std::clamp(io[4], 0.f, 1.f);   // exterior-level natif
+  if (std::isfinite(io[1])) native_flash = std::max(0.f, io[1]);
+  native_flash_index = int(io[2]);
+  io[8] = started ? 1.f : 0.f;
+  io[9] = current.native_cloud;
+  io[10] = current.native_fog;
+  io[11] = std::min(.75f, current.rain * .75f);
+  io[12] = 0.f;   // neige native (points etires en traits bleutes) coupee : flocons modernes
+  io[13] = current.lightning > .5f ? 1.f : 0.f;
+}
+
+inline void force(int kind) {
+  std::lock_guard<std::mutex> guard(mutex);
+  if (kind == 100) { test_flash = 2.f; return; }   // test : eclair tenu 2 s (captures)
+  forced = (kind >= 0 && kind < COUNT) ? kind : -1;
+  if (forced < 0) { remaining = urand(60.f, 180.f); lg::info("Meteo : retour au hasard"); }
+}
+}  // namespace WeatherState
