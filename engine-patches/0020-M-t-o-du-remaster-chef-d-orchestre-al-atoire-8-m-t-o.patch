diff --git a/game/graphics/opengl_renderer/ModernWeather.h b/game/graphics/opengl_renderer/ModernWeather.h
new file mode 100644
index 00000000..a5e2cc23
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernWeather.h
@@ -0,0 +1,217 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <memory>
+#include "common/log/log.h"
+#include "common/util/FileUtil.h"
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/SkyState.h"
+#include "game/graphics/opengl_renderer/WeatherState.h"
+#include "game/graphics/opengl_renderer/WeatherWorld.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/ocean/ModernOcean.h"
+
+// Rendu de la meteo du remaster.
+//  update() (debut de BUCKET567, avant le ciel) : region, chef d'orchestre (WeatherState), couleurs du
+//    moment (ciel couvert, brouillard, gouttes) publiees pour le ciel, le decor et cette passe ;
+//  render() (apres les particules et la distorsion, avant l'interface) : atmosphere plein ecran
+//    (voile, brouillard matinal, sable) puis precipitations instanciees en 3D (pluie, neige, sable).
+// Shaders recharges a chaud depuis data/ (reglages en direct).
+class ModernWeather {
+ public:
+  ~ModernWeather() { if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+
+  void update(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    if (m_updated_frame == state->frame_idx) return;
+    m_updated_frame = state->frame_idx;
+    const float now = LiquidSnapshot::seconds();
+    const float dt = m_last_time < 0.f ? 0.f : std::clamp(now - m_last_time, 0.f, .1f);
+    m_last_time = now;
+    std::array<float, 3> sun, moon; float hour; bool valid;
+    {
+      std::lock_guard<std::mutex> guard(SkyState::mutex);
+      sun = SkyState::sun; moon = SkyState::moon; hour = SkyState::hour; valid = SkyState::valid;
+    }
+    if (!valid) return;
+    int region = WeatherState::REGION_OTHER;
+    if (ModernOcean::level_loaded(state, "was")) region = WeatherState::REGION_SPARGUS;
+    else if (ModernOcean::level_loaded(state, "cty")) region = WeatherState::REGION_HAVEN;
+    else if (ModernOcean::level_loaded(state, "des")) region = WeatherState::REGION_DESERT;
+    WeatherState::update(dt, region, hour);
+    WeatherState::Params p; float flash;
+    {
+      std::lock_guard<std::mutex> guard(WeatherState::mutex);
+      p = WeatherState::current; flash = WeatherState::flash;
+    }
+    // Couleurs du moment : jour clair / aube / nuit, assombries par la couverture.
+    const float dayness = smooth(-.08f, .06f, sun[1]);
+    const float sun_up = std::clamp(sun[1] * 2.5f, 0.f, 1.f);
+    const V3 day{.60f, .66f, .74f}, dusk{.66f, .50f, .44f}, night{.035f, .045f, .075f};
+    V3 ambient = mix(night, mix(dusk, day, sun_up), dayness);
+    const float gloom = 1.f - .6f * p.darkness;
+    ambient = ambient * gloom;
+    const float luma = ambient.x * .3f + ambient.y * .59f + ambient.z * .11f;
+    m_fog_color = mix(ambient, V3{luma, luma * 1.02f, luma * 1.06f}, .45f);
+    m_sand_color = V3{.74f, .56f, .37f} * (dayness * .85f + .08f) * (1.f - .25f * p.darkness);
+    const V3 sc = mix(V3{1.f, .55f, .30f}, V3{1.f, .95f, .86f}, sun_up);
+    m_sun_color = sc * (dayness * p.sun);
+    m_sun_dir = dayness > .02f ? V3{sun[0], sun[1], sun[2]} : V3{moon[0], moon[1], moon[2]};
+    if (dayness <= .02f) m_sun_color = V3{.12f, .14f, .2f} * p.sun;
+    m_drop_color = ambient * 1.45f + m_sun_color * .12f + V3{.7f, .75f, .9f} * flash;
+    m_params = p; m_flash = flash; m_region = region;
+    {
+      std::lock_guard<std::mutex> guard(WeatherLook::mutex);
+      const V3 sky = ambient * 1.05f + V3{.6f, .65f, .8f} * (flash * .25f);
+      WeatherLook::sky = {sky.x, sky.y, sky.z};
+      WeatherLook::sun_dir = {m_sun_dir.x, m_sun_dir.y, m_sun_dir.z};
+      WeatherLook::sun_color = {m_sun_color.x, m_sun_color.y, m_sun_color.z};
+      WeatherLook::time = now;
+    }
+  }
+
+  void render(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    float outdoor;
+    { std::lock_guard<std::mutex> guard(WeatherState::mutex); outdoor = WeatherState::outdoor; }
+    const auto& p = m_params;
+    const float rain = p.rain * outdoor, snow = p.snow * outdoor, sand = p.sand * outdoor;
+    const float fog = p.fog * outdoor;
+    if (rain < .01f && snow < .01f && sand < .01f && fog < .01f) return;
+    hot_reload();
+
+    GLint program, old_vao, depth_func, old_active, viewport[4];
+    GLboolean depth_write, color_mask[4];
+    GLint src_rgb, dst_rgb, src_a, dst_a, eq_rgb, eq_a;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &old_vao);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func); glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+    glGetBooleanv(GL_COLOR_WRITEMASK, color_mask); glGetIntegerv(GL_ACTIVE_TEXTURE, &old_active);
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb); glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_a); glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_a);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_a);
+    GLint saved25, saved26;
+    glActiveTexture(GL_TEXTURE25); glGetIntegerv(GL_TEXTURE_BINDING_2D, &saved25);
+    glActiveTexture(GL_TEXTURE26); glGetIntegerv(GL_TEXTURE_BINDING_2D, &saved26);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST};
+    GLboolean was[5];
+    for (int i = 0; i < 5; i++) { was[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+    glDepthMask(GL_FALSE); glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glEnable(GL_BLEND); glBlendEquation(GL_FUNC_ADD); glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    if (!m_vao) glGenVertexArrays(1, &m_vao);
+    glBindVertexArray(m_vao);
+    const float now = LiquidSnapshot::seconds();
+    const auto eye = state->camera_pos / 4096.f;
+    const float wind_x = p.wind * .8f, wind_z = p.wind * .6f;
+
+    // ---- 1. Atmosphere
+    if (!m_fog) m_fog = std::make_unique<Shader>("modern_weather_fog", state->version);
+    if (m_fog->okay()) {
+      m_fog->activate(); const GLuint id = m_fog->id();
+      m_snapshot.bind(state, id);
+      glUniform1i(glGetUniformLocation(id, "tex_T26"), 26);
+      glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
+      glUniform3f(glGetUniformLocation(id, "wx_eye"), eye[0], eye[1], eye[2]);
+      glUniform1f(glGetUniformLocation(id, "wx_time"), now);
+      glUniform3f(glGetUniformLocation(id, "wx_sun"), m_sun_dir.x, m_sun_dir.y, m_sun_dir.z);
+      glUniform3f(glGetUniformLocation(id, "wx_sun_color"), m_sun_color.x, m_sun_color.y, m_sun_color.z);
+      glUniform3f(glGetUniformLocation(id, "wx_fog_color"), m_fog_color.x, m_fog_color.y, m_fog_color.z);
+      glUniform3f(glGetUniformLocation(id, "wx_sand_color"), m_sand_color.x, m_sand_color.y, m_sand_color.z);
+      // densites calculees dans le shader (reglables a chaud) a partir des intensites de la meteo
+      glUniform1f(glGetUniformLocation(id, "wx_fog"), fog);
+      glUniform1f(glGetUniformLocation(id, "wx_rain"), rain);
+      glUniform1f(glGetUniformLocation(id, "wx_snow"), snow);
+      // brouillard au ras de l'eau : port de Haven a 0 m, baie de Spargus a 9 m
+      glUniform1f(glGetUniformLocation(id, "wx_ground_level"), m_region == WeatherState::REGION_SPARGUS ? 9.f : 0.f);
+      glUniform1f(glGetUniformLocation(id, "wx_ground_height"), 14.f);
+      glUniform1f(glGetUniformLocation(id, "wx_sand"), sand);
+      glUniform2f(glGetUniformLocation(id, "wx_wind"), wind_x, wind_z);
+      glUniform1f(glGetUniformLocation(id, "wx_flash"), m_flash);
+      glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+
+    // ---- 2. Precipitations
+    if (!m_particles) m_particles = std::make_unique<Shader>("modern_weather_particles", state->version);
+    if (m_particles->okay() && (rain > .01f || snow > .01f || sand > .01f)) {
+      m_particles->activate(); const GLuint id = m_particles->id();
+      glEnable(GL_DEPTH_TEST); glDepthFunc(GL_GEQUAL);
+      glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
+      glUniform4fv(glGetUniformLocation(id, "cam_trans"), 1, state->camera_pos.data());
+      glUniform1f(glGetUniformLocation(id, "wx_time"), now);
+      glUniform2f(glGetUniformLocation(id, "wx_wind"), wind_x, wind_z);
+      glUniform2f(glGetUniformLocation(id, "wx_viewport"), float(viewport[2]), float(viewport[3]));
+      auto draw = [&](int kind, int layer, float amount, float bx, float by, float bz, int max_count, float alpha, V3 light) {
+        glUniform1i(glGetUniformLocation(id, "wx_kind"), kind);
+        glUniform1i(glGetUniformLocation(id, "wx_layer"), layer);
+        glUniform3f(glGetUniformLocation(id, "wx_box"), bx, by, bz);
+        glUniform1f(glGetUniformLocation(id, "wx_alpha"), alpha);
+        glUniform3f(glGetUniformLocation(id, "wx_light"), light.x, light.y, light.z);
+        const int count = int(float(max_count) * std::clamp(amount, 0.f, 1.f));
+        if (count > 0) glDrawArraysInstanced(GL_TRIANGLES, 0, 6, count);
+      };
+      // deux couches : gouttes proches denses (bien visibles) et rideau lointain
+      if (rain > .01f) {
+        draw(0, 0, rain, 12.f, 10.f, 12.f, 16000, .42f, m_drop_color);
+        draw(0, 1, rain, 44.f, 28.f, 44.f, 60000, .34f, m_drop_color);
+      }
+      if (snow > .01f) {
+        draw(1, 0, snow, 12.f, 10.f, 12.f, 6000, .9f, m_drop_color * 1.35f + m_sun_color * .25f);
+        draw(1, 1, snow, 34.f, 22.f, 34.f, 26000, .85f, m_drop_color * 1.35f + m_sun_color * .25f);
+      }
+      if (sand > .01f) {
+        draw(2, 0, sand, 14.f, 8.f, 14.f, 14000, .5f, m_sand_color * 1.1f + m_sun_color * .15f);
+        draw(2, 1, sand, 44.f, 14.f, 44.f, 40000, .45f, m_sand_color * 1.1f + m_sun_color * .15f);
+      }
+    }
+
+    glUseProgram(program); glBindVertexArray(old_vao); glDepthFunc(depth_func); glDepthMask(depth_write);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+    glBlendFuncSeparate(src_rgb, dst_rgb, src_a, dst_a); glBlendEquationSeparate(eq_rgb, eq_a);
+    for (int i = 0; i < 5; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+    glActiveTexture(GL_TEXTURE25); glBindTexture(GL_TEXTURE_2D, saved25);
+    glActiveTexture(GL_TEXTURE26); glBindTexture(GL_TEXTURE_2D, saved26);
+    glActiveTexture(old_active);
+  }
+
+ private:
+  struct V3 {
+    float x, y, z;
+    V3 operator*(float s) const { return {x * s, y * s, z * s}; }
+    V3 operator+(const V3& o) const { return {x + o.x, y + o.y, z + o.z}; }
+  };
+  static V3 mix(const V3& a, const V3& b, float t) { return {a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t}; }
+  static float smooth(float e0, float e1, float x) {
+    const float t = std::clamp((x - e0) / (e1 - e0), 0.f, 1.f);
+    return t * t * (3.f - 2.f * t);
+  }
+  void hot_reload() {
+    if (++m_reload_counter % 30) return;
+    const char* names[] = {"modern_weather_fog.vert", "modern_weather_fog.frag", "modern_weather_particles.vert",
+                           "modern_weather_particles.frag"};
+    for (int i = 0; i < 4; i++) {
+      std::error_code ec;
+      const auto path = file_util::get_file_path({Shader::shader_folder, names[i]});
+      const auto t = std::filesystem::last_write_time(path, ec);
+      if (ec) continue;
+      if (m_mtime[i] != decltype(t){} && t != m_mtime[i]) {
+        if (i < 2) m_fog.reset(); else m_particles.reset();
+        lg::info("ModernWeather: {} recharge", names[i]);
+      }
+      m_mtime[i] = t;
+    }
+  }
+  std::unique_ptr<Shader> m_fog, m_particles;
+  LiquidSnapshot m_snapshot;
+  GLuint m_vao = 0;
+  u64 m_updated_frame = UINT64_MAX;
+  float m_last_time = -1.f, m_flash = 0.f;
+  int m_region = 0;
+  unsigned m_reload_counter = 0;
+  std::filesystem::file_time_type m_mtime[4]{};
+  WeatherState::Params m_params = WeatherState::preset(WeatherState::CLEAR);
+  V3 m_fog_color{.5f, .55f, .6f}, m_sand_color{.7f, .55f, .38f}, m_sun_color{1.f, 1.f, 1.f},
+      m_sun_dir{0.f, 1.f, 0.f}, m_drop_color{.6f, .65f, .7f};
+};
diff --git a/game/graphics/opengl_renderer/OpenGLRenderer.cpp b/game/graphics/opengl_renderer/OpenGLRenderer.cpp
index 2c2e3737..1d963bca 100644
--- a/game/graphics/opengl_renderer/OpenGLRenderer.cpp
+++ b/game/graphics/opengl_renderer/OpenGLRenderer.cpp
@@ -1445,11 +1445,16 @@ void OpenGLRenderer::dispatch_buckets_jak3(DmaFollower dma,
       m_palace_fire.render(&m_render_state);
     }
