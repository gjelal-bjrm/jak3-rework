+#pragma once
+#include <array>
+#include <mutex>
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "game/graphics/opengl_renderer/WeatherState.h"
+
+// Couleurs du moment calculees par ModernWeather::update (ciel reflechi, soleil) et uniformes meteo du
+// decor. En-tete leger : inclus par PalaceMaterials.h (tfrag / tie).
+namespace WeatherLook {
+inline std::mutex mutex;
+inline std::array<float, 3> sky{.55f, .6f, .68f};       // ciel reflechi par les flaques
+inline std::array<float, 3> sun_dir{0.f, 1.f, 0.f};
+inline std::array<float, 3> sun_color{0.f, 0.f, 0.f};
+inline float time = 0.f;
+}  // namespace WeatherLook
+
+// Uniformes du decor (tfrag3 : sol mouille, flaques, gouttes qui tombent dans les flaques, neige au sol).
+inline void weather_bind_world(GLuint program) {
+  float wet, puddles, snow, rain, flash;
+  {
+    std::lock_guard<std::mutex> guard(WeatherState::mutex);
+    wet = WeatherState::wetness * WeatherState::outdoor;
+    puddles = WeatherState::puddles * WeatherState::outdoor;
+    snow = WeatherState::snow_cover * WeatherState::outdoor;
+    rain = WeatherState::current.rain * WeatherState::outdoor;
+    flash = WeatherState::flash;
+  }
+  std::array<float, 3> sky, sun_dir, sun_color; float time;
+  {
+    std::lock_guard<std::mutex> guard(WeatherLook::mutex);
+    sky = WeatherLook::sky; sun_dir = WeatherLook::sun_dir; sun_color = WeatherLook::sun_color;
+    time = WeatherLook::time;
+  }
+  glUniform1f(glGetUniformLocation(program, "weather_wet"), wet);
+  glUniform1f(glGetUniformLocation(program, "weather_puddles"), puddles);
+  glUniform1f(glGetUniformLocation(program, "weather_snow"), snow);
+  glUniform1f(glGetUniformLocation(program, "weather_rain"), rain);
+  glUniform1f(glGetUniformLocation(program, "weather_time"), time);
+  glUniform1f(glGetUniformLocation(program, "weather_flash"), flash);
+  glUniform3fv(glGetUniformLocation(program, "weather_sky"), 1, sky.data());
+  glUniform3fv(glGetUniformLocation(program, "weather_sun_dir"), 1, sun_dir.data());
+  glUniform3fv(glGetUniformLocation(program, "weather_sun_color"), 1, sun_color.data());
+}
+
