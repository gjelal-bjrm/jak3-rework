diff --git a/game/graphics/opengl_renderer/ModernAO.h b/game/graphics/opengl_renderer/ModernAO.h
new file mode 100644
index 00000000..08996de5
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernAO.h
@@ -0,0 +1,121 @@
+#pragma once
+#include <atomic>
+#include <memory>
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+
+// Eclairage moderne du remaster. Les options sont reglees depuis GOAL (pc-remaster-lighting) :
+// bit 0 = occlusion ambiante. Actif par defaut.
+namespace LightingState {
+inline std::atomic<int> flags{1};
+}
+
+// Etape 1 : occlusion ambiante sur l'image. Dessinee juste apres le decor opaque (avant les objets
+// transparents, les personnages et la brume) : les coins, creux, dessous de corniches et contacts
+// s'assombrissent. Profondeur resolue (MSAA) -> occlusion -> deux flous qui respectent les bords -> image *= ao.
+class ModernAO {
+ public:
+  ~ModernAO() { clear(); if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+
+  void render(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    if (!(LightingState::flags.load() & 1)) return;
+    if (!m_shader) { m_shader = std::make_unique<Shader>("modern_ao", state->version); glGenVertexArrays(1, &m_vao); }
+    if (!m_shader->okay()) return;
+    GLint program, vao, read_fb, draw_fb, viewport[4], active, src_rgb, dst_rgb, src_a, dst_a, eq_rgb, eq_a;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fb);
+    glGetIntegerv(GL_VIEWPORT, viewport); glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write); glGetBooleanv(GL_COLOR_WRITEMASK, color_mask);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb); glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_a); glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_a);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_a);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST};
+    GLboolean was[5];
+    for (int i = 0; i < 5; i++) { was[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+
+    allocate(state->render_fb_w, state->render_fb_h);
+    // profondeur du decor opaque, resolue
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, state->render_fb);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_depth_fbo);
+    glBlitFramebuffer(0, 0, m_w, m_h, 0, 0, m_w, m_h, GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+
+    m_shader->activate();
+    const GLuint id = m_shader->id();
+    glBindVertexArray(m_vao);
+    glDepthMask(GL_FALSE); glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
+    glUniform4f(glGetUniformLocation(id, "ao_viewport"), viewport[0], viewport[1], viewport[2], viewport[3]);
+    glUniform1i(glGetUniformLocation(id, "ao_depth"), 27);
+    glUniform1i(glGetUniformLocation(id, "ao_input"), 28);
+    glUniform1f(glGetUniformLocation(id, "ao_strength"), 1.f);
+    glActiveTexture(GL_TEXTURE27); glBindTexture(GL_TEXTURE_2D, m_depth);
+    glViewport(0, 0, m_w, m_h);
+    // occlusion -> A ; flou horizontal A -> B ; flou vertical B -> A
+    pass(id, 0, m_fbo[0], 0, 0, 0);
+    pass(id, 1, m_fbo[1], m_ao[0], 1, 0);
+    pass(id, 1, m_fbo[0], m_ao[1], 0, 1);
+    // application sur l'image : couleur *= occlusion
+    glBindFramebuffer(GL_FRAMEBUFFER, state->render_fb);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glEnable(GL_BLEND); glBlendEquation(GL_FUNC_ADD); glBlendFuncSeparate(GL_ZERO, GL_SRC_COLOR, GL_ZERO, GL_ONE);
+    glActiveTexture(GL_TEXTURE28); glBindTexture(GL_TEXTURE_2D, m_ao[0]);
+    glUniform1i(glGetUniformLocation(id, "ao_mode"), 2);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    glUseProgram(program); glBindVertexArray(vao);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fb); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw_fb);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glDepthMask(depth_write); glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+    glBlendFuncSeparate(src_rgb, dst_rgb, src_a, dst_a); glBlendEquationSeparate(eq_rgb, eq_a);
+    for (int i = 0; i < 5; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+    glActiveTexture(active);
+  }
+
+ private:
+  void pass(GLuint id, int mode, GLuint target, GLuint input, float dx, float dy) {
+    glBindFramebuffer(GL_FRAMEBUFFER, target);
+    glActiveTexture(GL_TEXTURE28); glBindTexture(GL_TEXTURE_2D, input);
+    glUniform1i(glGetUniformLocation(id, "ao_mode"), mode);
+    glUniform2f(glGetUniformLocation(id, "ao_dir"), dx, dy);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+  }
+  void allocate(int w, int h) {
+    if (w == m_w && h == m_h && m_depth) return;
+    clear(); m_w = w; m_h = h;
+    glGenTextures(1, &m_depth); glBindTexture(GL_TEXTURE_2D, m_depth);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, w, h, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+    parameters();
+    glGenFramebuffers(1, &m_depth_fbo); glBindFramebuffer(GL_FRAMEBUFFER, m_depth_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, m_depth, 0);
+    glDrawBuffer(GL_NONE); glReadBuffer(GL_NONE);
+    for (int i = 0; i < 2; i++) {
+      glGenTextures(1, &m_ao[i]); glBindTexture(GL_TEXTURE_2D, m_ao[i]);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RG16F, w, h, 0, GL_RG, GL_FLOAT, nullptr);
+      parameters();
+      glGenFramebuffers(1, &m_fbo[i]); glBindFramebuffer(GL_FRAMEBUFFER, m_fbo[i]);
+      glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_ao[i], 0);
+    }
+  }
+  static void parameters() {
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+  }
+  void clear() {
+    if (m_depth) glDeleteTextures(1, &m_depth);
+    if (m_depth_fbo) glDeleteFramebuffers(1, &m_depth_fbo);
+    for (int i = 0; i < 2; i++) {
+      if (m_ao[i]) glDeleteTextures(1, &m_ao[i]);
+      if (m_fbo[i]) glDeleteFramebuffers(1, &m_fbo[i]);
+      m_ao[i] = m_fbo[i] = 0;
+    }
+    m_depth = m_depth_fbo = 0; m_w = m_h = 0;
+  }
+  std::unique_ptr<Shader> m_shader;
+  GLuint m_vao = 0, m_depth = 0, m_depth_fbo = 0, m_ao[2] = {0, 0}, m_fbo[2] = {0, 0};
+  int m_w = 0, m_h = 0;
+};
