 =?UTF-8?q?r=C3=B4ne=20du=20palais=20est=20couverte=20(ni=20pluie,=20ni=20?=
 =?UTF-8?q?neige,=20ni=20sol=20mouill=C3=A9,=20ni=20brouillard=20=C3=A0=20?=
 =?UTF-8?q?l'int=C3=A9rieur=20;=20ciel=20visible=20par=20les=20verri=C3=A8?=
 =?UTF-8?q?res)?=
