 class WaterFountains {
  public:
   ~WaterFountains(){ if(m_vao)glDeleteVertexArrays(1,&m_vao); }
   void render(SharedRenderState* state) {
+    // Chutes et brume actives des que la camera est dans la salle du trone (et plus seulement quand un
+    // bassin anime est a l'ecran : elles disparaissaient dans la vue d'arrivee).
+    if(state->has_pc_data && !state->prototype_water_visible && palace_near(state))state->prototype_water_visible=true;
     if(!state->prototype_water_visible || !state->has_pc_data)return;
     GLint program,vao,depth_func,active;
     GLboolean depth_write,color_mask[4];
@@ -18,6 +22,22 @@ class WaterFountains {
     GLboolean enabled[5];
     for(int i=0;i<5;i++){enabled[i]=glIsEnabled(flags[i]);glDisable(flags[i]);}
     if(!m_shader){m_shader=std::make_unique<Shader>("fountain",state->version);glGenVertexArrays(1,&m_vao);}
+    glBindVertexArray(m_vao);
+    // Voile de brume des chutes (avant les chutes elles-memes) : plein ecran, marche de rayon limitee par la
+    // profondeur de la scene ; remplace les pixels par le decor vu a travers la brume.
+    if(!m_mist)m_mist=std::make_unique<Shader>("fountain_mist",state->version);
+    if(m_mist->okay()){
+      m_mist->activate();
+      const auto mist=m_mist->id();
+      m_scene.bind(state,mist);
+      glUniform1i(glGetUniformLocation(mist,"tex_T25"),25);
+      glUniform1i(glGetUniformLocation(mist,"tex_T26"),26);
+      glUniform1f(glGetUniformLocation(mist,"fluid_time"),LiquidSnapshot::seconds());
+      glUniformMatrix4fv(glGetUniformLocation(mist,"pc_camera"),1,GL_FALSE,state->prototype_camera);
+      glUniform4fv(glGetUniformLocation(mist,"cam_trans"),1,state->camera_pos.data());
+      glDepthMask(GL_FALSE);
+      glDrawArrays(GL_TRIANGLES,0,3);
+    }
     m_shader->activate();
     auto shader=m_shader->id();
     m_scene.bind(state,shader);
@@ -39,6 +59,16 @@ class WaterFountains {
     for(int i=0;i<5;i++){if(enabled[i])glEnable(flags[i]);else glDisable(flags[i]);}
   }
  private:
+  static bool palace_near(const SharedRenderState* state){
+    if(state->version!=GameVersion::Jak3 || !state->loader)return false;
+    const auto eye=state->camera_pos/4096.f;
+    const float dx=eye.x()-1998.f,dy=eye.y()-253.f,dz=eye.z()+446.f;
+    if(dx*dx+dy*dy+dz*dz>90.f*90.f)return false;
+    for(const auto* data:state->loader->get_in_use_levels())
+      if(data && data->level && data->level->level_name=="waspala")return true;
+    return false;
+  }
+  std::unique_ptr<Shader> m_mist;
   std::unique_ptr<Shader> m_shader;
   LiquidSnapshot m_scene;
   GLuint m_vao=0;
