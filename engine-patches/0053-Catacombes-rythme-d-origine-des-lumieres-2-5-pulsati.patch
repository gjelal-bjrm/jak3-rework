     glUniform1i(glGetUniformLocation(id, "ao_mode"), 2);
+    // image de la scene : les sources de lumiere (vitres et lampes colorees) ne s'assombrissent pas
+    m_scene.bind(state, id);
+    glUniform1i(glGetUniformLocation(id, "ao_scene"), 25);
+    glActiveTexture(GL_TEXTURE28);
     // plantes (herbe, buissons : bit 0x80 du stencil, pose par Shrub) : pas d'assombrissement
     glEnable(GL_STENCIL_TEST); glStencilMask(0); glStencilFunc(GL_NOTEQUAL, 0x80, 0x80);
     glStencilOp(GL_KEEP, GL_KEEP, GL_KEEP);
@@ -120,6 +125,7 @@ class ModernAO {
     m_depth = m_depth_fbo = 0; m_w = m_h = 0;
   }
   std::unique_ptr<Shader> m_shader;
+  LiquidSnapshot m_scene;
   GLuint m_vao = 0, m_depth = 0, m_depth_fbo = 0, m_ao[2] = {0, 0}, m_fbo[2] = {0, 0};
