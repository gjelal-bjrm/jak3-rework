 // bit 0 = occlusion ambiante, bit 1 = ombres portees du soleil, bit 2 = feu du remaster. Actifs par defaut.
@@ -62,6 +63,10 @@ class ModernAO {
     glEnable(GL_BLEND); glBlendEquation(GL_FUNC_ADD); glBlendFuncSeparate(GL_ZERO, GL_SRC_COLOR, GL_ZERO, GL_ONE);
