@@ -988,6 +988,32 @@ vec3 interiorLight(vec3 L) {
   vec3 cool = hue * mix(vec3(1.), vec3(.80, .92, 1.25), k) + vec3(.035, .05, .085) * k;  // penombre fraiche
   return mix(cool, warm, pool);
 }
+// Vitre lumineuse des catacombes (comb-temp-glass) : une vitre epaisse, la lumiere bleue vient de l'interieur.
+// Couche lumineuse vue a travers le verre (decalee selon le regard : profondeur), surface de verre sombre avec
+// reflet sur les bords (Fresnel) et filets de reflet. La couleur et la pulsation d'origine sont gardees (la lumiere
+// precalculee qui pulse module la couche interieure).
+vec3 litGlass(vec3 light, vec2 uv, vec3 P) {
+  vec3 dp1 = dFdx(P), dp2 = dFdy(P); vec2 du1 = dFdx(uv), du2 = dFdy(uv);
+  vec3 n = normalize(cross(dp1, dp2));
+  vec3 V = normalize(cam_trans.xyz / 4096. - P);
+  if (dot(n, V) < 0.) n = -n;
+  // repere tangent (sans tangentes stockees) : derivees de la position et des UV
+  vec3 dp2perp = cross(dp2, n), dp1perp = cross(n, dp1);
+  vec3 T = dp2perp * du1.x + dp1perp * du2.x, B = dp2perp * du1.y + dp1perp * du2.y;
+  float invmax = inversesqrt(max(dot(T, T), dot(B, B)) + 1e-12);
+  vec2 view = vec2(dot(V, T * invmax), dot(V, B * invmax)) / max(dot(V, n), .25);
+  vec3 deep = texture(tex_T0, uv - view * .10).rgb, deeper = texture(tex_T0, uv - view * .22).rgb;
+  vec3 face = texture(tex_T0, uv).rgb;
+  // jamais moins lumineux que la vitre d'origine : la lumiere d'origine, plus une couche profonde qui glisse
+  // derriere le verre quand on bouge (on voit la lumiere a l'interieur)
+  vec3 orig = face * light * 2.;
+  vec3 inner = (deep * .55 + deeper * .45) * light * 2.;
+  vec3 lit = max(orig, mix(orig, inner, .6)) * 1.15 + inner * .25;
+  float fres = pow(1. - clamp(dot(n, V), 0., 1.), 4.);
+  // filets de reflet discrets sur la surface du verre, plus marques sur les bords (Fresnel)
+  float streak = smoothstep(.85, 1., sin(uv.x * 40. + uv.y * 6.) * .5 + .5) * (.25 + .75 * fres);
+  return lit + vec3(.35, .55, .95) * (fres * .18 + streak * .10);
+}
 vec3 interiorGrade(vec3 c) {
   float k = interior_look;
   float y = dot(c, vec3(.2126, .7152, .0722));
@@ -1016,7 +1042,7 @@ void main() {
         T0*vec4(1.0,1.0,1.0,fragment_color.a*2.0)),1.0);
     } else {
       vec3 base_light = genshin_look > 0. ? genshinLight(arena_light) : arena_light;
-      if (interior_look > 0.) base_light = interiorLight(base_light);
+      if (interior_look > 0. && palace_material != 10) base_light = interiorLight(base_light);
       color = vec4(base_light, fragment_color.a) * T0;
     color.rgb = shadePalaceMaterial(color.rgb,T0.rgb,arena_world);
     vec3 shadow_normal = dot(surface_normal, shadow_eye-arena_world) < 0. ? -surface_normal : surface_normal;
@@ -1029,7 +1055,8 @@ void main() {
