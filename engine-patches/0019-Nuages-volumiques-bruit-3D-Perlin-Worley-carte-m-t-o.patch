+    lg::info("ModernSky: bruit de nuages {}^3 et carte meteo {}^2 generes", N, W);
+  }
+  void ensure_targets(int w, int h) {
+    if (w == m_w && h == m_h && m_fbo[0]) return;
+    clear_targets();
+    m_w = w; m_h = h;
+    GLfloat clear_color[4]; glGetFloatv(GL_COLOR_CLEAR_VALUE, clear_color);
+    GLint unpack_buffer; glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glGenFramebuffers(2, m_fbo); glGenTextures(2, m_tex);
