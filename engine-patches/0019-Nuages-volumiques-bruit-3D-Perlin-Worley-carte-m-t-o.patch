+  // Rechargement a chaud : si un fichier .vert/.frag du ciel change, le shader est recompile.
+  void hot_reload(SharedRenderState* state) {
+    if (++m_reload_tick % 30) return;
+    auto stamp = [](const char* name) {
+      std::error_code ec;
+      long long total = 0;
+      for (const char* ext : {".vert", ".frag"}) {
+        const auto p = file_util::get_file_path({Shader::shader_folder, std::string(name) + ext});
+        const auto t = std::filesystem::last_write_time(p, ec);
+        if (!ec) total += t.time_since_epoch().count();
+      }
+      return total;
+    };
+    const long long sky = stamp("modern_sky"), clouds = stamp("modern_clouds");
+    if (m_stamp_sky && sky != m_stamp_sky) { m_shader.reset(); lg::info("ModernSky: modern_sky recharge"); }
+    if (m_stamp_clouds && clouds != m_stamp_clouds) { m_clouds.reset(); m_history_valid = false; lg::info("ModernSky: modern_clouds recharge"); }
+    m_stamp_sky = sky; m_stamp_clouds = clouds;
