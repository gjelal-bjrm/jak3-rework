diff --git a/game/graphics/opengl_renderer/ModernSky.h b/game/graphics/opengl_renderer/ModernSky.h
new file mode 100644
index 00000000..2ecd2d25
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernSky.h
@@ -0,0 +1,70 @@
+#pragma once
+#include <memory>
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/SkyState.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/ocean/ModernOcean.h"
+
+// Ciel moderne : passe plein ecran, apres le decor opaque et avant la mer (qui le reflete). Sur les pixels
+// de ciel (profondeur du brouillard natif), garde le degrade d'ambiance natif du niveau et ajoute des
+// nuages en couches eclaires par le soleil, un soleil avec lueur, et l'etoile du jour redessinee.
+// Active seulement si GOAL publie l'etat du ciel (sky-tng.gc patche : nuages plats, soleil et etoile
+// natifs non dessines).
+class ModernSky {
+ public:
+  ~ModernSky() { if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+  void render(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    std::array<float, 3> sun, green, moon, star; float hour; bool star_on, valid;
+    {
+      std::lock_guard<std::mutex> guard(SkyState::mutex);
+      valid = SkyState::valid; sun = SkyState::sun; green = SkyState::green_sun; moon = SkyState::moon;
+      star = SkyState::day_star; hour = SkyState::hour; star_on = SkyState::day_star_on;
+    }
+    if (!valid) return;
+    GLint program, old_vao, depth_func, old_active, tex25, tex26;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &old_vao);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func); glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+    glGetBooleanv(GL_COLOR_WRITEMASK, color_mask); glGetIntegerv(GL_ACTIVE_TEXTURE, &old_active);
+    glActiveTexture(GL_TEXTURE25); glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex25);
+    glActiveTexture(GL_TEXTURE26); glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex26);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST};
+    GLboolean was[5];
+    for (int i = 0; i < 5; i++) { was[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+    if (!m_shader) { m_shader = std::make_unique<Shader>("modern_sky", state->version); glGenVertexArrays(1, &m_vao); }
+    if (m_shader->okay()) {
+      m_shader->activate();
+      const GLuint id = m_shader->id();
+      m_snapshot.bind(state, id);   // couleur (ciel natif deja dessine) + profondeur -> tex_T25 / tex_T26
+      glUniform1i(glGetUniformLocation(id, "tex_T25"), 25);
+      glUniform1i(glGetUniformLocation(id, "tex_T26"), 26);
+      glUniformMatrix4fv(glGetUniformLocation(id, "sky_camera"), 1, GL_FALSE, state->prototype_camera);
+      glUniform1f(glGetUniformLocation(id, "sky_time"), LiquidSnapshot::seconds());
+      glUniform1f(glGetUniformLocation(id, "sky_hour"), hour);
+      glUniform3fv(glGetUniformLocation(id, "sky_sun"), 1, sun.data());
+      glUniform3fv(glGetUniformLocation(id, "sky_green_sun"), 1, green.data());
+      glUniform3fv(glGetUniformLocation(id, "sky_moon"), 1, moon.data());
+      glUniform3fv(glGetUniformLocation(id, "sky_day_star"), 1, star.data());
+      glUniform1f(glGetUniformLocation(id, "sky_day_star_on"), star_on ? 1.f : 0.f);
+      // Couverture nuageuse par region : desert de Spargus plus degage, Haven plus charge.
+      float coverage = .46f;
+      if (ModernOcean::level_loaded(state, "was")) coverage = .44f;
+      else if (ModernOcean::level_loaded(state, "cty")) coverage = .58f;
+      glUniform1f(glGetUniformLocation(id, "sky_coverage"), coverage);
+      glBindVertexArray(m_vao);
+      glDepthMask(GL_FALSE); glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+      glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    glUseProgram(program); glBindVertexArray(old_vao); glDepthFunc(depth_func); glDepthMask(depth_write);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+    for (int i = 0; i < 5; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+    glActiveTexture(GL_TEXTURE25); glBindTexture(GL_TEXTURE_2D, tex25);
+    glActiveTexture(GL_TEXTURE26); glBindTexture(GL_TEXTURE_2D, tex26); glActiveTexture(old_active);
+  }
+
+ private:
+  std::unique_ptr<Shader> m_shader;
+  LiquidSnapshot m_snapshot;
+  GLuint m_vao = 0;
+};
