+  }
+  for(size_t ti=0;ti<old.shrub_trees.size();++ti) {
+    auto& a=old.shrub_trees[ti];auto& b=now.shrub_trees.at(ti);
+    json entry={{"tree",ti},{"unchanged",serialized_hash(a)==serialized_hash(b)},
+        {"palette_unchanged",serialized_hash(a.time_of_day_colors)==serialized_hash(b.time_of_day_colors)},
+        {"packed_vertices_prefix",pod_prefix(a.packed_vertices.vertices,b.packed_vertices.vertices)},
+        {"packed_instance_groups_prefix",pod_prefix(a.packed_vertices.instance_groups,b.packed_vertices.instance_groups)},
+        {"packed_matrices_prefix",pod_prefix(a.packed_vertices.matrices,b.packed_vertices.matrices)},
+        {"indices_prefix",pod_prefix(a.indices,b.indices)},{"changed_original_draws",json::array()}};
+    for(size_t di=0;di<a.static_draws.size();++di)
+      if(serialized_hash(a.static_draws[di])!=serialized_hash(b.static_draws.at(di)))entry["changed_original_draws"].push_back(di);
+    if(patch) {
+      const auto before=shrub_triangles(a,ti,patch,a.packed_vertices.total_vertex_count,true);
+      const auto after=shrub_triangles(b,ti,patch,a.packed_vertices.total_vertex_count,false);
+      entry["triangles"]={{"unselected_unchanged",before.faces==after.faces},{"unselected_count",before.faces.size()},
+                           {"removed",before.removed},{"added",after.added}};
+    }
