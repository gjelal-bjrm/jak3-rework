diff --git a/game/graphics/opengl_renderer/ocean/CoastalBreakers.h b/game/graphics/opengl_renderer/ocean/CoastalBreakers.h
new file mode 100644
index 00000000..a04cf77d
--- /dev/null
+++ b/game/graphics/opengl_renderer/ocean/CoastalBreakers.h
@@ -0,0 +1,312 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <memory>
+#include <vector>
+
+#include "common/log/log.h"
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+
+// Remesh the existing coastal particle episodes. GOAL remains responsible for
+// their cadence, emitter placement, orientation and rise/fade timing.
+// This class neither starts an independent wave clock nor changes other sprites.
+class CoastalBreakers {
+ public:
+  enum Kind { Approach = 0, Froth = 1, Impact = 2, Residue = 3, Drops = 4 };
+  static int kind_for_name(const std::string& name) {
+    // These names are unique to the coastal surface wave paths; keep matching
+    // the texture-pool aliases that the original successful hook accepted.
+    if(name.find("wave-foam")!=std::string::npos)return Approach;
+    if(name.find("water-froth")!=std::string::npos)return Froth;
+    const auto slash = name.find_last_of('/');
+    const auto texture = name.substr(slash == std::string::npos ? 0 : slash + 1);
+    if (texture == "splash") return Impact;
+    if (texture == "splash-foam") return Residue;
+    if (texture == "water-drops") return Drops;
+    return -1;
+  }
+  template <typename Vertex>
+  bool accepts_source(const Vertex& source, int kind) const {
+    const float sx=std::abs(source.xyz_sx.w()/4096.f);
+    const float sy=std::abs(source.quat_sy.w()/4096.f);
+    if(!std::isfinite(sx)||!std::isfinite(sy))return false;
+    // The level-default textures are shared with small fountains, Jak's
+    // splashes and other effects. Only the large group480 source dimensions
+    // qualify. Values include a small tolerance below the authored minima.
+    const int mode=source.info[3];
+    if(kind==Impact) {
+      if(mode!=1||sx<1.9f)return false;
+      if(sy>=5.8f)return true;
+      // Native capture shows group480's live curve leaves sy at1m; width is
+      // animated instead. Require a sibling LARGE drop/residue emitter at the
+      // same rock, rather than applying a broad sy1 rule to ordinary splashes.
+      if(sy<.85f||sy>1.2f)return false;
+      const float now=LiquidSnapshot::seconds();
+      for(const auto& site:m_impact_sites) {
+        const float x=site.x-source.xyz_sx.x()/4096.f;
+        const float z=site.z-source.xyz_sx.z()/4096.f;
+        if(now-site.seen<8.f && x*x+z*z<144.f)return true;
+      }
+      return false;
+    }
+    if(kind==Residue)return mode==3 && sx>=4.8f && sy>=4.8f;
+    if(kind==Drops)return mode==1 && sx>=1.9f && sy>=1.9f;
+    // Mode records the microprogram path, and is not a reliable indication of
+    // the original particle's authored is-3d flag. These two unique wave names
+    // had already rendered correctly before the extra mode restriction.
+    return (kind==Approach||kind==Froth) && mode!=2;
+  }
+  CoastalBreakers() = default;
+  CoastalBreakers(const CoastalBreakers&) = delete;
+  CoastalBreakers& operator=(const CoastalBreakers&) = delete;
+  ~CoastalBreakers() {
+    if (m_buffer) glDeleteBuffers(1, &m_buffer);
+    if (m_vao) glDeleteVertexArrays(1, &m_vao);
+  }
+
+  // indices is Sprite3's native four vertices + restart index per particle.
+  template <typename Vertex>
+  void render(SharedRenderState* state,
+              const std::vector<Vertex>& vertices,
+              const std::vector<u32>& indices,
+              int kind) {
+    const float now = LiquidSnapshot::seconds();
+    m_instances.clear();
+    m_sources.clear();
+    m_tracks.erase(std::remove_if(m_tracks.begin(), m_tracks.end(),
+                                 [now](const Track& t) { return now - t.seen > .3f; }),
+                   m_tracks.end());
+    m_anchors.erase(std::remove_if(m_anchors.begin(),m_anchors.end(),
+                                  [now](const Anchor& a){return now-a.seen>20.f;}),m_anchors.end());
+    m_impact_sites.erase(std::remove_if(m_impact_sites.begin(),m_impact_sites.end(),
+                                       [now](const Anchor& a){return now-a.seen>8.f;}),m_impact_sites.end());
+    for (size_t i = 0; i + 3 < indices.size(); i += 5) {
+      if (indices[i] >= vertices.size()) continue;
+      const auto& source = vertices[indices[i]];
+      if(!accepts_source(source,kind))continue;
+      // The sprite's xyz and scale are in GOAL units; quaternion is unscaled.
+      Instance item{};
+      for (int j = 0; j < 4; ++j) {
+        item.position_scale[j] = source.xyz_sx[j] / 4096.f;
+        item.quaternion_scale[j] = source.quat_sy[j];
+        item.color[j] = source.rgba[j];
+      }
+      item.quaternion_scale[3] /= 4096.f;
+      if (!std::isfinite(item.position_scale[0]) ||
+          !std::isfinite(item.position_scale[1]) ||
+          !std::isfinite(item.position_scale[2]) ||
+          std::abs(item.position_scale[3]) < .01f) continue;
+
+      if(kind==Residue||kind==Drops) {
+        Anchor* site=nullptr;
+        for(auto& candidate:m_impact_sites) {
+          const float x=candidate.x-item.position_scale[0],z=candidate.z-item.position_scale[2];
+          if(x*x+z*z<36.f){site=&candidate;break;}
+        }
+        if(!site){m_impact_sites.push_back({});site=&m_impact_sites.back();}
+        *site={item.position_scale[0],item.position_scale[2],0.f,now};
+      }
+
+      if (!m_logged[kind] && source.rgba.w() > .001f) {
+        lg::info("CoastalBreakers {} native xyz/sx ({:.3f}, {:.3f}, {:.3f}, {:.3f}) m, "
+                 "quat/sy ({:.5f}, {:.5f}, {:.5f}, {:.3f} m), rgba ({:.3f}, {:.3f}, {:.3f}, {:.5f}), "
+                 "sprite-mode {}, flags 0x{:x}",
+                 kind, item.position_scale[0],
+                 item.position_scale[1], item.position_scale[2], item.position_scale[3],
+                 item.quaternion_scale[0], item.quaternion_scale[1],
+                 item.quaternion_scale[2], item.quaternion_scale[3],
+                 item.color[0], item.color[1], item.color[2], item.color[3],source.info[3],source.flags_matrix[0]);
+        m_logged[kind] = true;
+      }
+
+      // The actual upward rock impact is a separate emitter (part group 480).
+      // Its splash and water-drops particles are 2D sprites: quat.z is a screen
+      // rotation, not a world quaternion. Recover a stable shoreward direction
+      // from the neighbouring native approach/froth wave, and use world-up.
+      if (kind == Approach || kind == Froth) {
+        Anchor* anchor = nullptr;
+        float nearest = 225.f;
+        for (auto& candidate : m_anchors) {
+          const float x = candidate.x - item.position_scale[0];
+          const float z = candidate.z - item.position_scale[2];
+          if (x*x+z*z < nearest) { nearest=x*x+z*z; anchor=&candidate; }
+        }
+        if (!anchor) { m_anchors.push_back({}); anchor=&m_anchors.back(); }
+        *anchor={item.position_scale[0],item.position_scale[2],item.quaternion_scale[1],now};
+      } else if (kind == Impact || kind == Drops) {
+        float yaw = 0.f, nearest = 14400.f;
+        for (const auto& anchor : m_anchors) {
+          if (now-anchor.seen > 20.f) continue;
+          const float x=anchor.x-item.position_scale[0],z=anchor.z-item.position_scale[2];
+          if(x*x+z*z < nearest){nearest=x*x+z*z; yaw=anchor.yaw;}
+        }
+        item.quaternion_scale[0]=item.quaternion_scale[2]=0.f;
+        item.quaternion_scale[1]=yaw;
+      }
+
+      // A legacy impact consists of dozens of overlapping cloud sprites. They
+      // describe one splash, so group them before remeshing; otherwise we'd
+      // replace one opaque wall with dozens of transparent water sheets.
+      Instance* cluster = nullptr;
+      if (kind == Impact || kind == Drops) {
+        for (auto& candidate : m_sources) {
+          float d=0.f;
+          for(int j=0;j<3;++j){const float a=candidate.position_scale[j]-item.position_scale[j];d+=a*a;}
+          if(d < (kind==Impact ? 25.f : 9.f)){cluster=&candidate;break;}
+        }
+      }
+      if (cluster) {
+        cluster->position_scale[3]=std::max(cluster->position_scale[3],item.position_scale[3]);
+        cluster->quaternion_scale[3]=std::max(cluster->quaternion_scale[3],item.quaternion_scale[3]);
+        cluster->color[3]=std::max(cluster->color[3],item.color[3]);
+      } else m_sources.push_back(item);
+    }
+    for(auto item : m_sources) {
+      if(kind == Impact) {
+        const float authored_height=item.quaternion_scale[3] < 1.3f
+              ? item.position_scale[3]*.88f+4.f : item.quaternion_scale[3]*.62f;
+        item.position_scale[3]=std::clamp(item.position_scale[3]*.90f,6.f,18.f);
+        item.quaternion_scale[3]=std::clamp(authored_height,6.f,14.f);
+      }
+
+      Track* match = nullptr;
+      float best = 9.f;
+      for (auto& track : m_tracks) {
+        // Do not assign two native particles to the same episode in one frame.
+        if (track.kind != kind || track.frame == state->frame_idx ||
+            (kind < Impact && std::abs(track.width - item.position_scale[3]) > 1.f)) continue;
+        float distance = 0;
+        for (int j = 0; j < 3; ++j) {
+          const float d = item.position_scale[j] - track.position[j];
+          distance += d * d;
+        }
+        if (distance < best) { best = distance; match = &track; }
+      }
+      if (!match) {
+        Track track{};
+        track.born = now;
+        track.kind = kind;
+        track.seed = float(++m_seed % 100000);
+        for (int j = 0; j < 3; ++j) track.origin[j] = item.position_scale[j];
+        m_tracks.push_back(track);
+        match = &m_tracks.back();
+      }
+      match->seen = now;
+      match->frame = state->frame_idx;
+      match->width = item.position_scale[3];
+      for (int j = 0; j < 3; ++j) {
+        match->position[j] = item.position_scale[j];
+        item.origin[j] = match->origin[j];
+      }
+      item.episode = {now - match->born, float(kind), match->seed, 0.f};
+      m_instances.push_back(item);
+    }
+    if (m_instances.empty()) return;
+
+    // The following sprite bucket must see exactly the GL state it had before.
+    StateGuard guard;
+    if (!m_sheet) {
+      m_sheet = std::make_unique<Shader>("coast_breaker", state->version);
+      m_spray = std::make_unique<Shader>("coast_spray", state->version);
+      glGenVertexArrays(1, &m_vao);
+      glGenBuffers(1, &m_buffer);
+      glBindVertexArray(m_vao);
+      glBindBuffer(GL_ARRAY_BUFFER, m_buffer);
+      for (GLuint attribute = 0; attribute < 5; ++attribute) {
+        glEnableVertexAttribArray(attribute);
+        glVertexAttribPointer(attribute, 4, GL_FLOAT, GL_FALSE, sizeof(Instance),
+                              reinterpret_cast<void*>(attribute * sizeof(std::array<float, 4>)));
+        glVertexAttribDivisor(attribute, 1);
+      }
+    }
+    if (!m_sheet->okay() || !m_spray->okay()) return;
+    glBindVertexArray(m_vao);
+    glBindBuffer(GL_ARRAY_BUFFER, m_buffer);
+    glBufferData(GL_ARRAY_BUFFER, m_instances.size() * sizeof(Instance), m_instances.data(), GL_STREAM_DRAW);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_GEQUAL);  // Native Jak reversed Z.
+    glDepthMask(GL_FALSE);
+    glDisable(GL_CULL_FACE);
+    glEnable(GL_BLEND);
+    glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    if(kind != Drops) {
+      m_sheet->activate();
+      bind(state, m_sheet->id(), now);
+      glDrawArraysInstanced(GL_TRIANGLES, 0, 48 * 12 * 6, GLsizei(m_instances.size()));
+    }
+    if (kind == Impact || kind == Drops) {
+      m_spray->activate();
+      bind(state, m_spray->id(), now);
+      glDrawArraysInstanced(GL_TRIANGLES, 0, 192 * 6, GLsizei(m_instances.size()));
+    }
+  }
+
+ private:
+  struct Instance {
+    std::array<float, 4> position_scale, quaternion_scale, color, episode, origin;
+  };
+  static_assert(sizeof(Instance) == 80);
+  struct Track {
+    std::array<float, 3> position{}, origin{};
+    float born = 0, seen = 0, width = 0, seed = 0;
+    u64 frame = UINT64_MAX;
+    int kind = 0;
+  };
+  struct Anchor { float x=0, z=0, yaw=0, seen=0; };
+
+  struct StateGuard {
+    GLint program, vao, buffer, active, tex25, tex26, depth_func;
+    GLint blend_src_rgb, blend_dst_rgb, blend_src_a, blend_dst_a, blend_eq_rgb, blend_eq_a;
+    GLboolean depth_write, depth_test, blend, cull;
+    StateGuard() {
+      glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+      glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+      glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &buffer);
+      glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+      glActiveTexture(GL_TEXTURE25); glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex25);
+      glActiveTexture(GL_TEXTURE26); glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex26);
+      glGetIntegerv(GL_DEPTH_FUNC, &depth_func); glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+      glGetIntegerv(GL_BLEND_SRC_RGB, &blend_src_rgb); glGetIntegerv(GL_BLEND_DST_RGB, &blend_dst_rgb);
+      glGetIntegerv(GL_BLEND_SRC_ALPHA, &blend_src_a); glGetIntegerv(GL_BLEND_DST_ALPHA, &blend_dst_a);
+      glGetIntegerv(GL_BLEND_EQUATION_RGB, &blend_eq_rgb); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &blend_eq_a);
+      depth_test = glIsEnabled(GL_DEPTH_TEST); blend = glIsEnabled(GL_BLEND); cull = glIsEnabled(GL_CULL_FACE);
+    }
+    ~StateGuard() {
+      glUseProgram(program); glBindVertexArray(vao); glBindBuffer(GL_ARRAY_BUFFER, buffer);
+      glActiveTexture(GL_TEXTURE25); glBindTexture(GL_TEXTURE_2D, tex25);
+      glActiveTexture(GL_TEXTURE26); glBindTexture(GL_TEXTURE_2D, tex26); glActiveTexture(active);
+      glDepthFunc(depth_func); glDepthMask(depth_write);
+      glBlendEquationSeparate(blend_eq_rgb, blend_eq_a);
+      glBlendFuncSeparate(blend_src_rgb, blend_dst_rgb, blend_src_a, blend_dst_a);
+      if (depth_test) glEnable(GL_DEPTH_TEST); else glDisable(GL_DEPTH_TEST);
+      if (blend) glEnable(GL_BLEND); else glDisable(GL_BLEND);
+      if (cull) glEnable(GL_CULL_FACE); else glDisable(GL_CULL_FACE);
+    }
+  };
+
+  void bind(SharedRenderState* state, GLuint shader, float now) {
+    m_snapshot.bind(state, shader);
+    const auto eye = state->camera_pos / 4096.f;
+    glUniformMatrix4fv(glGetUniformLocation(shader, "ocean_camera"), 1, GL_FALSE, state->prototype_camera);
+    glUniform3fv(glGetUniformLocation(shader, "ocean_eye"), 1, eye.data());
+    glUniform1f(glGetUniformLocation(shader, "ocean_time"), now);
+    glUniform1i(glGetUniformLocation(shader, "tex_T25"), 25);
+    glUniform1i(glGetUniformLocation(shader, "tex_T26"), 26);
+  }
+
+  std::unique_ptr<Shader> m_sheet, m_spray;
+  LiquidSnapshot m_snapshot;
+  GLuint m_vao = 0, m_buffer = 0;
+  u32 m_seed = 0;
+  bool m_logged[5] = {false, false, false, false, false};
+  std::vector<Instance> m_instances;
+  std::vector<Instance> m_sources;
+  std::vector<Track> m_tracks;
+  std::vector<Anchor> m_anchors;
+  std::vector<Anchor> m_impact_sites;
+};
