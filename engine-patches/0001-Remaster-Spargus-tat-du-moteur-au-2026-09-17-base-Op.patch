+      {"hfrag_unchanged",serialized_hash(old.hfrag)==serialized_hash(now.hfrag)},
+      {"collision_unchanged",serialized_hash(old.collision)==serialized_hash(now.collision)},
+      {"merc_unchanged",serialized_hash(old.merc_data)==serialized_hash(now.merc_data)},
+      {"textures",json::array()},{"tfrag",json::array()},{"tie",json::array()},{"shrub",json::array()}};
