@@ -0,0 +1,45 @@
+#pragma once
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+
+class WaterFountains {
+ public:
+  ~WaterFountains(){ if(m_vao)glDeleteVertexArrays(1,&m_vao); }
+  void render(SharedRenderState* state) {
+    if(!state->prototype_water_visible || !state->has_pc_data)return;
+    GLint program,vao,depth_func,active;
+    GLboolean depth_write,color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM,&program);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING,&vao);
+    glGetIntegerv(GL_DEPTH_FUNC,&depth_func);
+    glGetIntegerv(GL_ACTIVE_TEXTURE,&active);
+    glGetBooleanv(GL_DEPTH_WRITEMASK,&depth_write);
+    glGetBooleanv(GL_COLOR_WRITEMASK,color_mask);
+    const GLenum flags[]={GL_DEPTH_TEST,GL_BLEND,GL_CULL_FACE,GL_SCISSOR_TEST,GL_STENCIL_TEST};
+    GLboolean enabled[5];
+    for(int i=0;i<5;i++){enabled[i]=glIsEnabled(flags[i]);glDisable(flags[i]);}
+    if(!m_shader){m_shader=std::make_unique<Shader>("fountain",state->version);glGenVertexArrays(1,&m_vao);}
+    m_shader->activate();
+    auto shader=m_shader->id();
+    m_scene.bind(state,shader);
+    glUniform1f(glGetUniformLocation(shader,"fluid_time"),LiquidSnapshot::seconds());
+    glUniformMatrix4fv(glGetUniformLocation(shader,"pc_camera"),1,GL_FALSE,state->prototype_camera);
+    glUniform4fv(glGetUniformLocation(shader,"cam_trans"),1,state->camera_pos.data());
+    glBindVertexArray(m_vao);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_GEQUAL);
+    glDepthMask(GL_TRUE);
+    glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+    glDrawArrays(GL_TRIANGLES,0,4*64*10*6);
+    glUseProgram(program);
+    glBindVertexArray(vao);
+    glDepthFunc(depth_func);
+    glDepthMask(depth_write);
+    glColorMask(color_mask[0],color_mask[1],color_mask[2],color_mask[3]);
+    glActiveTexture(active);
+    for(int i=0;i<5;i++){if(enabled[i])glEnable(flags[i]);else glDisable(flags[i]);}
+  }
+ private:
+  std::unique_ptr<Shader> m_shader;
+  LiquidSnapshot m_scene;
+  GLuint m_vao=0;
+};
diff --git a/game/graphics/opengl_renderer/WaterSpray.h b/game/graphics/opengl_renderer/WaterSpray.h
new file mode 100644
index 00000000..1b6de96a
--- /dev/null
+++ b/game/graphics/opengl_renderer/WaterSpray.h
@@ -0,0 +1,62 @@
+#pragma once
+#include "game/graphics/opengl_renderer/WaterContacts.h"
+
+// Small ballistic droplets, rendered after water but before the HUD.
+class WaterSpray {
+ public:
+  ~WaterSpray() { if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+  void render(SharedRenderState* state) {
+    if (!state->has_pc_data || (!state->prototype_water_visible && !WaterContacts::spray_active())) return;
+    GLint program, vao, depth_func, src_rgb, dst_rgb, src_alpha, dst_alpha, eq_rgb, eq_alpha;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb);
+    glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_alpha);
+    glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_alpha);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb);
+    glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_alpha);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+    glGetBooleanv(GL_COLOR_WRITEMASK, color_mask);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST,
+                            GL_STENCIL_TEST, GL_PROGRAM_POINT_SIZE};
+    GLboolean enabled[6];
+    for (int i=0; i<6; i++) { enabled[i]=glIsEnabled(flags[i]); glDisable(flags[i]); }
+    if (!m_shader) {
+      m_shader = std::make_unique<Shader>("water_spray", state->version);
+      glGenVertexArrays(1, &m_vao);
+    }
+    m_shader->activate();
+    auto shader = m_shader->id();
+    WaterContacts::bind(shader);
+    glUniform1f(glGetUniformLocation(shader,"fluid_time"),LiquidSnapshot::seconds());
+    glUniformMatrix4fv(glGetUniformLocation(shader,"pc_camera"),1,GL_FALSE,state->prototype_camera);
+    glUniform3fv(glGetUniformLocation(shader,"camera_position"),1,state->camera_pos.data());
+    glUniform1f(glGetUniformLocation(shader,"viewport_height"),float(state->render_fb_h));
+    glUniform1i(glGetUniformLocation(shader,"fountain_active"),state->prototype_water_visible ? 1 : 0);
+    glBindVertexArray(m_vao);
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_GEQUAL);
+    glDepthMask(GL_FALSE);
+    glEnable(GL_BLEND);
+    glBlendEquation(GL_FUNC_ADD);
+    glBlendFunc(GL_SRC_ALPHA,GL_ONE_MINUS_SRC_ALPHA);
+    glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+    glEnable(GL_PROGRAM_POINT_SIZE);
+    // The shader discards unused impact slots; capacity is 16 palace impact sites.
+    glDrawArrays(GL_POINTS,0,32*24+16*12);
+    glUseProgram(program);
+    glBindVertexArray(vao);
+    glDepthFunc(depth_func);
+    glDepthMask(depth_write);
+    glBlendFuncSeparate(src_rgb,dst_rgb,src_alpha,dst_alpha);
+    glBlendEquationSeparate(eq_rgb,eq_alpha);
+    glColorMask(color_mask[0],color_mask[1],color_mask[2],color_mask[3]);
+    for (int i=0; i<6; i++) { if(enabled[i])glEnable(flags[i]);else glDisable(flags[i]); }
+  }
+ private:
+  std::unique_ptr<Shader> m_shader;
+  GLuint m_vao=0;
+};
diff --git a/game/graphics/opengl_renderer/background/LiquidSnapshot.h b/game/graphics/opengl_renderer/background/LiquidSnapshot.h
new file mode 100644
index 00000000..ecc97ff9
--- /dev/null
+++ b/game/graphics/opengl_renderer/background/LiquidSnapshot.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include <chrono>
+
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "game/graphics/opengl_renderer/background/ShoreField.h"
+
+// A private, resolved copy: sampling the framebuffer being written is undefined.
+// Created only for the two prototype locations and resized with the game buffer.
+class LiquidSnapshot {
+ public:
+  ~LiquidSnapshot() { clear(); }
+
+  void bind(SharedRenderState* state, GLuint shader) {
+    GLint old_read, old_draw;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+    if (m_width != state->render_fb_w || m_height != state->render_fb_h) {
+      clear();
+      m_width = state->render_fb_w;
+      m_height = state->render_fb_h;
+      glGenFramebuffers(1, &m_fbo);
+      glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+      glGenTextures(1, &m_color);
+      glActiveTexture(GL_TEXTURE25);
+      glBindTexture(GL_TEXTURE_2D, m_color);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, m_width, m_height, 0, GL_RGBA,
+                   GL_UNSIGNED_BYTE, nullptr);
+      parameters(GL_LINEAR);
+      glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_color, 0);
+      glGenTextures(1, &m_depth);
+      glActiveTexture(GL_TEXTURE26);
+      glBindTexture(GL_TEXTURE_2D, m_depth);
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, m_width, m_height, 0,
+                   GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+      parameters(GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+      glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT,
+                             GL_TEXTURE_2D, m_depth, 0);
+      ASSERT(glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+      m_frame = UINT64_MAX;
+    }
+    if (m_frame != state->frame_idx) {
+      const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+      glDisable(GL_SCISSOR_TEST);
+      glBindFramebuffer(GL_READ_FRAMEBUFFER, state->render_fb);
+      glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fbo);
+      // Same formats and dimensions permit MSAA depth/color resolve.
+      glBlitFramebuffer(0, 0, m_width, m_height, 0, 0, m_width, m_height,
+                        GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+      m_frame = state->frame_idx;
+      if (scissor) glEnable(GL_SCISSOR_TEST);
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+    glActiveTexture(GL_TEXTURE25);
+    glBindTexture(GL_TEXTURE_2D, m_color);
+    glActiveTexture(GL_TEXTURE26);
+    glBindTexture(GL_TEXTURE_2D, m_depth);
+    const GLint shore_location=glGetUniformLocation(shader,"shore_field");
+    if(shore_location>=0) {
+      if(!m_shore)m_shore=ShoreField::acquire();
+      m_shore->bind(shore_location);
+    }
+    glActiveTexture(GL_TEXTURE0);
+    GLint viewport[4];
+    glGetIntegerv(GL_VIEWPORT, viewport);
+    glUniform4f(glGetUniformLocation(shader, "fluid_viewport"), viewport[0], viewport[1],
+                viewport[2], viewport[3]);
+  }
+
+  static float seconds() {
+    static const auto start = std::chrono::steady_clock::now();
+    return std::chrono::duration<float>(std::chrono::steady_clock::now() - start).count();
+  }
+
+ private:
+  static void parameters(GLint filter) {
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, filter);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  }
+  void clear() {
+    if (m_color) glDeleteTextures(1, &m_color);
+    if (m_depth) glDeleteTextures(1, &m_depth);
+    if (m_fbo) glDeleteFramebuffers(1, &m_fbo);
+    m_fbo = m_color = m_depth = 0;
+  }
+  GLuint m_fbo = 0, m_color = 0, m_depth = 0;
+  int m_width = 0, m_height = 0;
+  u64 m_frame = UINT64_MAX;
+  std::shared_ptr<ShoreField> m_shore;
+};
diff --git a/game/graphics/opengl_renderer/background/PalaceMaterialAudit.h b/game/graphics/opengl_renderer/background/PalaceMaterialAudit.h
new file mode 100644
index 00000000..06538fbb
--- /dev/null
+++ b/game/graphics/opengl_renderer/background/PalaceMaterialAudit.h
@@ -0,0 +1,25 @@
+#pragma once
+#include <cstdlib>
+#include <unordered_set>
+#include "common/util/FileUtil.h"
+
+// Opt-in verification of the texture actually bound immediately before a draw.
+// Readback happens once per material and does not change texture or sampler state.
+class PalaceMaterialAudit {
+ public:
+  static void bind(GLuint program, const std::string& name, int kind) {
+    static const char* directory=std::getenv("PALACE_MATERIAL_AUDIT");
+    if (!directory || !kind) return;
+    static std::unordered_set<std::string> inspected;
+    if (!inspected.insert(name).second) return;
+    GLint w=0,h=0;
+    glGetTexLevelParameteriv(GL_TEXTURE_2D,0,GL_TEXTURE_WIDTH,&w);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D,0,GL_TEXTURE_HEIGHT,&h);
+    if (w<=0 || h<=0) return;
+    std::vector<u8> pixels(size_t(w)*h*4);
+    glGetTexImage(GL_TEXTURE_2D,0,GL_RGBA,GL_UNSIGNED_BYTE,pixels.data());
+    file_util::write_rgba_png(fs::path(directory)/"gpu"/(name+".png"),pixels.data(),w,h);
+    lg::info("Palace GPU audit: {} {}x{}, material uniform {}",name,w,h,
+             glGetUniformLocation(program,"palace_material"));
+  }
+};
diff --git a/game/graphics/opengl_renderer/background/PalaceMaterials.h b/game/graphics/opengl_renderer/background/PalaceMaterials.h
new file mode 100644
index 00000000..979dce4c
--- /dev/null
+++ b/game/graphics/opengl_renderer/background/PalaceMaterials.h
@@ -0,0 +1,116 @@
+#pragma once
+#include "common/custom_data/Tfrag3Data.h"
+#include "common/log/log.h"
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "PalaceMaterialAudit.h"
+#include "LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/GrassContacts.h"
+
+// Cache static scenery classifications at level load. Animated liquids,
+// characters and other levels sharing the shader programs keep their own path.
+class PalaceMaterials {
+ public:
+  void load(const tfrag3::Level& level) {
+    m_kinds.clear();
+    m_grass_region = level.level_name == "wascitya" ? 1 : (level.level_name == "wascityb" ? 2 : 0);
+    m_names.clear();
+    m_high_res.clear();
+    const bool market = level.level_name == "wascityb" || level.level_name == "wascitya" ||
+                        level.level_name == "waswide";
+    if (level.level_name != "waspala" && !market) return;
+    int count=0, high_res=0;
+    for (const auto& texture : level.textures) {
+      // Regional response only for explicit, high-resolution replacement
+      // materials. Alpha decals, windows, liquids and unchanged atlases keep
+      // the native path. The palace classification is unchanged.
+      const int kind=market ? (std::max(texture.w,texture.h)>=512 ?
+          classify_market(texture.debug_name) : 0) : classify(texture.debug_name);
+      m_kinds.push_back(kind);
+      m_names.push_back(texture.debug_name);
+      m_high_res.push_back(std::max(texture.w,texture.h)>=512);
+      if (kind) { ++count; if (std::max(texture.w,texture.h)>=512) ++high_res; }
+    }
+    static bool reported_palace=false, reported_market=false;
+    bool& reported=market ? reported_market : reported_palace;
+    if (!reported && count) {
+      lg::info("Remaster material response [{}]: {} static materials, {} textures at 512px or above",level.level_name,count,high_res);
+      reported=true;
+    }
+  }
+  void bind(GLuint program, int texture, const SharedRenderState* state) const {
+    const int kind=state->version==GameVersion::Jak3 && texture>=0 &&
+        size_t(texture)<m_kinds.size() ? m_kinds[texture] : 0;
+    glUniform1i(glGetUniformLocation(program,"palace_material"),kind);
+    const bool palm=kind && (m_names[texture]=="waspala-palmplant-leaf-02" || m_names[texture]=="waspala-shrub-plant" || m_names[texture]=="for-shrub-moss");
+    const bool market_shrub=kind && m_names[texture]=="market-shrub-orange-v1";
+    const bool market_wind=kind && m_names[texture]=="market-palm-leaf-v1";
+    glUniform1i(glGetUniformLocation(program,"market_wind_material"),market_wind);
+    glUniform1i(glGetUniformLocation(program,"palace_foliage"),market_shrub?2:(palm?1:0));
+    if(palm || market_shrub)glUniform1f(glGetUniformLocation(program,"palace_time"),LiquidSnapshot::seconds());
+    GrassContacts::bind(program, market_shrub ? m_grass_region : 0);
+    PalaceMaterialAudit::bind(program,kind ? m_names[texture] : std::string(),kind);
+    // Some PS2 scenery draws explicitly select nearest filtering. Retaining it
+    // makes HD albedo and derivative normals pixelate and shimmer at close range.
+    if(kind && m_high_res[texture]) {
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR_MIPMAP_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+    }
+    // These private remaster textures use authored, repeating UVs. Native
+    // atlases and the leaf/shrub alpha textures keep their original wrap.
+    if (kind && (m_names[texture]=="market-palm-trunk-v1" ||
+                 m_names[texture]=="market-support-wood-v1" ||
+                 m_names[texture]=="market-support-metal-v1")) {
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_REPEAT);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_REPEAT);
+    }
+    if (kind) glUniform3f(glGetUniformLocation(program,"palace_eye"),
+        state->camera_pos[0]/4096.f,state->camera_pos[1]/4096.f,state->camera_pos[2]/4096.f);
+  }
+ private:
+  static int classify_market(const std::string& name) {
+    if (name=="market-support-wood-v1" || name=="market-palm-trunk-v1") return 2;
+    if (name=="market-support-metal-v1") return 3;
+    if (name=="market-palm-leaf-v1" || name=="market-shrub-orange-v1" ||
+        name=="city-cactus-green-v2") return 5;
+    if (name=="wascity-ocean-shore-rocks" ||
+        name=="wascity-ground2ocean-shore-rocks" ||
+        name=="wascity-rock-small" || name=="wascity-outerwall-rock") return 7;
+    if (name=="wascity-roof-1" || name=="city-slum-burning-can" ||
+        name=="wascity-outerwall-metal" || name=="wascity-outerwall-metal-b" ||
+        name=="wascity-metal-dirty") return 3;
+    if (name=="wascity-ground-01" || name=="wascity-cement-road" ||
+        name=="wascity-stucco-wall-bleached-01" || name=="wascitya-stone-top" ||
+        name=="wascitya-stone-bottom" || name=="wascity-stonewall-bricks" ||
+        name=="wascity-stucco-wall-bleached-2-bricks-01" ||
+        name=="wascity-ditch-wall-top-to-ground" || name=="wascity-stone-plain-wall-3" ||
+        name=="wascity-ground-2-ditch-03" || name=="wascity-ground-2-ditch-04" ||
+        name=="wascity-ground-2-ditch-05" || name=="wascity-stone-bricks-2-plain") return 1;
+    return 0;
+  }
+  static int classify(const std::string& name) {
+    if (name=="waspala-fire-coal") return 0;
+    if (name=="waspala-fire-holder01" || name=="waspala-fire-holder03") return 3;
+    if (name.rfind("waspala-cliff-rock",0)==0 || name=="waspala-small-rocks" ||
+        name=="wascity-outerwall-rock") return 7;
+    if (name=="for-shrub-moss" || name=="waspala-shrub-plant" ||
+        name=="waspala-palmplant-leaf-02" || name=="waspala-palmtree-beard") return 5;
+    if (name=="waspala-glass-03") return 4;
+    if (name=="waspala-throne-cushion") return 6;
+    if (name=="waspala-throne-back-03" || name=="waspala-throne-cap") return 3;
+    if (name=="waspala-throne-base" || name=="waspala-throne-back-02") return 2;
+    if (name=="waspala-palmtree-trunk-01" || name=="waspala-branch-01" ||
+        name=="waspala-wheel-paddle") return 2;
+    if (name.rfind("waspala-",0)!=0 && name.rfind("common_sandstone_",0)!=0 &&
+        name!="wascity-outerwall-rock") return 0;
+    if (name.find("water")!=std::string::npos || name.find("dust")!=std::string::npos) return 0;
+    if (name.find("metal")!=std::string::npos || name.find("bolt")!=std::string::npos ||
+        name.find("chain")!=std::string::npos || name.find("elevator")!=std::string::npos ||
+        name.find("wheel")!=std::string::npos || name=="waspala-column-plate" ||
+        name=="waspala-column-piece") return 3;
+    return 1;
+  }
+  int m_grass_region = 0;
+  std::vector<int> m_kinds;
+  std::vector<std::string> m_names;
+  std::vector<bool> m_high_res;
+};
diff --git a/game/graphics/opengl_renderer/background/PalaceRockNormals.h b/game/graphics/opengl_renderer/background/PalaceRockNormals.h
new file mode 100644
index 00000000..a596e004
--- /dev/null
+++ b/game/graphics/opengl_renderer/background/PalaceRockNormals.h
@@ -0,0 +1,61 @@
+#pragma once
+#include <map>
+#include <cmath>
+#include "common/custom_data/Tfrag3Data.h"
+
+// Weld natural-rock and upholstered-cushion lighting normals at load. Carved
+// architectural edges keep their geometric normals.
+inline std::vector<std::array<float,3>> palace_rock_normals(
+    const tfrag3::Level& level,int geom,const tfrag3::TfragTree& target) {
+  using Key=std::array<s32,3>;
+  using Normal=std::array<float,3>;
+  std::map<Key,Normal> accumulated;
+  auto key=[](const tfrag3::PreloadedVertex& p) -> Key {
+    return {s32(std::lround(p.x/8.f)),s32(std::lround(p.y/8.f)),s32(std::lround(p.z/8.f))};
+  };
+  for (const auto& tree:level.tfrag_trees[geom]) {
+    const auto& vertices=tree.unpacked.vertices;
+    auto triangle=[&](u32 ai,u32 bi,u32 ci) {
+      if(ai==bi || bi==ci || ai==ci || ai>=vertices.size() || bi>=vertices.size() || ci>=vertices.size())return;
+      const auto& a=vertices[ai];const auto& b=vertices[bi];const auto& c=vertices[ci];
+      Normal u={(b.x-a.x)/4096.f,(b.y-a.y)/4096.f,(b.z-a.z)/4096.f};
+      Normal v={(c.x-a.x)/4096.f,(c.y-a.y)/4096.f,(c.z-a.z)/4096.f};
+      Normal n={u[1]*v[2]-u[2]*v[1],u[2]*v[0]-u[0]*v[2],u[0]*v[1]-u[1]*v[0]};
+      float length=std::sqrt(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);
+      if(length<1e-8f)return;
+      // Equal face weights avoid a large top polygon overwhelming bevel sides.
+      for(auto id:{ai,bi,ci})for(int axis=0;axis<3;axis++)accumulated[key(vertices[id])][axis]+=n[axis]/length;
+    };
+    for(const auto& draw:tree.draws) {
+      if(draw.tree_tex_id<0)continue;
+      const auto& name=level.textures.at(draw.tree_tex_id).debug_name;
+      if(name.rfind("waspala-cliff-rock",0)!=0 && name!="waspala-small-rocks" && name!="waspala-throne-cushion")continue;
+      size_t begin=draw.unpacked.idx_of_first_idx_in_full_buffer,count=0;
+      for(const auto& group:draw.vis_groups)count+=group.num_inds;
+      u32 previous[2]={};int run=0;
+      for(size_t i=begin;i<begin+count;i++) {
+        u32 current=tree.unpacked.indices.at(i);
+        if(current==UINT32_MAX){run=0;continue;}
+        if(tree.use_strips) {
+          if(run>=2) {
+            if(run%2)triangle(previous[1],previous[0],current);
+            else triangle(previous[0],previous[1],current);
+          }
+          previous[0]=previous[1];previous[1]=current;++run;
+        } else {
+          if(run==2){triangle(previous[0],previous[1],current);run=0;}
+          else previous[run++]=current;
+        }
+      }
+    }
+  }
+  std::vector<Normal> result(target.unpacked.vertices.size());
+  for(size_t i=0;i<result.size();i++) {
+    auto found=accumulated.find(key(target.unpacked.vertices[i]));
+    if(found==accumulated.end())continue;
+    const auto& n=found->second;
+    float length=std::sqrt(n[0]*n[0]+n[1]*n[1]+n[2]*n[2]);
+    if(length>1e-6f)for(int axis=0;axis<3;axis++)result[i][axis]=n[axis]/length;
+  }
+  return result;
+}
diff --git a/game/graphics/opengl_renderer/background/ShoreField.h b/game/graphics/opengl_renderer/background/ShoreField.h
new file mode 100644
index 00000000..f6e9b04e
--- /dev/null
+++ b/game/graphics/opengl_renderer/background/ShoreField.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <memory>
+#include "common/util/FileUtil.h"
+
+// Shared by liquid renderers, released while their OpenGL context still exists.
+class ShoreField {
+ public:
+  ShoreField() {
+    const auto bytes=file_util::read_binary_file(file_util::get_file_path(
+      {"game/graphics/opengl_renderer/shaders", "palace-shore.bin"}));
+    u32 header[4];
+    ASSERT(bytes.size()>=sizeof(header));
+    memcpy(header,bytes.data(),sizeof(header));
+    ASSERT(header[0]==0x53484F52 && header[1]==1024 && header[2]==1024 && header[3]==4);
+    ASSERT(bytes.size()==16+size_t(header[1])*header[2]*header[3]*sizeof(float));
+    glGenTextures(1,&m_texture);
+    glActiveTexture(GL_TEXTURE27);
+    glBindTexture(GL_TEXTURE_2D_ARRAY,m_texture);
+    glTexImage3D(GL_TEXTURE_2D_ARRAY,0,GL_R16F,header[1],header[2],header[3],0,
+                 GL_RED,GL_FLOAT,bytes.data()+16);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D_ARRAY,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
+    fmt::print("Prototype shoreline: four basin contours loaded from palace geometry\n");
+  }
+  ~ShoreField(){ if(m_texture)glDeleteTextures(1,&m_texture); }
+  void bind(GLint location) {
+    glActiveTexture(GL_TEXTURE27);
+    glBindTexture(GL_TEXTURE_2D_ARRAY,m_texture);
+    glUniform1i(location,27);
+  }
+  static std::shared_ptr<ShoreField> acquire() {
+    static std::weak_ptr<ShoreField> shared;
+    auto field=shared.lock();
+    if(!field){field=std::make_shared<ShoreField>();shared=field;}
+    return field;
+  }
+ private:
+  GLuint m_texture=0;
+};
diff --git a/game/graphics/opengl_renderer/background/Shrub.cpp b/game/graphics/opengl_renderer/background/Shrub.cpp
index a4c7a451..9efcebfd 100644
--- a/game/graphics/opengl_renderer/background/Shrub.cpp
+++ b/game/graphics/opengl_renderer/background/Shrub.cpp
@@ -1,4 +1,5 @@
 #include "Shrub.h"
+#include "game/graphics/opengl_renderer/GrassAnchors.h"
 
 #include "common/log/log.h"
 
@@ -144,6 +145,24 @@ void Shrub::update_load(const LevelData* loader_data) {
                            (void*)offsetof(tfrag3::ShrubGpuVertex, color_index)  // offset (0)
     );
 
+    // GRASS_ROOTS_BEGIN: per-blade anchors from the actual loaded mesh.
+    const auto grass_anchors = GrassAnchors::build(tree, lev_data->textures, lev_data->level_name);
+    if (!grass_anchors.vertices.empty()) {
+      glGenBuffers(1, &m_trees[l_tree].grass_root_buffer);
+      glBindBuffer(GL_ARRAY_BUFFER, m_trees[l_tree].grass_root_buffer);
+      glBufferData(GL_ARRAY_BUFFER, grass_anchors.vertices.size() * sizeof(GrassAnchors::Attribute),
+                   grass_anchors.vertices.data(), GL_STATIC_DRAW);
+      glEnableVertexAttribArray(4);
+      glVertexAttribPointer(4, 4, GL_FLOAT, GL_FALSE, sizeof(GrassAnchors::Attribute), nullptr);
+      lg::info("Remaster grass roots [{}]: {} blades, {} vertices, max height {:.3f}m, {} missing roots",
+               lev_data->level_name, grass_anchors.blades, grass_anchors.affected_vertices,
