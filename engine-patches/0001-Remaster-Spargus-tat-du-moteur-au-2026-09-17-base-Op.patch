+      }
+      draw.first_index_index=tree.indices.size();draw.num_indices=output.size();draw.num_triangles=output.size()/4;
+      tree.indices.insert(tree.indices.end(),output.begin(),output.end());
+      for(const auto& [texture,indices]:material_indices) {
+        auto target=draw;target.tree_tex_id=texture;target.first_index_index=u32(tree.indices.size());
+        target.num_indices=u32(indices.size());target.num_triangles=target.num_indices/4;
