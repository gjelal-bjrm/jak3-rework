+            else if(run==2)run=0;else previous[run++]=current;
+          }
+          for(const auto& face:additions[{di,gi}]) {
+            const int texture=face.contains("texture")?texture_ids.at(face.at("texture").get<std::string>()):draw.tree_tex_id;
+            if(texture==draw.tree_tex_id) {
+              for(const auto& vertex:face.at("vertices"))replacement.push_back(append_vertex(vertex));
+              if(tree.use_strips)replacement.push_back(UINT32_MAX);
+            } else {
+              if constexpr(!tie)throw std::runtime_error("Dedicated TFRAG textures are not supported by this patch schema");
+              auto key=std::make_pair(di,texture);auto found=material_draws.find(key);
+              if(found==material_draws.end()) {
+                tfrag3::StripDraw target=draw;target.runs.clear();target.plain_indices.clear();target.num_triangles=0;
+                target.tree_tex_id=texture;
