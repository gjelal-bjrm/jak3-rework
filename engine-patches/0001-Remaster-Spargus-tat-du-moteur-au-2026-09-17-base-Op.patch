+void main() {
+  int id=gl_VertexID/7,k=gl_VertexID%7;
+  float seed=float(id)*17.91+float(k)*2.73;
+  float life=1.7+.4*sin(seed),age=mod(fire_time+seed,life);
+  float r=fire_sources[id].w,H=fire_heights[id];
