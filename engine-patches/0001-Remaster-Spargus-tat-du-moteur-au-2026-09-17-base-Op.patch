+// Hash the compressed source, so a selection cannot silently target another FR3 revision.
+std::string source_sha256(const std::vector<u8>& source) {
+  constexpr u32 k[] = {
+      0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+      0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+      0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+      0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+      0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+      0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+      0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+      0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+  std::array<u32,8> h = {0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
+                          0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19};
+  auto bytes=source;
+  const u64 bits=u64(bytes.size())*8;
+  bytes.push_back(0x80);
+  while(bytes.size()%64!=56)bytes.push_back(0);
+  for(int i=7;i>=0;--i)bytes.push_back(u8(bits>>(i*8)));
+  auto rotate=[](u32 x,int n){return (x>>n)|(x<<(32-n));};
+  for(size_t offset=0;offset<bytes.size();offset+=64) {
+    u32 w[64];
+    for(int i=0;i<16;++i) {
+      const size_t p=offset+4*i;
+      w[i]=(u32(bytes[p])<<24)|(u32(bytes[p+1])<<16)|(u32(bytes[p+2])<<8)|bytes[p+3];
+    }
+    for(int i=16;i<64;++i) {
+      const u32 a=w[i-15],b=w[i-2];
+      w[i]=w[i-16]+(rotate(a,7)^rotate(a,18)^(a>>3))+w[i-7]+(rotate(b,17)^rotate(b,19)^(b>>10));
+    }
+    auto v=h;
+    for(int i=0;i<64;++i) {
+      const u32 t1=v[7]+(rotate(v[4],6)^rotate(v[4],11)^rotate(v[4],25))+
+          ((v[4]&v[5])^(~v[4]&v[6]))+k[i]+w[i];
+      const u32 t2=(rotate(v[0],2)^rotate(v[0],13)^rotate(v[0],22))+
+          ((v[0]&v[1])^(v[0]&v[2])^(v[1]&v[2]));
+      for(int j=7;j>0;--j)v[j]=v[j-1];
+      v[4]+=t1;v[0]=t1+t2;
+    }
+    for(int i=0;i<8;++i)h[i]+=v[i];
+  }
+  std::string result;
+  for(u32 word:h)result+=fmt::format("{:08x}",word);
+  return result;
+}
