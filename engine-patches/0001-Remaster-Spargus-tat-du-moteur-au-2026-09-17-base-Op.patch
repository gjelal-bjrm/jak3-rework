+      const auto before=tie_triangles(a,int(g),ti,patch,u32(a.packed_vertices.color_indices.size()),true,wind);
+      const auto after=tie_triangles(b,int(g),ti,patch,u32(a.packed_vertices.color_indices.size()),false,wind);
+      entry[wind?"wind_triangles":"static_triangles"]={{"unselected_unchanged",before.faces==after.faces},
+          {"unselected_count",before.faces.size()},{"removed",before.removed},{"added",after.added}};
+    }
