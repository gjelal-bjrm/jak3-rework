+struct ExportSelection {
+  json manifest;
+  std::set<std::string> materials,types;
+  std::set<int> geoms;
+  bool has_bounds=false;
+  std::array<double,4> bounds{};  // xmin, xmax, zmin, zmax, in world metres.
+  std::string sha256;
+
+  static int index(const json& value) {
+    if(!value.is_number_integer() || value.get<double>()<0 ||
+       value.get<double>()>std::numeric_limits<int>::max())
+      throw std::runtime_error("Selection indices must be nonnegative integers");
+    return value.get<int>();
+  }
+  static std::string tree_type(const json& value) {
+    const auto type=value.get<std::string>();
+    if(type!="tfrag" && type!="tie" && type!="shrub" && type!="tie_wind")
+      throw std::runtime_error("tree_type must be tfrag, tie, shrub or tie_wind");
+    return type;
+  }
+  void load(const fs::path& path,const std::vector<u8>& source) {
+    manifest=json::parse(file_util::read_text_file(path));
+    if(!manifest.is_object())throw std::runtime_error("Selection must be a JSON object");
+    if(manifest.contains("level"))manifest.at("level").get<std::string>();
+    for(const char* key:{"materials","tree_types","geoms","trees","instances"})
+      if(manifest.contains(key) && !manifest.at(key).is_array())
+        throw std::runtime_error(fmt::format("Selection {} must be an array",key));
+    if(manifest.contains("materials"))for(const auto& value:manifest.at("materials"))materials.insert(value.get<std::string>());
+    if(manifest.contains("tree_types"))for(const auto& value:manifest.at("tree_types"))types.insert(tree_type(value));
+    if(manifest.contains("geoms"))for(const auto& value:manifest.at("geoms"))geoms.insert(index(value));
+    if(manifest.contains("trees"))for(const auto& tree:manifest.at("trees")) {
+      tree_type(tree.at("tree_type"));index(tree.at("tree"));
+      if(tree.contains("geom"))index(tree.at("geom"));
+    }
+    if(manifest.contains("instances"))for(const auto& instance:manifest.at("instances")) {
+      tree_type(instance.at("tree_type"));index(instance.at("tree"));index(instance.at("instance"));
+      if(instance.contains("geom"))index(instance.at("geom"));
+    }
+    if(manifest.contains("bounds_xz_m")) {
+      const auto& value=manifest.at("bounds_xz_m");
+      if(!value.is_array() || value.size()!=4)throw std::runtime_error("bounds_xz_m requires [xmin,xmax,zmin,zmax]");
+      for(int i=0;i<4;++i) {
+        bounds[i]=value.at(i).get<double>();
+        if(!std::isfinite(bounds[i]))throw std::runtime_error("Bounds must be finite");
+      }
+      if(bounds[0]>bounds[1] || bounds[2]>bounds[3])throw std::runtime_error("Bounds are reversed");
+      has_bounds=true;
+    }
+    sha256=source_sha256(source);
+    if(manifest.contains("source_fr3")) {
+      const auto& expected=manifest.at("source_fr3");
+      if(!expected.is_object())throw std::runtime_error("source_fr3 must be an object");
+      if(expected.contains("bytes") && (!expected.at("bytes").is_number_unsigned() ||
+          expected.at("bytes").get<u64>()!=source.size()))throw std::runtime_error("Source FR3 byte count mismatch");
+      if(expected.contains("sha256")) {
+        auto hash=expected.at("sha256").get<std::string>();
+        std::transform(hash.begin(),hash.end(),hash.begin(),[](unsigned char c){return char(std::tolower(c));});
+        if(hash!=sha256)throw std::runtime_error(fmt::format("Source FR3 SHA-256 mismatch: got {}",sha256));
+      }
+    }
+  }
+  bool includes_tree(const char* type,int geom,int tree)const {
+    if(manifest.contains("tree_types") && !types.count(type))return false;
+    if(manifest.contains("geoms") && !geoms.count(geom))return false;
+    if(manifest.contains("trees")) {
+      for(const auto& candidate:manifest.at("trees"))
+        if(candidate.at("tree_type")==type && candidate.at("tree")==tree &&
+           (!candidate.contains("geom") || candidate.at("geom")==geom))return true;
+      return false;
+    }
+    return true;
+  }
+  bool includes_material(const std::string& name)const {
+    return !manifest.contains("materials") || materials.count(name);
+  }
+  bool includes_instance(const char* type,int geom,int tree,int instance)const {
+    if(!manifest.contains("instances"))return true;
+    for(const auto& candidate:manifest.at("instances"))
+      if(candidate.at("tree_type")==type && candidate.at("tree")==tree &&
+         candidate.at("instance")==instance &&
+         (!candidate.contains("geom") || candidate.at("geom")==geom))return true;
+    return false;
+  }
+  template<typename Vertex>
+  bool includes_triangle(const Vertex& a,const Vertex& b,const Vertex& c)const {
+    if(!has_bounds)return true;
+    // Conservative AABB overlap intentionally retains full crossing triangles.
+    // Never clip or renumber native faces: the patcher needs their original stream keys.
+    return std::max({a.x,b.x,c.x})/4096.0>=bounds[0] &&
+           std::min({a.x,b.x,c.x})/4096.0<=bounds[1] &&
+           std::max({a.z,b.z,c.z})/4096.0>=bounds[2] &&
+           std::min({a.z,b.z,c.z})/4096.0<=bounds[3];
+  }
+};
+}  // namespace
