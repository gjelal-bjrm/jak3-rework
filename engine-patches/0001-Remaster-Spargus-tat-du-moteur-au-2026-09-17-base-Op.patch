+  return mix(mix(fluidHash(i), fluidHash(i+vec2(1,0)), f.x),
+             mix(fluidHash(i+vec2(0,1)), fluidHash(i+vec2(1,1)), f.x), f.y);
+}
+float fluidFbm(vec2 p) {
