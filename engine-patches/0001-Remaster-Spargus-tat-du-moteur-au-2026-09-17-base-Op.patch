+// A shared material must never be overwritten to change one plant instance.
+// Appended textures are level-local and are not registered in the global pool.
+std::map<std::string,int> append_patch_textures(tfrag3::Level& level,const json& patch) {
+  std::map<std::string,int> result;
+  for(size_t i=0;i<level.textures.size();++i)result.emplace(level.textures[i].debug_name,int(i));
+  if(patch.contains("new_textures"))for(const auto& source:patch.at("new_textures")) {
+    const auto name=source.at("name").get<std::string>();
+    const int w=source.at("width"),h=source.at("height");
+    if(w<=0||h<=0||w>16384||h>16384)throw std::runtime_error("Invalid appended texture dimensions");
+    const auto rgba=file_util::read_binary_file(source.at("rgba_file").get<std::string>());
+    if(rgba.size()!=size_t(w)*h*4)throw std::runtime_error("Appended texture RGBA byte count mismatch");
+    if(result.count(name)) {
+      const auto& old=level.textures.at(result.at(name));
+      if(old.w!=w||old.h!=h||old.data.size()*4!=rgba.size()||memcmp(old.data.data(),rgba.data(),rgba.size()))
+        throw std::runtime_error("Appended texture name already refers to different pixels");
+      continue;
+    }
+    tfrag3::Texture texture{};texture.w=u16(w);texture.h=u16(h);
+    texture.debug_name=name;texture.debug_tpage_name=source.value("page",std::string("remaster-local"));
+    texture.load_to_pool=false;texture.data.resize(size_t(w)*h);
+    memcpy(texture.data.data(),rgba.data(),rgba.size());
+    result[name]=int(level.textures.size());level.textures.push_back(std::move(texture));
+  }
+  return result;
+}
