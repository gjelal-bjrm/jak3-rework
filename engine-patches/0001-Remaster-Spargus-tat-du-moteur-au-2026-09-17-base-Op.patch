+void patch_wind_tree(tfrag3::TieTree& tree,int geom,size_t ti,const json& patch,
+                     const std::map<std::string,int>& textures,size_t& removed,size_t& added) {
+  using GroupKey=std::pair<size_t,size_t>;
+  std::map<GroupKey,std::map<size_t,json>> removals;
+  std::map<GroupKey,std::vector<json>> additions;
+  auto applies=[&](const json& f){return f.value("tree_type",std::string("tie"))=="tie_wind"&&f.at("geom")==geom&&f.at("tree")==ti;};
+  for(const auto& f:patch.at("remove"))if(applies(f)) {
+    auto& group=removals[{f.at("draw"),f.at("group")}];
+    if(!group.emplace(f.at("stream_index").get<size_t>(),f).second)throw std::runtime_error("Duplicate wind removal");
+  }
+  for(const auto& f:patch.at("add"))if(applies(f))additions[{f.at("draw"),f.at("group")}].push_back(f);
+  if(removals.empty()&&additions.empty())return;
+  for(const auto& [key,faces]:additions)if(!removals.count(key))throw std::runtime_error("Wind additions require an explicit source group removal");
+  tree.unpacked.indices.clear();tree.unpack();
+  const u32 first_packed=u32(tree.packed_vertices.vertices.size());
+  PatchPalette palette(tree.colors);
+  std::vector<tfrag3::InstancedStripDraw> new_draws;
+  for(auto& [key,remove]:removals) {
+    auto& draw=tree.instanced_wind_draws.at(key.first);
+    const auto& group=draw.instance_groups.at(key.second);
+    const auto& info=tree.wind_instance_info.at(group.instance_idx);
+    size_t offset=0;for(size_t i=0;i<key.second;++i)offset+=draw.instance_groups[i].num;
+    if(offset+group.num>draw.vertex_index_stream.size())throw std::runtime_error("Invalid native wind range");
+    std::map<int,std::vector<u32>> outputs;
+    auto world=[&](u32 id){const auto& p=tree.unpacked.vertices.at(id);
+      return info.matrix[0]*p.x+info.matrix[1]*p.y+info.matrix[2]*p.z+info.matrix[3];};
+    u32 previous[2]={};int run=0;size_t original_triangles=0;
+    for(size_t i=0;i<group.num;++i) {
+      const u32 c=draw.vertex_index_stream.at(offset+i);if(c==UINT32_MAX){run=0;continue;}
+      if(run>=2) {
+        u32 a=previous[0],b=previous[1];if(run%2)std::swap(a,b);
+        if(a!=b&&b!=c&&a!=c) {
+          ++original_triangles;auto match=remove.find(offset+i);
+          if(match!=remove.end()) {
+            const auto& f=match->second;
+            if(f.at("instance")!=group.instance_idx)throw std::runtime_error("Wind instance identity mismatch");
+            for(u32 id:{a,b,c}) {
+              auto p=world(id);bool found=false;
+              for(const auto& expected:f.at("original_positions"))
+                if(std::abs(p.x()/4096.-expected.at(0).get<double>())<.002&&
+                   std::abs(p.y()/4096.-expected.at(1).get<double>())<.002&&
+                   std::abs(p.z()/4096.-expected.at(2).get<double>())<.002)found=true;
+              if(!found)throw std::runtime_error("Wind original world positions changed");
+            }
+            remove.erase(match);++removed;
+          } else outputs[draw.tree_tex_id].insert(outputs[draw.tree_tex_id].end(),{a,b,c,UINT32_MAX});
+        }
+      }
+      previous[0]=previous[1];previous[1]=c;++run;
+    }
+    if(!remove.empty())throw std::runtime_error("Wind removal does not identify a triangle in its source group");
+    const auto a=info.matrix[0].xyz(),b=info.matrix[1].xyz(),c=info.matrix[2].xyz();
+    const auto bc=b.cross(c),ca=c.cross(a),ab=a.cross(b);const double det=a.dot(bc);
+    if(!std::isfinite(det)||std::abs(det)<1e-10)throw std::runtime_error("Noninvertible wind matrix");
+    for(const auto& f:additions[key]) {
+      if(f.at("instance")!=group.instance_idx||f.at("vertices").size()!=3)throw std::runtime_error("Invalid wind addition instance/triangle");
+      const int texture=f.contains("texture")?textures.at(f.at("texture").get<std::string>()):draw.tree_tex_id;
+      for(const auto& source:f.at("vertices")) {
+        math::Vector3f delta,normal;
+        for(int i=0;i<3;++i) {
+          const float p=source.at("p").at(i).get<float>(),n=source.at("normal").at(i).get<float>();
+          if(!std::isfinite(p)||!std::isfinite(n))throw std::runtime_error("Nonfinite wind position/normal");
+          delta[i]=p*4096.f-info.matrix[3][i];normal[i]=n;
+        }
+        // Position uses inverse(M). A world normal uses transpose(M), not inverse(M).
+        const math::Vector3f local{float(delta.dot(bc)/det),float(delta.dot(ca)/det),float(delta.dot(ab)/det)};
+        math::Vector3f local_normal{a.dot(normal),b.dot(normal),c.dot(normal)};
+        const float length=local_normal.length();if(length<1e-8)throw std::runtime_error("Zero wind normal");local_normal/=length;
+        tfrag3::PackedTieVertices::Vertex v{};v.x=local.x();v.y=local.y();v.z=local.z();
+        v.s=source.at("uv").at(0);v.t=source.at("uv").at(1);
+        v.nx=s8(std::lround(std::clamp(local_normal.x(),-1.f,1.f)*127));
+        v.ny=s8(std::lround(std::clamp(local_normal.y(),-1.f,1.f)*127));
+        v.nz=s8(std::lround(std::clamp(local_normal.z(),-1.f,1.f)*127));
+        v.r=v.g=v.b=v.a=128;
+        const u32 id=u32(tree.packed_vertices.color_indices.size());
+        tree.packed_vertices.vertices.push_back(v);tree.packed_vertices.color_indices.push_back(palette.append(source));
+        outputs[texture].push_back(id);
+      }
+      outputs[texture].push_back(UINT32_MAX);++added;
+    }
+    // Keep every original group's range and metadata, and all other stream bytes.
+    // New draws keep the exact original matrix/visibility IDs and GPU wind path.
+    std::fill(draw.vertex_index_stream.begin()+offset,draw.vertex_index_stream.begin()+offset+group.num,UINT32_MAX);
+    if(original_triangles>draw.num_triangles)throw std::runtime_error("Invalid native wind triangle count");
+    draw.num_triangles-=u32(original_triangles);
+    for(auto& [texture,indices]:outputs)if(!indices.empty()) {
+      tfrag3::InstancedStripDraw target{};target.mode=draw.mode;target.tree_tex_id=texture;
+      target.vertex_index_stream=std::move(indices);auto clone=group;clone.num=u32(target.vertex_index_stream.size());
+      target.instance_groups.push_back(clone);target.num_triangles=clone.num/4;new_draws.push_back(std::move(target));
+    }
+  }
+  if(first_packed<tree.packed_vertices.vertices.size())
+    tree.packed_vertices.matrix_groups.push_back({-1,first_packed,u32(tree.packed_vertices.vertices.size()),true});
+  tree.instanced_wind_draws.insert(tree.instanced_wind_draws.end(),new_draws.begin(),new_draws.end());
+  fmt::print("Patched tie_wind LOD {} tree {}: {} appended local vertices, {} appended wind draws\n",geom,ti,
+             tree.packed_vertices.vertices.size()-first_packed,new_draws.size());
+}
