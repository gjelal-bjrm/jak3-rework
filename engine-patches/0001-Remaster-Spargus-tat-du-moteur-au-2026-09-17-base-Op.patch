+      std::map<std::pair<size_t,size_t>,std::vector<json>> additions;
+      for(const auto& face:patch.at("remove"))
+        if(face.value("tree_type",std::string("tie"))==type && face.at("geom")==geom && face.at("tree")==ti) {
+          remove.insert({face.at("draw").get<size_t>(),face.at("stream_index").get<size_t>()});
+          if(face.contains("original_positions"))original_positions[{face.at("draw"),face.at("stream_index")}]=face.at("original_positions");
+        }
+      for(const auto& face:patch.at("add"))
+        if(face.value("tree_type",std::string("tie"))==type && face.at("geom")==geom && face.at("tree")==ti)
+          additions[{face.at("draw").get<size_t>(),face.at("group").get<size_t>()}].push_back(face);
