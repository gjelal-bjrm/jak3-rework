+        {"palette_active_prefix",color_prefix},{"wind_instances_unchanged",a.wind_instance_info.size()==b.wind_instance_info.size()},
+        {"wind_groups_unchanged",true},{"changed_wind_groups",json::array()},
+        {"unmatched_original_static_draws",json::array()},{"appended_wind_draws",b.instanced_wind_draws.size()-a.instanced_wind_draws.size()}};
+    for(size_t i=0;i<a.wind_instance_info.size()&&i<b.wind_instance_info.size();++i)
+      if(serialized_hash(a.wind_instance_info[i])!=serialized_hash(b.wind_instance_info[i]))entry["wind_instances_unchanged"]=false;
+    for(size_t di=0;di<a.instanced_wind_draws.size();++di) {
+      const auto& x=a.instanced_wind_draws[di];const auto& y=b.instanced_wind_draws.at(di);
+      if(x.instance_groups.size()!=y.instance_groups.size()||!pod_prefix(x.instance_groups,y.instance_groups)||
+         x.vertex_index_stream.size()!=y.vertex_index_stream.size()||x.mode.as_int()!=y.mode.as_int()||x.tree_tex_id!=y.tree_tex_id)
+        entry["wind_groups_unchanged"]=false;
+      size_t offset=0;
+      for(size_t gi=0;gi<x.instance_groups.size();++gi) {
+        const auto count=x.instance_groups[gi].num;
+        if(offset+count>y.vertex_index_stream.size()||memcmp(x.vertex_index_stream.data()+offset,y.vertex_index_stream.data()+offset,count*sizeof(u32)))
