+          color=u16(tree.colors.color_count++);
+          tree.colors.data.resize(((tree.colors.color_count+3)/4)*128);
+          for(int p=0;p<8;p++)for(int c=0;c<4;c++)tree.colors.read(color,p,c)=palette[p*4+c];
+          palette_ids.emplace(palette,color);
