+        output["draw_inventory"].push_back({{"type","shrub"},{"geom",0},{"tree",ti},{"draw",di},{"group",0},
+          {"proto",draw.proto_idx},{"material",texture.debug_name},{"page",texture.debug_tpage_name},
+          {"triangles",draw.num_triangles},{"selected_triangles",output["faces"].size()-first_face}});
+    }
+  }
+  if(selected) {
