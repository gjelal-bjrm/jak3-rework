+      tree.unpack();
+      const size_t original_vertex_count=tree.unpacked.vertices.size();
+      const u32 packed_start=tree.packed_vertices.vertices.size();
+      using Palette=std::array<u8,32>;
+      std::map<Palette,u16> palette_ids;
+      for(u32 i=0;i<tree.colors.color_count;i++) {
+        Palette key{};for(int p=0;p<8;p++)for(int c=0;c<4;c++)key[p*4+c]=tree.colors.read(i,p,c);
+        palette_ids.emplace(key,u16(i));
+      }
+      auto append_vertex=[&](const json& source) -> u32 {
+        Palette palette{};
+        for(int p=0;p<8;p++)for(int c=0;c<4;c++) {
+          float value=0;
+          for(int v=0;v<3;v++)value+=source.at("color_weights")[v].get<float>()*
+            tree.colors.read(source.at("color_indices")[v].get<int>(),p,c);
+          palette[p*4+c]=u8(std::clamp(std::lround(value),0l,255l));
+        }
