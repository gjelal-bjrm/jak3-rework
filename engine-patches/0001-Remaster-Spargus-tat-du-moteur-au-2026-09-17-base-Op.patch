+template<class T> std::string serialized_hash(T& object) {
+  Serializer ser;object.serialize(ser);const auto data=ser.get_save_result();
+  return source_sha256(std::vector<u8>(data.first,data.first+data.second));
+}
+template<class T> bool pod_prefix(const std::vector<T>& before,const std::vector<T>& after) {
+  return after.size()>=before.size()&&(before.empty()||memcmp(before.data(),after.data(),before.size()*sizeof(T))==0);
+}
+tfrag3::Level read_native_level(const fs::path& path) {
+  auto raw=file_util::read_binary_file(path);auto bytes=compression::decompress_zstd(raw.data(),raw.size());
+  Serializer ser(bytes.data(),bytes.size());tfrag3::Level level;level.serialize(ser);return level;
+}
+// Read-only measurement against the exact spheres used by cull_check_all_slow.
+// Each static draw group addresses a PC vis_nodes index directly. The renderer
+// evaluates these spheres independently; no fabricated ancestor sphere is used.
+int audit_static_bvh_coverage(const fs::path& source_path,const fs::path& patch_path,
+                             const fs::path& report_path) {
+  auto raw=file_util::read_binary_file(source_path);
+  const auto patch=json::parse(file_util::read_text_file(patch_path));
+  if(patch.at("source_fr3").at("sha256")!=source_sha256(raw))
+    throw std::runtime_error("BVH coverage requires the exact pinned source");
+  auto level=read_native_level(source_path);
+  if(patch.at("level")!=level.level_name)throw std::runtime_error("BVH coverage level mismatch");
+  using Key=std::tuple<int,int,int,int>;
+  std::map<Key,json> groups;
+  size_t checked=0,outside=0;
+  double worst=-std::numeric_limits<double>::infinity();
+  for(const auto& face:patch.at("add")) {
+    if(face.value("tree_type",std::string("tie"))!="tie")
+      throw std::runtime_error("Static BVH coverage accepts only TIE additions");
+    const int geom=face.at("geom"),tree_id=face.at("tree"),draw=face.at("draw"),group=face.at("group");
+    const auto& tree=level.tie_trees.at(geom).at(tree_id);
+    const auto& vis=tree.static_draws.at(draw).vis_groups.at(group);
+    const Key key{geom,tree_id,draw,group};
+    auto found=groups.find(key);
+    if(found==groups.end()) {
+      json row={{"geom",geom},{"tree",tree_id},{"draw",draw},{"group",group},
+                {"vis_index",vis.vis_idx_in_pc_bvh},{"vertices",0},{"outside_vertices",0},
+                {"maximum_outside_m",-1.e30},{"unculled",vis.vis_idx_in_pc_bvh==UINT16_MAX}};
+      if(vis.vis_idx_in_pc_bvh!=UINT16_MAX) {
+        const auto& s=tree.bvh.vis_nodes.at(vis.vis_idx_in_pc_bvh).bsphere;
+        row["sphere_m"]={s.x()/4096.f,s.y()/4096.f,s.z()/4096.f,s.w()/4096.f};
+      }
+      found=groups.emplace(key,std::move(row)).first;
+    }
+    auto& row=found->second;
+    for(const auto& vertex:face.at("vertices")) {
+      ++checked;row["vertices"]=row.at("vertices").get<size_t>()+1;
+      if(vis.vis_idx_in_pc_bvh==UINT16_MAX)continue;
+      const auto& sphere=tree.bvh.vis_nodes.at(vis.vis_idx_in_pc_bvh).bsphere;
+      double distance2=0;
+      for(int axis=0;axis<3;++axis) {
+        // Match float32 input conversion and the packer's world-unit scaling.
+        const float coordinate=vertex.at("p").at(axis).get<float>()*4096.f;
+        if(!std::isfinite(coordinate))throw std::runtime_error("Nonfinite authored BVH point");
+        const double delta=(double(coordinate)-sphere[axis])/4096.;distance2+=delta*delta;
+      }
+      const double excess=std::sqrt(distance2)-double(sphere.w())/4096.;
+      worst=std::max(worst,excess);
+      row["maximum_outside_m"]=std::max(row.at("maximum_outside_m").get<double>(),excess);
+      if(excess>0) {++outside;row["outside_vertices"]=row.at("outside_vertices").get<size_t>()+1;}
+    }
+  }
+  json report={{"status",outside?"needs_expansion":"passed"},{"level",level.level_name},
+      {"source_sha256",source_sha256(raw)},
+      {"patch_sha256",source_sha256(file_util::read_binary_file(patch_path))},
+      {"vertices_checked",checked},{"outside_vertices",outside},
+      {"maximum_outside_m",std::isfinite(worst)?worst:0.},
+      {"all_added_vertices_inside_native_spheres",outside==0},
+      {"source_modified",false},{"groups",json::array()},{"native_bvh_sha256",json::array()}};
+  for(auto& entry:groups)report["groups"].push_back(std::move(entry.second));
+  for(size_t geom=0;geom<level.tie_trees.size();++geom)
+    for(size_t tree=0;tree<level.tie_trees[geom].size();++tree)
+      report["native_bvh_sha256"].push_back({{"geom",geom},{"tree",tree},
+        {"sha256",serialized_hash(level.tie_trees[geom][tree].bvh)}});
+  file_util::write_text_file(report_path,report.dump(2));
+  fmt::print("Static BVH coverage: {} vertices, {} outside, maximum excess {:.6f} m\n",checked,outside,std::isfinite(worst)?worst:0.);
+  return 0;
+}
+using NativeTriangle=std::array<u32,9>;
+struct NativeTriangles {std::vector<NativeTriangle> faces;size_t removed=0,added=0;};
+template<class Callback> void each_triangle(const std::vector<u32>& stream,size_t offset,size_t count,bool strips,Callback callback) {
+  u32 previous[2]={};int run=0;
+  for(size_t i=offset;i<offset+count;++i) {
+    const u32 c=stream.at(i);if(c==UINT32_MAX){run=0;continue;}
+    if((strips&&run>=2)||(!strips&&run==2)) {
+      u32 a=previous[0],b=previous[1];if(strips&&run%2)std::swap(a,b);
+      if(a!=b&&b!=c&&a!=c)callback(a,b,c,i);
+    }
+    if(strips){previous[0]=previous[1];previous[1]=c;++run;}
+    else if(run==2)run=0;else previous[run++]=c;
