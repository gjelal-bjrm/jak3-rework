+  if(patch.contains("textures"))for(const auto& replacement:patch.at("textures")) {
+    bool found=false;
+    for(auto& texture:level.textures)if(texture.debug_name==replacement.at("name").get<std::string>()) {
+      auto rgba=file_util::read_binary_file(replacement.at("rgba_file").get<std::string>());
+      texture.w=replacement.at("width");texture.h=replacement.at("height");
+      ASSERT(rgba.size()==size_t(texture.w)*texture.h*4);
+      texture.data.resize(size_t(texture.w)*texture.h);memcpy(texture.data.data(),rgba.data(),rgba.size());
+      found=true;
