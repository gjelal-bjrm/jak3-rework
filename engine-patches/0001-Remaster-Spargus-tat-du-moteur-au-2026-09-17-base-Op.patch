+  auto patch_tree=[&](const char* type,int geom,size_t ti,auto& tree,auto& draws) {
+      constexpr bool tie=std::is_same_v<std::decay_t<decltype(tree)>,tfrag3::TieTree>;
+      std::set<std::pair<size_t,size_t>> remove;
