+#pragma once
+#include <vector>
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/WaterContacts.h"
+#include "game/graphics/opengl_renderer/ocean/OceanCoastMask.h"
+
+class ModernOcean {
+ public:
+  static bool enabled(const SharedRenderState* state) {
+    const auto eye=state->camera_pos/4096.f;
+    return state->version==GameVersion::Jak3 && state->has_pc_data &&
+      eye.x()>1400.f && eye.x()<2400.f && eye.y()>-60.f && eye.y()<180.f && eye.z()>-1200.f && eye.z()<400.f;
+  }
+  bool bind(SharedRenderState* state, GLuint shader, bool requested, bool far_plane=false) {
+    const auto eye=state->camera_pos/4096.f;
+    const bool active=requested && enabled(state);
+    glUniform1i(glGetUniformLocation(shader,"modern_ocean"),active?1:0);
+    if(!active)return false;
+    snapshot.bind(state,shader);
+    WaterContacts::bind(shader);
+    glUniform1i(glGetUniformLocation(shader,"tex_T25"),25);
+    glUniform1i(glGetUniformLocation(shader,"tex_T26"),26);
+    glUniformMatrix4fv(glGetUniformLocation(shader,"ocean_camera"),1,GL_FALSE,state->prototype_camera);
+    glUniform3fv(glGetUniformLocation(shader,"ocean_eye"),1,eye.data());
+    glUniform1f(glGetUniformLocation(shader,"ocean_time"),LiquidSnapshot::seconds());
+    glUniform1i(glGetUniformLocation(shader,"ocean_far_plane"),far_plane?1:0);
+    // Spargus has green water. Other regions keep their native renderer until
+    // they have their own measured palette and explicit regional opt-in.
+    glUniform3f(glGetUniformLocation(shader,"ocean_body_color"),.061f,.091f,.077f);
+    glUniform3f(glGetUniformLocation(shader,"ocean_reflection_tint"),.93f,1.f,.92f);
+    return true;
+  }
+ private:
+  LiquidSnapshot snapshot;
+};
+
+class ModernOceanSurface {
+ public:
+  ~ModernOceanSurface(){if(vao)glDeleteVertexArrays(1,&vao);if(coast_mask)glDeleteTextures(1,&coast_mask);}
+  void render(SharedRenderState* state) {
+    if(!ModernOcean::enabled(state))return;
+    GLint program,old_vao,depth_func,old_active_texture,old_texture28;GLboolean depth_write,color_mask[4];
+    glGetIntegerv(GL_ACTIVE_TEXTURE,&old_active_texture);
+    glActiveTexture(GL_TEXTURE28);glGetIntegerv(GL_TEXTURE_BINDING_2D,&old_texture28);glActiveTexture(old_active_texture);
+    glGetIntegerv(GL_CURRENT_PROGRAM,&program);glGetIntegerv(GL_VERTEX_ARRAY_BINDING,&old_vao);
+    glGetIntegerv(GL_DEPTH_FUNC,&depth_func);glGetBooleanv(GL_DEPTH_WRITEMASK,&depth_write);glGetBooleanv(GL_COLOR_WRITEMASK,color_mask);
+    const GLenum flags[]={GL_DEPTH_TEST,GL_BLEND,GL_CULL_FACE,GL_SCISSOR_TEST,GL_STENCIL_TEST};GLboolean was_enabled[5];
+    for(int i=0;i<5;i++){was_enabled[i]=glIsEnabled(flags[i]);glDisable(flags[i]);}
+    if(!shader){shader=std::make_unique<Shader>("modern_ocean_surface",state->version);glGenVertexArrays(1,&vao);}
+    shader->activate();material.bind(state,shader->id(),true);
+    bind_coast_mask(shader->id());
+    glUniform1i(glGetUniformLocation(shader->id(),"ocean_horizon_pass"),0);
+    GLint geometry_depth;
+    glActiveTexture(GL_TEXTURE26);glGetIntegerv(GL_TEXTURE_BINDING_2D,&geometry_depth);glActiveTexture(GL_TEXTURE0);
+    glBindVertexArray(vao);glEnable(GL_DEPTH_TEST);glDepthFunc(GL_GEQUAL);glDepthMask(GL_TRUE);glColorMask(GL_TRUE,GL_TRUE,GL_TRUE,GL_TRUE);
+    glDrawArrays(GL_TRIANGLES,0,192*384*6);
+    if(state->camera_pos.y()/4096.f > 9.2f) {
+      // Only the few pixels straddling the optical horizon need a coverage
+      // resolve. A fresh colour snapshot includes our new sea; the original
+      // depth snapshot keeps foreground scenery completely outside the pass.
+      horizon_material.bind(state,shader->id(),true);
+      glUniform1i(glGetUniformLocation(shader->id(),"ocean_horizon_pass"),1);
+      GLint old_texture27;
+      glActiveTexture(GL_TEXTURE27);glGetIntegerv(GL_TEXTURE_BINDING_2D,&old_texture27);
+      glBindTexture(GL_TEXTURE_2D,geometry_depth);
+      glUniform1i(glGetUniformLocation(shader->id(),"ocean_geometry_depth"),27);
+      glDisable(GL_DEPTH_TEST);glDepthMask(GL_FALSE);
+      glDrawArrays(GL_TRIANGLES,0,3);
+      glBindTexture(GL_TEXTURE_2D,old_texture27);glActiveTexture(GL_TEXTURE0);
+      glUniform1i(glGetUniformLocation(shader->id(),"ocean_horizon_pass"),0);
+    }
+    const auto eye=state->camera_pos/4096.f;
+    if(eye.y() < 8.9f && OceanCoastMask::contains(eye.x(),eye.z())) {
+      if(!underwater)underwater=std::make_unique<Shader>("ocean_underwater",state->version);
+      underwater->activate();underwater_material.bind(state,underwater->id(),true);
+      glDisable(GL_DEPTH_TEST);glDepthMask(GL_FALSE);
+      glDrawArrays(GL_TRIANGLES,0,3);
+    }
+    glUseProgram(program);glBindVertexArray(old_vao);glDepthFunc(depth_func);glDepthMask(depth_write);
+    glColorMask(color_mask[0],color_mask[1],color_mask[2],color_mask[3]);
+    for(int i=0;i<5;i++){if(was_enabled[i])glEnable(flags[i]);else glDisable(flags[i]);}
+    glActiveTexture(GL_TEXTURE28);glBindTexture(GL_TEXTURE_2D,old_texture28);glActiveTexture(old_active_texture);
+  }
+ private:
+  void bind_coast_mask(GLuint program) {
+    glActiveTexture(GL_TEXTURE28);
+    if(!coast_mask) {
+      std::vector<uint8_t> pixels(OceanCoastMask::SIZE*OceanCoastMask::SIZE);
+      for(int z=0;z<OceanCoastMask::SIZE;z++)for(int x=0;x<OceanCoastMask::SIZE;x++)
+        pixels[z*OceanCoastMask::SIZE+x]=OceanCoastMask::cell(x,z)?255:0;
+      glGenTextures(1,&coast_mask);glBindTexture(GL_TEXTURE_2D,coast_mask);
+      GLint unpack_buffer;glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING,&unpack_buffer);glBindBuffer(GL_PIXEL_UNPACK_BUFFER,0);
+      glTexImage2D(GL_TEXTURE_2D,0,GL_R8,OceanCoastMask::SIZE,OceanCoastMask::SIZE,0,GL_RED,GL_UNSIGNED_BYTE,pixels.data());
+      glBindBuffer(GL_PIXEL_UNPACK_BUFFER,unpack_buffer);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_NEAREST);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
+    } else glBindTexture(GL_TEXTURE_2D,coast_mask);
+    glUniform1i(glGetUniformLocation(program,"ocean_coast_mask"),28);
+    glUniform4f(glGetUniformLocation(program,"ocean_coast_map"),OceanCoastMask::ORIGIN_X,OceanCoastMask::ORIGIN_Z,3.f,float(OceanCoastMask::SIZE));
+    glActiveTexture(GL_TEXTURE0);
+  }
+  GLuint coast_mask=0;
+  ModernOcean material;std::unique_ptr<Shader> shader;GLuint vao=0;
+  ModernOcean horizon_material;
+  ModernOcean underwater_material;std::unique_ptr<Shader> underwater;
+};
