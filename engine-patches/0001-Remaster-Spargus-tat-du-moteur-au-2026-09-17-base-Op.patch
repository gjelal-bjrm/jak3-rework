+  vec3 projectedOffset = fluidProject(P+vec3(N.x,0.0,N.z)*0.16);
+  vec2 refractUV = clamp(screen+(projectedOffset.xy-fluidProject(P).xy),vec2(0.001),vec2(0.999));
