+  }else{
+    int vertex=gl_VertexID-16*12*6,cell=vertex/6;
+    vec2 uv=(vec2(cell,0)+vec2(c[vertex%6]))/vec2(8,1);
+    float theta=uv.x*2.*PI,r=min(sx*.035,.018)*(1.-uv.y*.45);
