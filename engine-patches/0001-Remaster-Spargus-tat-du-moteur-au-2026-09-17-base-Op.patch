+                           std::fabs(point.y/4096.f-p[1].get<float>())<.002f &&
+                           std::fabs(point.z/4096.f-p[2].get<float>())<.002f)matched=true;
+                      ASSERT_MSG(matched,"Source topology changed: refusing to remove a different triangle");
+                    }
+                  }
