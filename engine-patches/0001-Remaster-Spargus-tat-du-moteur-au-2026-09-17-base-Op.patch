+        offset+=count;
+      }
+    }
+    std::multiset<std::string> remaining;for(auto& draw:b.static_draws)remaining.insert(serialized_hash(draw));
+    for(size_t di=0;di<a.static_draws.size();++di) {
+      const auto found=remaining.find(serialized_hash(a.static_draws[di]));
+      if(found==remaining.end())entry["unmatched_original_static_draws"].push_back(di);else remaining.erase(found);
+    }
