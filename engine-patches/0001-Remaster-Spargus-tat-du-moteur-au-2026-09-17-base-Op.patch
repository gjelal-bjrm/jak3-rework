+struct PatchPalette {
+  using Key=std::array<u8,32>;
+  tfrag3::PackedTimeOfDay& colors;
+  std::map<Key,u16> ids;
+  explicit PatchPalette(tfrag3::PackedTimeOfDay& c):colors(c) {
+    for(u32 i=0;i<c.color_count;++i) {
+      Key key{};for(int p=0;p<8;++p)for(int k=0;k<4;++k)key[p*4+k]=c.read(i,p,k);
+      ids.emplace(key,u16(i));
+    }
+  }
+  u16 append(const json& source) {
+    Key key{};double sum=0;
+    for(int v=0;v<3;++v) {
+      const int id=source.at("color_indices").at(v);const double w=source.at("color_weights").at(v);
+      if(id<0||u32(id)>=colors.color_count||!std::isfinite(w)||w<-.0001)
+        throw std::runtime_error("Invalid source palette index/weight");
+      sum+=w;
+    }
+    if(std::abs(sum-1.)>.002)throw std::runtime_error("Palette weights must sum to one");
+    for(int p=0;p<8;++p)for(int c=0;c<4;++c) {
+      double value=0;
+      for(int v=0;v<3;++v)value+=source.at("color_weights").at(v).get<double>()*
+          colors.read(source.at("color_indices").at(v).get<int>(),p,c);
+      key[p*4+c]=u8(std::clamp(std::lround(value),0l,255l));
+    }
+    auto found=ids.find(key);if(found!=ids.end())return found->second;
+    if(colors.color_count<8192) {
+      const u16 id=u16(colors.color_count++);colors.data.resize(((colors.color_count+3)/4)*128);
+      for(int p=0;p<8;++p)for(int c=0;c<4;++c)colors.read(id,p,c)=key[p*4+c];
+      ids.emplace(key,id);return id;
+    }
+    int best_error=INT_MAX;u16 best=0;
+    for(int v=0;v<3;++v) {
+      const int id=source.at("color_indices").at(v);int error=0;
+      for(int p=0;p<8;++p)for(int c=0;c<4;++c) {int d=int(colors.read(id,p,c))-key[p*4+c];error+=d*d;}
+      if(error<best_error){best_error=error;best=u16(id);}
+    }
+    ids.emplace(key,best);return best;
+  }
+};
