+  float noise=oceanNoise(p.xz*7.-ocean_time*vec2(.65,.31));
+  float bubbles=smoothstep(.68,.88,noise);
+  float coast=(1.-smoothstep(.15,1.1,thickness))*smoothstep(.03,.25,oceanSwell(p.xz).x);
