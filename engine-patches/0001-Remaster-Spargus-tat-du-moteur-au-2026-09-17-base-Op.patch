+  }
+  ASSERT(removed_triangles==patch.at("remove").size());
+  Serializer out;level.serialize(out);auto data=out.get_save_result();
+  auto compressed=compression::compress_zstd(data.first,data.second);
+  file_util::write_binary_file(output_path,compressed.data(),compressed.size());
