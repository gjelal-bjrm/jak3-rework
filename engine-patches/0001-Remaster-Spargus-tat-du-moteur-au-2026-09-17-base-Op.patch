+    float theta=uv.x*2.*PI,phi=uv.y*PI;
+    n=vec3(cos(theta)*sin(phi),cos(phi),sin(theta)*sin(phi));
+    float lobes=1.+.026*cos(theta*5.+.7)*pow(sin(phi),2.);
