+std::set<std::pair<size_t,size_t>> removal_keys(const json* patch,const char* type,int geom,size_t tree) {
+  std::set<std::pair<size_t,size_t>> keys;
+  if(patch)for(const auto& f:patch->at("remove"))
+    if(f.value("tree_type",std::string("tie"))==type&&f.at("geom")==geom&&f.at("tree")==tree)
+      keys.emplace(f.at("draw").get<size_t>(),f.at("stream_index").get<size_t>());
+  return keys;
+}
+void record_triangle(NativeTriangles& result,NativeTriangle record,u32 old_vertex_count,bool source) {
+  if(!source&&(record[6]>=old_vertex_count||record[7]>=old_vertex_count||record[8]>=old_vertex_count)) {
+    if(record[6]<old_vertex_count||record[7]<old_vertex_count||record[8]<old_vertex_count)
+      throw std::runtime_error("New triangle mixes old and appended vertices");
+    ++result.added;return;
+  }
+  // Rotation preserves winding; sorting all three corners would hide flips.
+  if(record[7]<record[6]&&record[7]<record[8]) {auto a=record[6];record[6]=record[7];record[7]=record[8];record[8]=a;}
+  else if(record[8]<record[6]&&record[8]<record[7]) {auto c=record[8];record[8]=record[7];record[7]=record[6];record[6]=c;}
+  result.faces.push_back(record);
+}
+NativeTriangles tie_triangles(tfrag3::TieTree& tree,int geom,size_t ti,const json* patch,u32 old_count,bool source,bool wind) {
+  NativeTriangles result;auto remove=removal_keys(patch,wind?"tie_wind":"tie",geom,ti);
+  if(wind)for(size_t di=0;di<tree.instanced_wind_draws.size();++di) {
+    const auto& draw=tree.instanced_wind_draws[di];size_t offset=0;
+    for(const auto& group:draw.instance_groups) {
+      each_triangle(draw.vertex_index_stream,offset,group.num,true,[&](u32 a,u32 b,u32 c,size_t stream){
+        if(source&&remove.erase({di,stream})){++result.removed;return;}
+        record_triangle(result,{draw.mode.as_int(),u32(draw.tree_tex_id),group.vis_idx,0,group.instance_idx,0,a,b,c},old_count,source);
+      });offset+=group.num;
+    }
+  } else {
+    tree.unpacked.indices.clear();tree.unpack();
+    for(size_t di=0;di<tree.static_draws.size();++di) {
+      const auto& draw=tree.static_draws[di];size_t offset=draw.unpacked.idx_of_first_idx_in_full_buffer;u32 category=0;
+      while(category+1<tree.category_draw_indices.size()&&di>=tree.category_draw_indices[category+1])++category;
+      for(const auto& group:draw.vis_groups) {
+        each_triangle(tree.unpacked.indices,offset,group.num_inds,tree.use_strips,[&](u32 a,u32 b,u32 c,size_t stream){
+          if(source&&remove.erase({di,stream})){++result.removed;return;}
+          record_triangle(result,{draw.mode.as_int(),u32(draw.tree_tex_id),group.vis_idx_in_pc_bvh,group.tie_proto_idx,0,category,a,b,c},old_count,source);
+        });offset+=group.num_inds;
+      }
+    }
+  }
+  if(source&&!remove.empty())throw std::runtime_error("Preservation audit has unknown source triangle keys");
+  std::sort(result.faces.begin(),result.faces.end());return result;
+}
+NativeTriangles shrub_triangles(tfrag3::ShrubTree& tree,size_t ti,const json* patch,u32 old_count,bool source) {
+  NativeTriangles result;auto remove=removal_keys(patch,"shrub",0,ti);
+  for(size_t di=0;di<tree.static_draws.size();++di) {
+    const auto& draw=tree.static_draws[di];
+    each_triangle(tree.indices,draw.first_index_index,draw.num_indices,true,[&](u32 a,u32 b,u32 c,size_t stream){
+      if(source&&remove.erase({di,stream})){++result.removed;return;}
+      record_triangle(result,{draw.mode.as_int(),draw.tree_tex_id,0,draw.proto_idx,0,0,a,b,c},old_count,source);
+    });
+  }
+  if(source&&!remove.empty())throw std::runtime_error("Preservation audit has unknown shrub triangle keys");
+  std::sort(result.faces.begin(),result.faces.end());return result;
+}
+int compare_native(const fs::path& source,const fs::path& candidate,const fs::path& report_path,const json* patch=nullptr) {
+  auto old=read_native_level(source),now=read_native_level(candidate);
