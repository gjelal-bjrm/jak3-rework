+      ASSERT_MSG(remove.empty(),"Patch does not match the original native topology");
+      const u32 packed_end=tree.packed_vertices.vertices.size();
+      if constexpr(tie) {
+        tree.packed_vertices.matrix_groups.push_back({-1,packed_start,packed_end,true});
+        if(!material_draws.empty()) {
+          const auto old_categories=tree.category_draw_indices;
+          std::vector<tfrag3::StripDraw> rebuilt;
+          for(size_t category=0;category+1<old_categories.size();++category) {
+            tree.category_draw_indices[category]=u32(rebuilt.size());
+            for(size_t di=old_categories[category];di<old_categories[category+1];++di) {
+              rebuilt.push_back(std::move(draws[di]));
+              auto it=material_draws.lower_bound({di,std::numeric_limits<int>::min()});
+              for(;it!=material_draws.end()&&it->first.first==di;++it)rebuilt.push_back(std::move(it->second));
+            }
+          }
+          tree.category_draw_indices.back()=u32(rebuilt.size());draws=std::move(rebuilt);
+        }
+      }
+      // Retopology, rounded lips and palm sway stay inside this explicit margin.
+      // Relax the existing hierarchy without changing which group owns a face.
+      if(!patch.value("preserve_bvh",false))for(auto& node:tree.bvh.vis_nodes)node.bsphere.w()+=.85f*4096.f;
+      fmt::print("Patched {} LOD {}: {} new packed vertices, {} time-of-day colors\n",type,geom,
+        packed_end-packed_start,tree.colors.color_count);
+  };
+  for(int geom=0;geom<int(level.tie_trees.size());geom++)
+    for(size_t ti=0;ti<level.tie_trees[geom].size();ti++) {
+      auto& tree=level.tie_trees[geom][ti];patch_tree("tie",geom,ti,tree,tree.static_draws);
+      patch_wind_tree(tree,geom,ti,patch,texture_ids,removed_triangles,added_triangles);
+    }
+  for(int geom=0;geom<int(level.tfrag_trees.size());geom++)
+    for(size_t ti=0;ti<level.tfrag_trees[geom].size();ti++) {
+      auto& tree=level.tfrag_trees[geom][ti];patch_tree("tfrag",geom,ti,tree,tree.draws);
+    }
+  // Shrub props use a different packed format from architectural TIE meshes.
+  for(size_t ti=0;ti<level.shrub_trees.size();ti++) {
+    auto& tree=level.shrub_trees[ti];
+    std::map<size_t,std::set<size_t>> removals;
+    std::map<size_t,std::vector<json>> additions;
+    for(const auto& f:patch.at("remove"))if(f.value("tree_type",std::string("tie"))=="shrub" && f.at("tree")==ti)
+      removals[f.at("draw").get<size_t>()].insert(f.at("stream_index").get<size_t>());
+    for(const auto& f:patch.at("add"))if(f.value("tree_type",std::string("tie"))=="shrub" && f.at("tree")==ti)
+      additions[f.at("draw")].push_back(f);
+    if(removals.empty())continue;
+    tree.unpack();
+    const int identity=tree.packed_vertices.matrices.size();
+    tree.packed_vertices.matrices.push_back({math::Vector4f{1,0,0,0},math::Vector4f{0,1,0,0},math::Vector4f{0,0,1,0},math::Vector4f{0,0,0,1}});
+    std::vector<tfrag3::ShrubDraw> material_draws;
+    for(auto& [di,remove]:removals) {
+      auto& draw=tree.static_draws.at(di);std::vector<u32> output;
+      u32 prev[2]={};int run=0;
+      for(size_t i=draw.first_index_index;i<draw.first_index_index+draw.num_indices;i++) {
+        u32 c=tree.indices.at(i);if(c==UINT32_MAX){run=0;continue;}
+        if(run>=2) {
+          u32 a=prev[0],b=prev[1];if(run%2)std::swap(a,b);
+          if(a!=b && b!=c && a!=c) {
+            if(remove.erase(i))++removed_triangles;
+            else output.insert(output.end(),{a,b,c,UINT32_MAX});
+          }
+        }
+        prev[0]=prev[1];prev[1]=c;++run;
+      }
+      ASSERT(remove.empty());
+      std::map<u32,std::vector<u32>> material_indices;
+      for(const auto& face:additions[di]) {
+        const u32 texture=face.contains("texture")?u32(texture_ids.at(face.at("texture").get<std::string>())):draw.tree_tex_id;
+        auto& target=texture==draw.tree_tex_id?output:material_indices[texture];
+        for(const auto& vertex:face.at("vertices")) {
+          tfrag3::PackedShrubVertices::Vertex v{};
+          v.x=vertex.at("p")[0].get<float>()*4096.f;v.y=vertex.at("p")[1].get<float>()*4096.f;v.z=vertex.at("p")[2].get<float>()*4096.f;
+          v.s=vertex.at("uv")[0];v.t=vertex.at("uv")[1];
+          for(int c=0;c<3;c++)v.rgba[c]=vertex.value("rgba",std::vector<int>{128,128,128})[c];
+          int best=0;for(int k=1;k<3;k++)if(vertex.at("color_weights")[k]>vertex.at("color_weights")[best])best=k;
+          u16 color=vertex.at("color_indices")[best];
