+                found=material_draws.emplace(key,std::move(target)).first;
+              }
+              auto& target=found->second;
+              for(const auto& vertex:face.at("vertices"))target.plain_indices.push_back(append_vertex(vertex));
+              if(tree.use_strips)target.plain_indices.push_back(UINT32_MAX);
+              target.vis_groups[gi].num_inds+=tree.use_strips?4:3;
+              ++target.vis_groups[gi].num_tris;++target.num_triangles;
