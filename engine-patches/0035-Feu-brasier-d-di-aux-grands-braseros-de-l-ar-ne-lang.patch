+// Foyers continus acceptes par ModernFire (x, y base, z, rayon, hauteur) : seules les flammes natives
+// qui s'y trouvent sont masquees ; les gerbes ponctuelles (jets, explosions) gardent leur rendu d'origine.
+struct Zone {
+  float x, y, z, r, h;
+};
+inline std::vector<Zone> zones;
+inline void set_zones(std::vector<Zone> z) { std::lock_guard<std::mutex> guard(mutex); zones = std::move(z); }
+inline bool replaced(const Particle& p) {
+  std::lock_guard<std::mutex> guard(mutex);
+  for (const auto& z : zones) {
+    const float dx = p.x - z.x, dz = p.z - z.z, reach = z.r * 1.6f + .6f;
+    if (dx * dx + dz * dz < reach * reach && p.y > z.y - 1.2f && p.y < z.y + z.h + 2.f) return true;
+  }
+  return false;
+}
 inline bool matches(const std::string& name) {
   return name.size() >= 8 && name.compare(name.size() - 8, 8, "/flame01") == 0;
 }
