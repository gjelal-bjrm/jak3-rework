+  // Lames synthetiques sur les rochers : chaque site natif recoit une lame toutes les 11 a 19 s
+  // (decalage fixe par site), visible jusqu'a 300 m. Nappe + embruns du remaillage d'origine.
+  void render_sites(SharedRenderState* state) {
+    const float now = LiquidSnapshot::seconds();
+    const auto eye = state->camera_pos / 4096.f;
+    m_instances.clear();
+    for (int i = 0; i < COAST_SPLASH_SITE_COUNT; ++i) {
+      const auto& site = COAST_SPLASH_SITES[i];
+      const float dx = site.x - eye.x(), dz = site.z - eye.z();
+      if (dx * dx + dz * dz > 300.f * 300.f) continue;
+      const float period = 11.f + std::fmod(float(i) * 3.137f, 8.f);
+      const float shifted = now + std::fmod(float(i) * 4.71f, period);
+      const float age = std::fmod(shifted, period);
+      if (age > 2.6f) continue;
+      const int cycle = int(shifted / period);
+      const float seed = float((i * 131 + cycle * 17) % 100000);
+      const float variation = std::fmod(seed * .618034f, 1.f);   // 0..1, stable pendant la lame
+      const float yaw = std::atan2(site.sx, site.sz);              // basis[2] du shader = vers le large
+      Instance item{};
+      item.position_scale = {site.x, 9.f, site.z, 7.f + 5.f * variation};                         // largeur 7-12 m
+      item.quaternion_scale = {0.f, std::sin(yaw * .5f), 0.f, 3.5f + 3.f * (1.f - variation)};    // hauteur 3,5-6,5 m
+      item.color = {.8f, .85f, .82f, .5f};
+      item.episode = {age, float(Impact), seed, 0.f};
+      item.origin = {site.x, 9.f, site.z, 0.f};
       m_instances.push_back(item);
     }
     if (m_instances.empty()) return;
