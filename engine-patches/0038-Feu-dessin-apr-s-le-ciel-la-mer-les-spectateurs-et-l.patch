diff --git a/game/graphics/opengl_renderer/FireField.h b/game/graphics/opengl_renderer/FireField.h
index 50173b30..48daed12 100644
--- a/game/graphics/opengl_renderer/FireField.h
+++ b/game/graphics/opengl_renderer/FireField.h
@@ -6,7 +6,7 @@
 
 // Flammes natives (particules « flame01 ») reperees par Sprite3 au moment de leur dessin, dans n'importe quel
 // lieu. Elles ne sont plus dessinees : ModernFire les regroupe en foyers et dessine le nouveau feu a leur place.
-// Les particules d'une image sont lues par ModernFire a l'image suivante (le feu est dessine avant les sprites).
+// Les particules sont lues par ModernFire dans la meme image (le feu est dessine apres les sprites).
 namespace FireField {
 struct Particle {
   float x, y, z, size, alpha;
@@ -21,12 +21,12 @@ inline void collect(u64 frame, const Particle& p) {
   if (building_frame != frame) { building.clear(); building_frame = frame; }
   building.push_back(p);
 }
-// Particules de l'image precedente (vide si aucune flamme n'a ete dessinee).
+// Particules de cette image (le feu est dessine apres les sprites) ou de la precedente.
 inline std::vector<Particle> take(u64 frame) {
   std::lock_guard<std::mutex> guard(mutex);
   std::vector<Particle> out;
-  if (building_frame + 1 == frame) out.swap(building);
-  else if (building_frame != frame) building.clear();
+  if (building_frame == frame || building_frame + 1 == frame) out.swap(building);
+  else building.clear();
   return out;
 }
 // Foyers continus acceptes par ModernFire (x, y base, z, rayon, hauteur) : seules les flammes natives
diff --git a/game/graphics/opengl_renderer/ModernFire.h b/game/graphics/opengl_renderer/ModernFire.h
index e33130a7..8ffae8e9 100644
--- a/game/graphics/opengl_renderer/ModernFire.h
+++ b/game/graphics/opengl_renderer/ModernFire.h
@@ -287,12 +287,10 @@ class ModernFire {
       for (const auto& c : CityFireSources::snapshot(regions, state->camera_pos.data()))
         out.push_back({c.position[0], c.position[1] - .3f, c.position[2], c.position[3] * .6f, c.height * .8f, c.seed, 1.f});
     }
+    // Foyers fixes (palais, ville, arene) : toujours dessines, a toute distance, car leurs flammes natives sont
+    // masquees partout. Les foyers suivis n'existent que la ou le jeu dessine des flammes (deja limites).
     for (const auto& t : m_tracked)
       if (t.s.strength > .01f) out.push_back(t.s);
-    // au-dela de 150 m, le feu natif lointain n'est de toute facon plus lisible
-    const float ex = state->camera_pos[0] / 4096.f, ez = state->camera_pos[2] / 4096.f;
-    out.erase(std::remove_if(out.begin(), out.end(), [&](const Source& s) {
-      return std::hypot(s.x - ex, s.z - ez) > 150.f; }), out.end());
     (void)now;
     return out;
   }
