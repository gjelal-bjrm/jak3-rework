-      else m_palace_fire.render(&m_render_state);                           // ancien prototype (comparaison)
+      if (!m_modern_fire.enabled()) m_palace_fire.render(&m_render_state);  // ancien prototype (comparaison)
     }
     if (bucket_id == (int)jak3::BucketId::BUCKET567) {
       m_modern_weather.update(&m_render_state);   // meteo : nuages, couleurs du moment
@@ -1467,6 +1466,9 @@ void OpenGLRenderer::dispatch_buckets_jak3(DmaFollower dma,
       m_modern_beam.render(&m_render_state);      // rayon des departs de mission (avant la meteo)
       WeatherReflect::capture(&m_render_state);   // image pour les reflets des flaques (avant brouillard et pluie)
       m_modern_weather.render(&m_render_state);   // brouillard, pluie, neige, sable (avant l'interface)
+      // feu du remaster : apres le ciel, la mer, les sprites (spectateurs) et la brume. La brume se calcule
+      // sur la profondeur du decor : devant le ciel elle serait opaque et effacerait la flamme.
+      if (m_modern_fire.enabled()) m_modern_fire.render(&m_render_state);
     }
     if (bucket_id == (int)jak3::BucketId::TEX_HUD_HUD_ALPHA) {
       auto p = prof.make_scoped_child("color-filter");
