 // ---- Vagues de bord de la plage de Spargus (procedurales, remplacent les sprites natifs wave-foam) ----
 // Genere par models-v2/shore/build_shore_tables.py : ligne d eau du sable de la plage de Spargus (y = 9 m).
 const int shorePointCount=10;
@@ -146,11 +94,97 @@ vec4 shoreWave(vec2 xz,float time,out vec2 seaward){
   return vec4(height,foam,swash,front);
