 =?UTF-8?q?nel=20relev=C3=A9,=20soleil=20dans=20le=20reflet,=20tra=C3=AEn?=
 =?UTF-8?q?=C3=A9e=20scintillante),=20ondulations=20de=20bruit=20lisse,=20?=
