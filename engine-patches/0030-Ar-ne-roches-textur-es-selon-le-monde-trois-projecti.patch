@@ -817,12 +817,34 @@ vec3 weatherSurface(vec3 color,vec3 lit,vec3 P,vec3 N){
 }
 // WEATHER_WORLD_END
 
+// ARENA_WORLD_UV_BEGIN
+// Roches de l'arene : texture plaquee selon le monde plutot que selon le plaquage natif (qui l'etire de
+// 2 a 9 fois et la cisaille : invisible avec les textures floues de 2004, « tordu » avec les textures HD).
+// Trois projections (flancs face a x, flancs face a z, dessus) melangees selon la normale lissee :
+// les strates restent horizontales, a la meme echelle partout.
+uniform int palace_world_uv;
+uniform vec4 palace_world_tile;   // metres par repetition (u, v), axe vertical (0 : u, 1 : v), sens
+vec4 arenaWorldTexture(vec3 p, vec3 n) {
+  vec3 w = pow(abs(n) + 1e-4, vec3(6.0)); w /= w.x + w.y + w.z;
+  vec2 per = 1.0 / palace_world_tile.xy;
+  float up = p.y * palace_world_tile.w;
+  vec2 sx = palace_world_tile.z < .5 ? vec2(up, p.z) : vec2(p.z, up);
+  vec2 sz = palace_world_tile.z < .5 ? vec2(up, p.x) : vec2(p.x, up);
+  // trois lectures sans condition : derivees continues, pas de scintillement des niveaux de mip
+  return texture(tex_T0, sx * per) * w.x + texture(tex_T0, sz * per) * w.z
+       + texture(tex_T0, vec2(p.x, p.z) * per) * w.y;
+}
+// ARENA_WORLD_UV_END
+
 void main() {
   vec3 arena_light = arenaRelight(fragment_color.rgb, arena_world);
   vec3 surface_normal = normalize(cross(dFdx(arena_world),dFdy(arena_world)));
   if (gfx_hack_no_tex == 0) {
     //vec4 T0 = texture(tex_T0, tex_coord);
-    vec4 T0 = texture(tex_T0, tex_coord.xy);
+    vec3 world_uv_normal = dot(palace_smooth_normal, palace_smooth_normal) > .01 ? normalize(palace_smooth_normal)
+                                                                                 : surface_normal;
+    vec4 T0 = palace_world_uv != 0 ? arenaWorldTexture(arena_world, world_uv_normal)
+                                   : texture(tex_T0, tex_coord.xy);
     if (fluid_kind == 1) {
       color = vec4(shadeModernLava(arena_world),1.0);
     } else if (fluid_kind == 2) {
