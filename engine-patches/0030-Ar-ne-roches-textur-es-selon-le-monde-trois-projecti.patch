     }
     if (kind) glUniform3f(glGetUniformLocation(program,"palace_eye"),
         state->camera_pos[0]/4096.f,state->camera_pos[1]/4096.f,state->camera_pos[2]/4096.f);
+    // Roches de l'arene : texture plaquee selon le monde (strates horizontales, ni etirement ni torsion).
+    // Le plaquage natif etire ces textures de 2 a 9 fois ; invisible en 2004, flagrant avec les textures HD.
+    const float* tile = kind == 7 ? world_tile(m_names[texture]) : nullptr;
+    glUniform1i(glGetUniformLocation(program,"palace_world_uv"), tile ? 1 : 0);
+    if (tile) {
+      glUniform4f(glGetUniformLocation(program,"palace_world_tile"), tile[0], tile[1], tile[2], tile[3]);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_REPEAT);
+      glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_REPEAT);
+    }
   }
  private:
+  // metres par repetition (u, v), axe vertical (0 : u, 1 : v), sens (+1 : la coordonnee monte avec le monde),
+  // mesures sur le plaquage natif (moyenne ponderee par l'aire des flancs).
+  static const float* world_tile(const std::string& name) {
+    static const float rockwall[4] = {12.2f, 10.8f, 0.f, 1.f};
+    static const float small_rockwall[4] = {6.6f, 5.3f, 1.f, -1.f};
+    static const float interior_rock[4] = {10.5f, 11.0f, 1.f, -1.f};
+    if (name == "wstd-rockwall-01") return rockwall;
+    if (name == "wstd-small-rockwall-01") return small_rockwall;
+    if (name == "wstd-interior-rock01") return interior_rock;
+    return nullptr;
+  }
