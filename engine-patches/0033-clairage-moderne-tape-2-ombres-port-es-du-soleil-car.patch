diff --git a/game/graphics/opengl_renderer/ModernShadows.h b/game/graphics/opengl_renderer/ModernShadows.h
new file mode 100644
index 00000000..d0e8c390
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernShadows.h
@@ -0,0 +1,246 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <map>
+#include <memory>
+#include <set>
+#include <tuple>
+#include <vector>
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "game/graphics/opengl_renderer/ModernAO.h"
+#include "game/graphics/opengl_renderer/WeatherWorld.h"
+#include "game/graphics/opengl_renderer/loader/Loader.h"
+
+// Eclairage moderne, etape 2 : ombres portees du soleil. Chaque image, le decor opaque des niveaux charges
+// (tfrag et tie, niveau de detail 0 ; ni eau, ni lave, ni transparents) est redessine depuis le soleil dans une
+// carte de profondeur de 4096 x 4096 centree sur la camera (rayon 110 m). Le shader du decor (tfrag3) y lit si
+// chaque point voit le soleil : les echafaudages, tribunes, rochers et batiments projettent leur ombre, qui suit
+// l'heure. Force selon la hauteur du soleil et la meteo (nulle la nuit, faible par temps couvert).
+namespace ShadowState {
+inline float matrix[16] = {};     // monde (m) -> coordonnees de la carte [0,1]^3
+inline float strength = 0.f;
+inline float texel = 0.f;         // metres par texel
+inline bool valid = false;
+inline float eye[3] = {};         // camera (m)
+}  // namespace ShadowState
+
+// Appele par PalaceMaterials::bind avant chaque dessin du decor (programme tfrag3, shrub...).
+inline void shadow_bind(GLuint program) {
+  glUniform1i(glGetUniformLocation(program, "shadow_map"), 29);   // toujours : pas de conflit avec l'unite 0
+  const bool on = ShadowState::valid && ShadowState::strength > .01f;
+  glUniform1i(glGetUniformLocation(program, "shadow_on"), on ? 1 : 0);
+  if (!on) return;
+  glUniformMatrix4fv(glGetUniformLocation(program, "shadow_matrix"), 1, GL_FALSE, ShadowState::matrix);
+  glUniform1f(glGetUniformLocation(program, "shadow_strength"), ShadowState::strength);
+  glUniform1f(glGetUniformLocation(program, "shadow_texel"), ShadowState::texel);
+  glUniform3fv(glGetUniformLocation(program, "shadow_eye"), 1, ShadowState::eye);
+}
+
+class ModernShadows {
+ public:
+  static constexpr int kSize = 4096;
+  static constexpr float kRadius = 110.f;
+
+  ~ModernShadows() {
+    for (auto& [k, t] : m_trees) release(t);
+    if (m_depth) glDeleteTextures(1, &m_depth);
+    if (m_fbo) glDeleteFramebuffers(1, &m_fbo);
+  }
+
+  void render(SharedRenderState* state) {
+    ShadowState::valid = false;
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data || !state->loader) return;
+    if (!(LightingState::flags.load() & 2)) return;
+    std::array<float, 3> sun, color;
+    {
+      std::lock_guard<std::mutex> guard(WeatherLook::mutex);
+      sun = WeatherLook::sun_dir; color = WeatherLook::sun_color;
+    }
+    const float len = std::sqrt(sun[0] * sun[0] + sun[1] * sun[1] + sun[2] * sun[2]);
+    if (len < 1e-4f) return;
+    for (auto& c : sun) c /= len;
+    const float lum = .2126f * color[0] + .7152f * color[1] + .0722f * color[2];
+    const float elevation = std::clamp((sun[1] - .03f) / .22f, 0.f, 1.f);
+    const float strength = elevation * std::clamp(lum / .55f, 0.f, 1.f);
+    if (strength < .01f) return;
+    if (!m_shader) init(state);
+    if (!m_shader->okay()) return;
+
+    // matrices : lumiere orthographique centree sur la camera, calee sur la grille des texels (pas de scintillement)
+    const float cx = state->camera_pos[0] / 4096.f, cy = state->camera_pos[1] / 4096.f, cz = state->camera_pos[2] / 4096.f;
+    float up[3] = {0.f, 1.f, 0.f};
+    if (std::abs(sun[1]) > .98f) { up[1] = 0.f; up[2] = 1.f; }
+    float f[3] = {-sun[0], -sun[1], -sun[2]};                       // direction de visee (vers le sol)
+    float s[3] = {f[1] * up[2] - f[2] * up[1], f[2] * up[0] - f[0] * up[2], f[0] * up[1] - f[1] * up[0]};
+    normalize(s);
+    float u[3] = {s[1] * f[2] - s[2] * f[1], s[2] * f[0] - s[0] * f[2], s[0] * f[1] - s[1] * f[0]};
+    const float texel = 2.f * kRadius / kSize;
+    float px = s[0] * cx + s[1] * cy + s[2] * cz, py = u[0] * cx + u[1] * cy + u[2] * cz;
+    px = std::floor(px / texel) * texel; py = std::floor(py / texel) * texel;
+    const float pz = f[0] * cx + f[1] * cy + f[2] * cz;
+    // vue * projection orthographique : x,y dans [-R,R] autour du centre cale, profondeur [-600, 600] m
+    const float near_ = -600.f, far_ = 600.f;
+    float light[16] = {
+        s[0] / kRadius, u[0] / kRadius, 2.f * f[0] / (far_ - near_), 0.f,
+        s[1] / kRadius, u[1] / kRadius, 2.f * f[1] / (far_ - near_), 0.f,
+        s[2] / kRadius, u[2] / kRadius, 2.f * f[2] / (far_ - near_), 0.f,
+        -px / kRadius, -py / kRadius, (-2.f * pz - (far_ + near_)) / (far_ - near_), 1.f};
+    // carte : [-1,1] -> [0,1]
+    for (int c = 0; c < 4; c++)
+      for (int r = 0; r < 3; r++) ShadowState::matrix[c * 4 + r] = .5f * light[c * 4 + r] + .5f * light[c * 4 + 3];
+    for (int c = 0; c < 4; c++) ShadowState::matrix[c * 4 + 3] = light[c * 4 + 3];
+
+    // sauvegarde de l'etat
+    GLint program, vao, read_fb, draw_fb, viewport[4], active, depth_func;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read_fb); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw_fb);
+    glGetIntegerv(GL_VIEWPORT, viewport); glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write); glGetBooleanv(GL_COLOR_WRITEMASK, color_mask);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST,
+                            GL_POLYGON_OFFSET_FILL, GL_PRIMITIVE_RESTART};
+    GLboolean was[7];
+    for (int i = 0; i < 7; i++) was[i] = glIsEnabled(flags[i]);
+
+    glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+    glViewport(0, 0, kSize, kSize);
+    glDisable(GL_BLEND); glDisable(GL_CULL_FACE); glDisable(GL_SCISSOR_TEST); glDisable(GL_STENCIL_TEST);
+    glEnable(GL_DEPTH_TEST); glDepthFunc(GL_LESS); glDepthMask(GL_TRUE);
+    glColorMask(GL_FALSE, GL_FALSE, GL_FALSE, GL_FALSE);
+    glClearDepth(1.0); glClear(GL_DEPTH_BUFFER_BIT);
+    glEnable(GL_POLYGON_OFFSET_FILL); glPolygonOffset(1.6f, 4.f);
+    glEnable(GL_PRIMITIVE_RESTART); glPrimitiveRestartIndex(UINT32_MAX);
+    m_shader->activate();
+    glUniformMatrix4fv(glGetUniformLocation(m_shader->id(), "light_matrix"), 1, GL_FALSE, light);
+
+    std::set<Key> seen;
+    for (auto* level : state->loader->get_in_use_levels()) {
+      if (!level || !level->level) continue;
+      const auto& lev = *level->level;
+      for (size_t t = 0; t < lev.tfrag_trees[0].size() && t < level->tfrag_vertex_data[0].size(); t++) {
+        const auto& tree = lev.tfrag_trees[0][t];
+        if (tree.kind != tfrag3::TFragmentTreeKind::NORMAL && tree.kind != tfrag3::TFragmentTreeKind::DIRT &&
+            tree.kind != tfrag3::TFragmentTreeKind::ICE) continue;
+        Key key{level->load_id, 0, t};
+        seen.insert(key);
+        auto& cache = m_trees[key];
+        if (!cache.vao) build(cache, level->tfrag_vertex_data[0][t], 0, tree.draws, tree.use_strips,
+                              0, tree.draws.size(), &tree.unpacked.indices);
+        draw(cache);
+      }
+      for (size_t t = 0; t < lev.tie_trees[0].size() && t < level->tie_data[0].size(); t++) {
+        const auto& tree = lev.tie_trees[0][t];
+        Key key{level->load_id, 1, t};
+        seen.insert(key);
+        auto& cache = m_trees[key];
+        if (!cache.vao) {
+          // categories opaques : NORMAL et premier dessin des objets a reflets (NORMAL_ENVMAP)
+          const auto& cdi = tree.category_draw_indices;
+          build(cache, level->tie_data[0][t].vertex_buffer, level->tie_data[0][t].index_buffer, tree.static_draws,
+                tree.use_strips, cdi[0], cdi[1], nullptr, cdi[3], cdi[4]);
+        }
+        draw(cache);
+      }
+    }
+    for (auto it = m_trees.begin(); it != m_trees.end();) {      // niveaux decharges
+      if (!seen.count(it->first)) { release(it->second); it = m_trees.erase(it); }
+      else ++it;
+    }
+
+    // restauration
+    glUseProgram(program); glBindVertexArray(vao);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, read_fb); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw_fb);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glDepthFunc(depth_func); glDepthMask(depth_write);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+    for (int i = 0; i < 7; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+    glActiveTexture(GL_TEXTURE29); glBindTexture(GL_TEXTURE_2D, m_depth);
+    glActiveTexture(active);
+    ShadowState::eye[0] = cx; ShadowState::eye[1] = cy; ShadowState::eye[2] = cz;
+    ShadowState::strength = strength; ShadowState::texel = texel; ShadowState::valid = true;
+  }
+
+ private:
+  using Key = std::tuple<u64, int, size_t>;
+  struct TreeCache {
+    GLuint vao = 0, own_ibo = 0;
+    GLenum mode = GL_TRIANGLES;
+    std::vector<GLsizei> counts;
+    std::vector<const void*> offsets;
+  };
+
+  static void normalize(float* v) {
+    const float l = std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+    for (int i = 0; i < 3; i++) v[i] /= std::max(l, 1e-9f);
+  }
+
+  void init(SharedRenderState* state) {
+    m_shader = std::make_unique<Shader>("modern_shadow", state->version);
+    glGenTextures(1, &m_depth);
+    glBindTexture(GL_TEXTURE_2D, m_depth);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT32F, kSize, kSize, 0, GL_DEPTH_COMPONENT, GL_FLOAT, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_FUNC, GL_LEQUAL);
+    GLint old; glGetIntegerv(GL_FRAMEBUFFER_BINDING, &old);
+    glGenFramebuffers(1, &m_fbo); glBindFramebuffer(GL_FRAMEBUFFER, m_fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, m_depth, 0);
+    glDrawBuffer(GL_NONE); glReadBuffer(GL_NONE);
+    glBindFramebuffer(GL_FRAMEBUFFER, old);
+  }
+
+  // Plages d'indices des dessins retenus (dans le tampon d'indices complet de l'arbre).
+  static void ranges(TreeCache& cache, const std::vector<tfrag3::StripDraw>& draws, size_t begin, size_t end) {
+    for (size_t d = begin; d < end && d < draws.size(); d++) {
+      GLsizei n = 0;
+      for (const auto& g : draws[d].vis_groups) n += g.num_inds;
+      if (!n) continue;
+      cache.counts.push_back(n);
+      cache.offsets.push_back((const void*)(size_t(draws[d].unpacked.idx_of_first_idx_in_full_buffer) * sizeof(u32)));
+    }
+  }
+
+  void build(TreeCache& cache, GLuint vbo, GLuint ibo, const std::vector<tfrag3::StripDraw>& draws, bool strips,
+             size_t begin, size_t end, const std::vector<u32>* cpu_indices, size_t begin2 = 0, size_t end2 = 0) {
+    glGenVertexArrays(1, &cache.vao);
+    glBindVertexArray(cache.vao);
+    glBindBuffer(GL_ARRAY_BUFFER, vbo);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(tfrag3::PreloadedVertex),
+                          (void*)offsetof(tfrag3::PreloadedVertex, x));
+    if (cpu_indices) {
+      glGenBuffers(1, &cache.own_ibo);
+      glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, cache.own_ibo);
+      glBufferData(GL_ELEMENT_ARRAY_BUFFER, cpu_indices->size() * sizeof(u32), cpu_indices->data(), GL_STATIC_DRAW);
+    } else {
+      glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, ibo);
+    }
+    glBindVertexArray(0);
+    cache.mode = strips ? GL_TRIANGLE_STRIP : GL_TRIANGLES;
+    ranges(cache, draws, begin, end);
+    if (end2 > begin2) ranges(cache, draws, begin2, end2);
+  }
+
+  static void draw(const TreeCache& cache) {
+    if (cache.counts.empty()) return;
+    glBindVertexArray(cache.vao);
+    glMultiDrawElements(cache.mode, cache.counts.data(), GL_UNSIGNED_INT, cache.offsets.data(),
+                        GLsizei(cache.counts.size()));
+  }
+
+  static void release(TreeCache& cache) {
+    if (cache.vao) glDeleteVertexArrays(1, &cache.vao);
+    if (cache.own_ibo) glDeleteBuffers(1, &cache.own_ibo);
+    cache = TreeCache{};
+  }
+
+  std::unique_ptr<Shader> m_shader;
+  GLuint m_fbo = 0, m_depth = 0;
+  std::map<Key, TreeCache> m_trees;
+};
