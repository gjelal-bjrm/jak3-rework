+// SUN_SHADOW_BEGIN
+// Eclairage moderne : ombres portees du soleil (carte de profondeur du decor vue du soleil, ModernShadows.h).
+uniform int shadow_on;
+uniform sampler2DShadow shadow_map;
+uniform mat4 shadow_matrix;
