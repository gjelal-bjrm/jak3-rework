diff --git a/game/graphics/opengl_renderer/background/Hfrag.cpp b/game/graphics/opengl_renderer/background/Hfrag.cpp
index 8092e290..c1fc9c9c 100644
--- a/game/graphics/opengl_renderer/background/Hfrag.cpp
+++ b/game/graphics/opengl_renderer/background/Hfrag.cpp
@@ -191,6 +191,8 @@ void Hfrag::unload_hfrag_level(Hfrag::HfragLevel* lev) {
 
   glDeleteVertexArrays(1, &lev->montage_vao);
   glDeleteBuffers(1, &lev->montage_vertices);
+  if (lev->height_texture) glDeleteTextures(1, &lev->height_texture);
+  lev->height_texture = 0;
 
   lev->in_use = false;
   lev->name.clear();
@@ -211,6 +213,48 @@ void Hfrag::load_hfrag_level(const std::string& load_name,
   lev->num_colors = data->level->hfrag.time_of_day_colors.color_count;
   lev->hfrag = &data->level->hfrag;
   lev->wang_texture = data->textures.at(data->level->hfrag.wang_tree_tex_id[0]);
+  lev->sand_hd_texture = 0;
+  // remaster : carte des hauteurs du terrain (le maillage est une grille 512 x 512 de sommets espaces de 8 m ;
+  // vi = x + 512 z). Sert a calculer au pixel la pente des dunes (eclairage du relief, rides, paillettes).
+  {
+    std::vector<float> heights(512 * 512, -1e30f);
+    for (const auto& v : lev->hfrag->vertices) {
+      if (v.vi < heights.size()) heights[v.vi] = v.height;
+    }
+    // trous (aucun sommet) : hauteur du voisin le plus proche, par dilatations successives
+    for (int pass = 0; pass < 64; pass++) {
+      bool missing = false;
+      auto next = heights;
+      for (int z = 0; z < 512; z++) {
+        for (int x = 0; x < 512; x++) {
+          if (heights[z * 512 + x] > -1e29f) continue;
+          float sum = 0; int n = 0;
+          const int dx[4] = {1, -1, 0, 0}, dz[4] = {0, 0, 1, -1};
+          for (int k = 0; k < 4; k++) {
+            const int xx = x + dx[k], zz = z + dz[k];
+            if (xx < 0 || zz < 0 || xx >= 512 || zz >= 512) continue;
+            const float h = heights[zz * 512 + xx];
+            if (h > -1e29f) { sum += h; n++; }
+          }
+          if (n) next[z * 512 + x] = sum / n; else missing = true;
+        }
+      }
+      heights.swap(next);
+      if (!missing) break;
+    }
+    for (auto& h : heights) if (h < -1e29f) h = 0.f;
+    glGenTextures(1, &lev->height_texture);
+    glBindTexture(GL_TEXTURE_2D, lev->height_texture);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_R32F, 512, 512, 0, GL_RED, GL_FLOAT, heights.data());
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glBindTexture(GL_TEXTURE_2D, 0);
+  }
+  for (size_t i = 0; i < data->level->textures.size() && i < data->textures.size(); i++) {
+    if (data->level->textures[i].debug_name == "des-sand-hd-v1") lev->sand_hd_texture = data->textures[i];
+  }
 
   if (m_color_result.size() < lev->num_colors) {
     m_color_result.resize(lev->num_colors);
@@ -417,6 +461,48 @@ void Hfrag::render_hfrag_level(Hfrag::HfragLevel* lev,
     glUniform3fv(glGetUniformLocation(program, "weather_sun_dir"), 1, sun.data());
     // tests : pc-remaster-lighting bit 3 = relief du sable coupe (bits 4..6 : rides, grain, teintes seuls)
     glUniform1i(glGetUniformLocation(program, "sand_detail"), (~LightingState::flags.load() >> 3) & 15);
+    // tests : bit 7 = couleur des sommets seule (mesure des zones peintes en eau / herbe par les artistes)
+    glUniform1i(glGetUniformLocation(program, "sand_debug"), (LightingState::flags.load() >> 7) & 1);
+    {
+      float t;
+      { std::lock_guard<std::mutex> guard(WeatherLook::mutex); t = WeatherLook::time; }
+      glUniform1f(glGetUniformLocation(program, "sand_time"), t);
+    }
+    // relief du terrain (carte des hauteurs) : unite 5 ; lumiere du soleil et du ciel pour l'eclairage des dunes
+    glUniform1i(glGetUniformLocation(program, "sand_height"), 5);
+    glUniform1i(glGetUniformLocation(program, "sand_height_on"), lev->height_texture ? 1 : 0);
+    if (lev->height_texture) {
+      glActiveTexture(GL_TEXTURE5);
+      glBindTexture(GL_TEXTURE_2D, lev->height_texture);
+      glActiveTexture(GL_TEXTURE0);
+    }
+    {
+      std::array<float, 3> sun_color, sky;
+      float sun_strength;
+      {
+        std::lock_guard<std::mutex> guard(WeatherLook::mutex);
+        sun_color = WeatherLook::sun_color; sky = WeatherLook::sky;
+      }
+      {
+        std::lock_guard<std::mutex> guard(WeatherState::mutex);
+        sun_strength = WeatherState::current.sun;
+      }
+      glUniform3fv(glGetUniformLocation(program, "weather_sun_color"), 1, sun_color.data());
+      glUniform3fv(glGetUniformLocation(program, "weather_sky"), 1, sky.data());
+      glUniform1f(glGetUniformLocation(program, "weather_sun_strength"), sun_strength);
+    }
+    // sable HD (texture ajoutee au niveau du desert) : unite 4, repetee, avec niveaux de mip
+    glUniform1i(glGetUniformLocation(program, "sand_hd"), 4);
+    glUniform1i(glGetUniformLocation(program, "sand_hd_on"), lev->sand_hd_texture ? 1 : 0);
+    if (lev->sand_hd_texture) {
+      glActiveTexture(GL_TEXTURE4);
+      glBindTexture(GL_TEXTURE_2D, lev->sand_hd_texture);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+      glActiveTexture(GL_TEXTURE0);
+    }
   }
   setup_opengl_from_draw_mode(lev->hfrag->draw_mode, GL_TEXTURE0, false);
 
