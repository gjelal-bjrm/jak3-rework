+// Eaux et effets a texture animee (tree_tex_id < 0, ignores par l'export) : position de chaque dessin.
+int anim_bounds(const fs::path& input,const fs::path& output) {
+  auto level=read_native_level(input);
+  json result=json::array();
+  auto scan=[&](const char* type,int geom,int ti,auto& tree,auto& draws) {
+    tree.unpack();
+    for(size_t di=0;di<draws.size();di++) {
+      const auto& draw=draws[di];if(draw.tree_tex_id>=0)continue;
+      const int slot=-(draw.tree_tex_id+1);
+      const auto& names=jak3_animated_texture_slots();
+      float lo[3]={1e30f,1e30f,1e30f},hi[3]={-1e30f,-1e30f,-1e30f};size_t count=0;
+      size_t offset=draw.unpacked.idx_of_first_idx_in_full_buffer;
+      for(const auto& group:draw.vis_groups) {
+        for(size_t i=0;i<group.num_inds;i++) {
+          const u32 id=tree.unpacked.indices.at(offset+i);if(id==UINT32_MAX)continue;
+          const auto& v=tree.unpacked.vertices.at(id);const float p[3]={v.x/4096.f,v.y/4096.f,v.z/4096.f};
+          for(int k=0;k<3;k++){lo[k]=std::min(lo[k],p[k]);hi[k]=std::max(hi[k],p[k]);}++count;
+        }
+        offset+=group.num_inds;
+      }
+      result.push_back({{"type",type},{"geom",geom},{"tree",ti},{"draw",di},{"slot",slot},
+        {"material",slot<(int)names.size()?names[slot]:std::string("?")},{"indices",count},
+        {"min",{lo[0],lo[1],lo[2]}},{"max",{hi[0],hi[1],hi[2]}}});
+    }
+  };
+  for(int geom=0;geom<int(level.tfrag_trees.size());geom++)
+    for(size_t ti=0;ti<level.tfrag_trees[geom].size();ti++){auto& t=level.tfrag_trees[geom][ti];scan("tfrag",geom,int(ti),t,t.draws);}
+  for(int geom=0;geom<int(level.tie_trees.size());geom++)
+    for(size_t ti=0;ti<level.tie_trees[geom].size();ti++){auto& t=level.tie_trees[geom][ti];scan("tie",geom,int(ti),t,t.static_draws);}
+  file_util::write_text_file(output,result.dump(1));
+  fmt::print("Animated-texture draws: {}\n",result.size());
+  return 0;
+}
