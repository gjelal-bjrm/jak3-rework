+// Remaster : eaux dessinees par le rendu d'eau moderne (bassins et cascades du palais, cascades du desert et du
+// temple). Le nom est celui de la texture animee native de l'eau.
+// Retour : 0 = rendu natif, 2 = eau moderne du palais (bassins, petites cascades), 3 = grande cascade.
+inline int remaster_water_material(const std::string& level, const std::string& material) {
+  if (level == "waspala") return material == "waspala-water-dest" || material == "waspala-waterfall-dest" ? 2 : 0;
+  // noms de texture propres a ces cascades : pas de test sur le nom du niveau (les niveaux du desert ont des noms
+  // internes courts, ex. dst)
+  if (material == "des-waterfall-dest" || material == "temple-waterfall-dest") return 3;
+  return 0;
+}
