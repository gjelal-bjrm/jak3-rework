+// Time-of-day palette capacity: TIE trees use a 32768-texel colour texture (Tie3.h), other trees 8192.
+constexpr u32 kTiePaletteCapacity=32768,kPaletteCapacity=8192;
+
+// When a remodel needs more time-of-day colours than the tree can hold, pick `count` representative
+// colours by weighted median cut (split the box with the largest squared error along its widest
+// channel) and map every wanted colour to the mean of its box. Dense new vertices then keep smooth
+// lighting, instead of snapping to one native corner colour (visible patches).
+std::vector<std::pair<std::array<u8,32>,std::vector<size_t>>> median_cut(
+    const std::vector<std::pair<std::array<u8,32>,u32>>& wanted,size_t count) {
+  struct Box {size_t begin,end;double error;int axis;};
+  std::vector<size_t> order(wanted.size());for(size_t i=0;i<order.size();++i)order[i]=i;
+  auto measure=[&](size_t begin,size_t end) {
+    double w=0,sum[32]={},sq[32]={};
+    for(size_t i=begin;i<end;++i) {
+      const auto& [p,n]=wanted[order[i]];w+=n;
+      for(int c=0;c<32;++c){sum[c]+=double(n)*p[c];sq[c]+=double(n)*p[c]*p[c];}
+    }
+    Box box{begin,end,0,0};double widest=-1;
+    for(int c=0;c<32;++c) {
+      const double e=sq[c]-sum[c]*sum[c]/std::max(w,1.);box.error+=e;
+      if(e>widest){widest=e;box.axis=c;}
+    }
+    if(end-begin<2)box.error=0;
+    return box;
+  };
+  auto cmp=[](const Box& a,const Box& b){return a.error<b.error;};
+  std::vector<Box> heap{measure(0,order.size())},done;
+  while(heap.size()+done.size()<count && !heap.empty()) {
+    std::pop_heap(heap.begin(),heap.end(),cmp);Box box=heap.back();heap.pop_back();
+    if(box.error<=0){done.push_back(box);continue;}
+    std::sort(order.begin()+box.begin,order.begin()+box.end,
+              [&](size_t a,size_t b){return wanted[a].first[box.axis]<wanted[b].first[box.axis];});
+    double total=0,run=0;for(size_t i=box.begin;i<box.end;++i)total+=wanted[order[i]].second;
+    size_t split=box.begin+1;
+    for(size_t i=box.begin;i+1<box.end;++i){run+=wanted[order[i]].second;split=i+1;if(run>=total/2)break;}
+    for(const auto& half:{measure(box.begin,split),measure(split,box.end)}) {
+      heap.push_back(half);std::push_heap(heap.begin(),heap.end(),cmp);
+    }
+  }
+  done.insert(done.end(),heap.begin(),heap.end());
+  std::vector<std::pair<std::array<u8,32>,std::vector<size_t>>> result;
+  for(const auto& box:done) {
+    double w=0,sum[32]={};std::vector<size_t> members;
+    for(size_t i=box.begin;i<box.end;++i) {
+      const auto& [p,n]=wanted[order[i]];w+=n;members.push_back(order[i]);
+      for(int c=0;c<32;++c)sum[c]+=double(n)*p[c];
+    }
+    std::array<u8,32> mean{};
+    for(int c=0;c<32;++c)mean[c]=u8(std::clamp(std::lround(sum[c]/std::max(w,1.)),0l,255l));
+    result.emplace_back(mean,std::move(members));
+  }
+  return result;
+}
