+      // empreinte d'un pixel sur la couche (tres allongee pres de l'horizon) : filtre anti-aliasing
+      float cell=pixelAngle*CLOUD_HEIGHT/max(ray.y*ray.y,1e-4);
+      float d=cloudLayer(xz,sky_coverage,cell);
