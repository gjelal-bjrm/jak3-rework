@@ -0,0 +1,97 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "game/graphics/opengl_renderer/InteriorLightsData.h"
+#include "game/graphics/opengl_renderer/ocean/ModernOcean.h"
+
+// Materiaux v2 (lieux fermes) : les lampes du decor deviennent de vraies sources de lumiere pour le rendu des
+// matieres (reflets sur le metal, lumiere qui deborde sur ce qui entoure la lampe).
+//  - donnees : InteriorLightsData.h (genere par materials-v2/lights/build_lights.py a partir des faces lumineuses
+//    du niveau) : tubes, portee, puissance, couleur, intensite dans les 8 palettes de l'heure du jour ;
+//  - chaque image : les sources les plus proches de la camera, avec leur intensite du moment (les poids des
+//    palettes sont ceux du jeu : les sources pulsent et defilent comme les lampes d'origine) ;
+//  - envoyees une fois par image et par shader (bind).
+namespace InteriorLights {
+constexpr int kMaxLights = 24;
+constexpr float kRange = 70.f;        // au-dela (m), une source ne compte plus (fondu a partir de 50 m)
+
+// poids des 8 palettes de l'heure du jour (r, v, b), 1.0 = plein ; publies par Tie3 a chaque image
+inline float palette_weights[8][3] = {{1, 1, 1}};
+inline void set_palette_weights(const math::Vector<s32, 4> itimes[4]) {
+  for (int component = 0; component < 8; component++) {
+    const int quad_idx = component / 2, word_off = component % 2 * 2;
+    for (int channel = 0; channel < 3; channel++) {
+      const u32 word_val = itimes[quad_idx][word_off + channel / 2];
+      palette_weights[component][channel] = float((channel % 2 ? (word_val >> 16) : word_val) & 0xff) / 64.f;
+    }
+  }
+}
+
+struct Frame {
+  u64 frame = UINT64_MAX;
+  int count = 0;
+  float a[kMaxLights * 4], b[kMaxLights * 4], colour[kMaxLights * 3];
+  std::unordered_map<GLuint, u64> bound;   // shader -> derniere image envoyee
+};
+inline Frame g_frame;
+
+inline void update(const SharedRenderState* state) {
+  if (g_frame.frame == state->frame_idx) return;
+  g_frame.frame = state->frame_idx;
+  g_frame.count = 0;
+  const float eye[3] = {state->camera_pos[0] / 4096.f, state->camera_pos[1] / 4096.f, state->camera_pos[2] / 4096.f};
+  struct Candidate { float score; const InteriorLightData* light; float fade; };
+  std::vector<Candidate> candidates;
+  for (const auto& set : kInteriorLightSets) {       // tous les niveaux charges qui ont des lampes
+    if (!ModernOcean::level_loaded(state, set.level)) continue;
+    for (int i = 0; i < set.count; i++) {
+      const auto& l = set.lights[i];
+      float d2 = 0.f;
+      for (int k = 0; k < 3; k++) { const float d = (l.a[k] + l.b[k]) * .5f - eye[k]; d2 += d * d; }
+      const float d = std::sqrt(d2);
+      if (d > kRange) continue;
+      // les sources puissantes comptent de plus loin
+      candidates.push_back({d - 2.f * std::min(l.power, 8.f), &l, 1.f - std::clamp((d - 50.f) / (kRange - 50.f), 0.f, 1.f)});
+    }
+  }
+  const size_t n = std::min<size_t>(candidates.size(), kMaxLights);
+  std::partial_sort(candidates.begin(), candidates.begin() + n, candidates.end(),
+                    [](const Candidate& x, const Candidate& y) { return x.score < y.score; });
+  for (size_t i = 0; i < n; i++) {
+    const auto& l = *candidates[i].light;
+    // intensite du moment : comme la couleur des sommets de la lampe (somme des palettes x poids, x 2)
+    float level = 0.f;
+    for (int p = 0; p < 8; p++)
+      level += (palette_weights[p][0] + palette_weights[p][1] + palette_weights[p][2]) / 3.f * float(l.pal[p]) / 255.f;
+    level = std::min(level * 2.f, 2.f);
+    const float power = std::clamp(l.power, .25f, 5.f);
+    const float gain = level * power * candidates[i].fade;
+    std::memcpy(&g_frame.a[i * 4], l.a, 12); g_frame.a[i * 4 + 3] = l.radius;
+    std::memcpy(&g_frame.b[i * 4], l.b, 12); g_frame.b[i * 4 + 3] = l.size;
+    for (int k = 0; k < 3; k++) g_frame.colour[i * 3 + k] = l.colour[k] * gain;
+  }
+  g_frame.count = int(n);
+}
+
+// A appeler apres glUseProgram(program). Renvoie le nombre de sources actives.
+inline int bind(GLuint program, const SharedRenderState* state) {
+  update(state);
+  auto& last = g_frame.bound[program];
+  if (last == state->frame_idx + 1) return g_frame.count;
+  last = state->frame_idx + 1;
+  glUniform1i(glGetUniformLocation(program, "mv2_light_count"), g_frame.count);
+  if (g_frame.count) {
+    glUniform4fv(glGetUniformLocation(program, "mv2_light_a"), g_frame.count, g_frame.a);
+    glUniform4fv(glGetUniformLocation(program, "mv2_light_b"), g_frame.count, g_frame.b);
+    glUniform3fv(glGetUniformLocation(program, "mv2_light_colour"), g_frame.count, g_frame.colour);
+  }
+  return g_frame.count;
+}
+}  // namespace InteriorLights
