+  // remaster : code GLSL partage entre plusieurs shaders. Une ligne « #include "nom.glsl" » est remplacee par le
+  // contenu du fichier (dossier des shaders) ; pas d'inclusions imbriquees.
+  const auto expand_includes = [](std::string src) {
+    const std::regex include_line(R"re(#include "([A-Za-z0-9_\-]+\.glsl)")re");
+    std::smatch match;
+    while (std::regex_search(src, match, include_line)) {
+      const auto text = file_util::read_text_file(file_util::get_file_path({shader_folder, match[1].str()}));
+      src = match.prefix().str() + text + match.suffix().str();
+    }
+    return src;
+  };
+  vert_src = expand_includes(vert_src);
+  frag_src = expand_includes(frag_src);
+
   vert_src = std::regex_replace(vert_src, std::regex("HEIGHT_SCALE"), height_scale);
