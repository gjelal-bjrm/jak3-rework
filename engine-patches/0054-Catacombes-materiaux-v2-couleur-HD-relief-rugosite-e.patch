new file mode 100644
index 00000000..a2dc981d
--- /dev/null
+++ b/game/graphics/opengl_renderer/shaders/materials_v2.glsl
@@ -0,0 +1,187 @@
+// ---------------------------------------------------------------- MATERIAUX V2 (lieux fermes)
+// De vraies matieres au lieu d'une image eclairee par les sommets :
+//  - chaque texture a ses cartes (materials-v2/) : relief (normale + hauteur), rugosite, metal, creux ; plus un grain
+//    fin et une variation large plaques selon le monde (meme densite partout, sans etirement) ;
+//  - les lampes du decor sont de vraies sources (InteriorLights.h) : reflets sur le metal qui suivent le regard,
+//    lumiere qui deborde autour de la lampe ; elles pulsent comme dans le jeu ;
+//  - reflets de la salle (panorama des lampes) : le metal reste du metal loin des lampes ;
+//  - la lumiere precalculee du jeu reste la base (ambiance, pulsations) : on calcule en lumiere lineaire par-dessus ;
+//  - mode 2 : lampe = verre epais, la lumiere est derriere le verre (parallaxe), reflets sur le verre.
+uniform int mv2_mode;            // 0 : rendu d'avant ; 1 : matiere ; 2 : lampe (verre lumineux)
+uniform sampler2D tex_T5;        // reflets de la salle : panorama equirectangulaire, racine(radiance / 4)
+uniform sampler2D tex_T6;        // relief : normale (rv), hauteur (b), part du grain du monde (a)
+                                 //   (lampe : normale du verre (rv), transparence du verre (b))
+uniform sampler2D tex_T7;        // matiere : rugosite (r), metal (v), lumiere emise (b), creux (a)
+uniform sampler2D tex_T8;        // variation large (monde) : teinte (rvb, .5 = neutre), rugosite (a, .5 = neutre)
+uniform sampler2D tex_T9;        // grain fin (monde) : normale (rv), creux (b), rugosite (a, .5 = neutre)
+uniform vec4 mv2_world;          // metres par repetition du grain fin, de la variation large ; force du grain, de la variation
+uniform vec3 mv2_eye;            // camera (m)
+uniform float mv2_time;
+uniform int mv2_light_count;
+uniform vec4 mv2_light_a[24];    // extremite A du tube (m), portee
+uniform vec4 mv2_light_b[24];    // extremite B, demi-epaisseur
+uniform vec3 mv2_light_colour[24];
+
+vec3 mv2Lin(vec3 c) { return pow(max(c, vec3(0.)), vec3(2.2)); }
+vec3 mv2Gam(vec3 c) { return pow(max(c, vec3(0.)), vec3(1. / 2.2)); }
+float mv2Luma(vec3 c) { return dot(c, vec3(.2126, .7152, .0722)); }
+
+// repere tangent sans tangentes stockees (derivees de la position et des UV) ; colonnes : dP/du, dP/dv, N
+mat3 mv2Frame(vec3 N, vec3 P, vec2 uv) {
+  vec3 dp1 = dFdx(P), dp2 = dFdy(P); vec2 du1 = dFdx(uv), du2 = dFdy(uv);
+  vec3 dp2perp = cross(dp2, N), dp1perp = cross(N, dp1);
+  vec3 T = dp2perp * du1.x + dp1perp * du2.x, B = dp2perp * du1.y + dp1perp * du2.y;
+  float invmax = inversesqrt(max(dot(T, T), dot(B, B)) + 1e-20);
+  return mat3(T * invmax, B * invmax, N);
+}
+
+// reflets de la salle dans la direction R, flous selon la rugosite
+vec3 mv2Env(vec3 R, float rough) {
+  vec2 e = vec2(atan(R.z, R.x) / 6.2831853 + .5, acos(clamp(R.y, -1., 1.)) / 3.14159265);
+  vec3 c = textureLod(tex_T5, e, .8 + rough * 5.5).rgb;
+  return c * c * 4.;
+}
+
+// lumiere des lampes sur une matiere : reflets (GGX, tubes de lumiere) + diffusion (non-metaux).
+// own : 1 pour une lampe (elle ne se reflete pas elle-meme)
+vec3 mv2Lights(vec3 P, vec3 N, vec3 V, vec3 albedo, float rough, float metal, float own) {
+  vec3 f0 = mix(vec3(.04), albedo, metal);
+  vec3 Rv = reflect(-V, N);
+  float nv = max(dot(N, V), .02);
+  float a = max(rough * rough, .03);
+  vec3 sum = vec3(0.);
+  for (int i = 0; i < mv2_light_count; i++) {
+    vec3 A = mv2_light_a[i].xyz - P, B = mv2_light_b[i].xyz - P;
+    float range = mv2_light_a[i].w, size = mv2_light_b[i].w;
+    vec3 AB = B - A; float ab2 = dot(AB, AB);
+    float tD = ab2 > 1e-5 ? clamp(-dot(A, AB) / ab2, 0., 1.) : 0.;
+    vec3 Ld = A + AB * tD;                       // point du tube le plus proche
+    float d2 = dot(Ld, Ld);
+    if (d2 > range * range) continue;
+    float d = sqrt(d2);
+    if (own > 0. && d < size * 1.5 + .7) continue;
+    float win = 1. - d2 / (range * range); win *= win;
+    float atten = win / (d2 + size * size + .5);
+    float nl = max(dot(N, Ld / d), 0.);
+    // reflet : point du tube le plus proche du rayon reflechi, puis sphere de la demi-epaisseur
+    float tS = tD;
+    if (ab2 > 1e-5) {
+      float rA = dot(Rv, A), rAB = dot(Rv, AB), den = ab2 - rAB * rAB;
+      if (den > 1e-5) tS = clamp((rA * rAB - dot(A, AB)) / den, 0., 1.);
+    }
+    vec3 Ls = A + AB * tS;
+    vec3 toRay = dot(Ls, Rv) * Rv - Ls;
+    Ls += toRay * clamp(size / max(length(toRay), 1e-4), 0., 1.);
+    float ds = max(length(Ls), 1e-3);
+    vec3 L = Ls / ds, H = normalize(L + V);
+    float nls = max(dot(N, L), 0.);
+    float nh = max(dot(N, H), 0.), vh = max(dot(V, H), 0.);
+    float aP = clamp(a + size / (2. * ds), 0., 1.);
+    float den = nh * nh * (a * a - 1.) + 1.;
+    float D = a * a / (3.14159 * den * den) * (a * a) / (aP * aP);      // source etendue : reflet plus large, energie gardee
+    float k = (rough + 1.) * (rough + 1.) * .125;
+    float G = (nv / (nv * (1. - k) + k)) * (nls / (nls * (1. - k) + k));
+    vec3 F = f0 + (max(vec3(1. - rough), f0) - f0) * pow(1. - vh, 5.);   // rugueux : pas de miroir en vue rasante
+    vec3 spec = D * G * F / (4. * nv + .05);
+    sum += (min(spec, vec3(1.4)) * smoothstep(0., .12, nls) + (1. - metal) * albedo * nl / 3.14159) * mv2_light_colour[i] * atten;
+  }
+  return sum * .55;
+}
+
+// normale du grain fin, plaque selon le monde sur les trois axes ; cav : creux ; rmod : rugosite (-.5 .. .5)
+vec3 mv2WorldGrain(vec3 P, vec3 N, float strength, out float cav, out float rmod) {
+  vec3 w = pow(abs(N), vec3(4.)); w /= (w.x + w.y + w.z);
+  float tile = mv2_world.x;
+  vec4 tx = texture(tex_T9, P.zy / tile), ty = texture(tex_T9, P.xz / tile), tz = texture(tex_T9, P.xy / tile);
+  vec2 nx = tx.rg * 2. - 1., ny = ty.rg * 2. - 1., nz = tz.rg * 2. - 1.;
+  vec3 bump = w.x * vec3(0., nx.y, nx.x) + w.y * vec3(ny.x, 0., ny.y) + w.z * vec3(nz.x, nz.y, 0.);
+  cav = dot(w, vec3(tx.b, ty.b, tz.b));
+  rmod = dot(w, vec3(tx.a, ty.a, tz.a)) - .5;
+  return normalize(N + bump * strength);
+}
+vec4 mv2WorldMacro(vec3 P, vec3 N) {
+  vec3 w = pow(abs(N), vec3(4.)); w /= (w.x + w.y + w.z);
+  float tile = mv2_world.y;
+  return w.x * texture(tex_T8, P.zy / tile) + w.y * texture(tex_T8, P.xz / tile) + w.z * texture(tex_T8, P.xy / tile);
+}
+
+// compression douce des hautes lumieres (pas de blanc brule) ; la teinte est gardee
+vec3 mv2Tone(vec3 c) {
+  float y = mv2Luma(c);
+  float t = y > .55 ? .55 + (y - .55) / (1. + (y - .55) / .45) : y;
+  return c * (t / max(y, 1e-4));
+}
+
+// matiere : base = couleur du jeu (texture x lumiere precalculee) ; Ng : normale lisse du modele ou de la face
+vec3 mv2Surface(vec4 T0, vec3 baked, vec2 uv, vec3 P, vec3 Ng) {
+  vec3 V = normalize(mv2_eye - P);
+  if (dot(Ng, V) < 0.) Ng = -Ng;
+  mat3 tbn = mv2Frame(Ng, P, uv);
+  vec4 relief = texture(tex_T6, uv), mat = texture(tex_T7, uv);
+  vec2 nxy = relief.rg * 2. - 1.;
+  vec3 N = normalize(tbn * vec3(nxy, sqrt(max(1. - dot(nxy, nxy), 0.05))));
+  float cav, rmod;
+  // vue rasante : le grain compte moins et la matiere repond plus mat aux lampes (sinon le sol scintille comme
+  // du metal mouille le long des bandes lumineuses)
+  float graze = 1. - max(dot(Ng, V), 0.); graze *= graze;
+  N = mv2WorldGrain(P, N, mv2_world.z * relief.a * (1. - .5 * graze), cav, rmod);
+  vec4 macro = mv2WorldMacro(P, Ng);
+  float k = mv2_world.w * relief.a;
+  vec3 albedo = T0.rgb * mix(vec3(1.), macro.rgb * 2., k);
+  float rough = clamp(mat.r + (macro.a - .5) * k + rmod * relief.a, .2, .95);
+  float metal = mat.g;
+  float ao = mat.a * mix(1., cav, .8 * relief.a);
+  vec3 albedoLin = mv2Lin(albedo);
+  float nv = max(dot(N, V), 0.);
+  // base : lumiere du jeu ; le relief y repond (lumiere dominante venue d'en haut), creux assombris
+  float bend = 1. + .55 * (N.y - Ng.y) + .35 * (dot(N, V) - dot(Ng, V));
+  vec3 bakedLin = mv2Lin(baked);
+  vec3 base = bakedLin * albedoLin * clamp(bend, .35, 1.9) * mix(.35, 1., ao) * (1. - .22 * metal);
+  // reflets de la salle : teintes par le metal, plus forts en vue rasante, a la mesure de la lumiere du lieu
+  vec3 f0 = mix(vec3(.04), albedoLin, metal);
+  vec3 fenv = f0 + (max(vec3(1. - rough), f0) - f0) * pow(1. - nv, 5.);
+  float place = clamp(mv2Luma(baked) / .5, .15, 1.6);
+  vec3 env = mv2Env(reflect(-V, N), rough) * fenv * place * mix(.4, 1., ao);
+  // lampes : la lumiere precalculee sert d'ombre (un endroit que le jeu laisse noir ne recoit pas de reflet)
+  float vis = smoothstep(.03, .30, mv2Luma(baked)) * mix(.5, 1., ao);
+  vec3 lights = mv2Lights(P, N, V, albedoLin, mix(rough, max(rough, .62), graze), metal, 0.) * vis;
+  vec3 c = base + env + lights + albedoLin * bakedLin * mat.b * 3.;
+  return mv2Gam(mv2Tone(c));
+}
+
+// lampe : verre epais, la lumiere est derriere. La couleur d'origine (bande lumineuse) est gardee ; elle est lue
+// decalee selon le regard (parallaxe en vraie grandeur), sous un verre a fines nervures qui reflete les autres lampes.
+vec3 mv2Lamp(vec3 baked, vec2 uv, vec3 P, vec3 Ng) {
+  vec3 V = normalize(mv2_eye - P);
+  if (dot(Ng, V) < 0.) Ng = -Ng;
+  // dP/du, dP/dv en metres (parallaxe juste quel que soit l'etirement de la texture)
+  vec3 dp1 = dFdx(P), dp2 = dFdy(P); vec2 du1 = dFdx(uv), du2 = dFdy(uv);
+  float det = du1.x * du2.y - du1.y * du2.x;
+  det = abs(det) > 1e-14 ? det : 1e-14;
+  vec3 dPdu = (dp1 * du2.y - dp2 * du1.y) / det, dPdv = (dp2 * du1.x - dp1 * du2.x) / det;
+  float mpu = max(length(dPdu), 1e-3), mpv = max(length(dPdv), 1e-3);
+  vec3 Tu = dPdu / mpu, Tv = dPdv / mpv;
+  float nv = max(dot(Ng, V), .25);
+  const float depth = .07;                                       // m : la lumiere est 7 cm derriere le verre
+  vec2 par = clamp(vec2(dot(V, Tu) / mpu, dot(V, Tv) / mpv) * depth / nv, vec2(-.10), vec2(.10));
+  vec4 surf = texture(tex_T6, uv), mat = texture(tex_T7, uv);
+  vec3 inner = mv2Lin(texture(tex_T0, uv - par).rgb);
+  // fines nervures du verre (4 cm, selon le monde) : visibles de pres seulement
+  vec3 at = abs(Tu);
+  float s = at.x > at.y && at.x > at.z ? P.x : (at.y > at.z ? P.y : P.z);
+  float fine = 1. - smoothstep(.004, .02, length(dp1) + length(dp2));
+  float rib = cos(s * 157.08);
+  inner *= 1. + .07 * rib * fine;
+  // niveau : celui du jeu (pulsations), plafonne : la lampe reste de sa couleur, sans virer au blanc
+  vec3 emission = inner * mv2Lin(min(baked, vec3(1.3))) * surf.b * 1.15;
+  // surface du verre : reflets des autres lampes et de la salle
+  vec2 nxy = surf.rg * 2. - 1.;
+  vec3 Nglass = normalize(Ng + Tu * (nxy.x - sin(s * 157.08) * .12 * fine) + Tv * nxy.y);
+  float fres = .04 + .96 * pow(1. - max(dot(Nglass, V), 0.), 5.);
+  vec3 glass = mv2Lights(P, Nglass, V, vec3(.04), mat.r, 0., 1.) + mv2Env(reflect(-V, Nglass), mat.r) * fres * .5;
+  // reflets discrets : ils signalent le verre sans delaver le bleu profond de la lampe
+  vec3 c = mv2Tone(emission + glass * .4);
+  float top = max(c.r, max(c.g, c.b));
+  if (top > 1.) c /= pow(top, .85);                              // sature : on garde la teinte au lieu de blanchir
+  return mv2Gam(c);
+}
