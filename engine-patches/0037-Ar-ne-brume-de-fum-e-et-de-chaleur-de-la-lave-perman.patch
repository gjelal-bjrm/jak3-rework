 =?UTF-8?q?=20et=20de=20chaleur=20de=20la=20lave=20permanente=20;=20feu=20?=
 =?UTF-8?q?:=20zones=20des=20braseros=20sur=20toute=20leur=20hauteur,=20lu?=
 =?UTF-8?q?mi=C3=A8re=20arr=C3=AAt=C3=A9e=20sous=20les=20braises?=
