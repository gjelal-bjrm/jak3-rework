 // Region de mer : niveau, palette, masque de cote et bornes. La region est choisie d'apres les niveaux
 // charges (Spargus : was*, Haven : cty*) puis la position de la camera dans la carte d'ocean native.
@@ -90,7 +91,17 @@ class ModernOcean {
     // Soleil du cycle jour-nuit : direction publiee par le ciel (repli : soleil fixe de 9 h), force nulle la nuit.
     std::array<float,3> sun{-.32f,.66f,-.68f}; bool valid;
     { std::lock_guard<std::mutex> guard(SkyState::mutex); valid=SkyState::valid; if(valid) sun=SkyState::sun; }
-    const float strength=std::clamp((sun[1]+.04f)/.14f,0.f,1.f);
+    // Meteo : sous les nuages, plus d'eclat du soleil ; pluie, mer formee, eau assombrie.
+    float wx_sun=1.f,wx_rain=0.f,wx_sea=0.f,wx_gloom=0.f;
+    {
+      std::lock_guard<std::mutex> guard(WeatherState::mutex);
+      wx_sun=WeatherState::current.sun; wx_rain=WeatherState::current.rain*WeatherState::outdoor;
+      wx_sea=WeatherState::current.sea; wx_gloom=WeatherState::current.darkness;
+    }
+    const float strength=std::clamp((sun[1]+.04f)/.14f,0.f,1.f)*std::clamp(wx_sun,0.f,1.f);
+    glUniform1f(glGetUniformLocation(shader,"ocean_rain"),wx_rain);
+    glUniform1f(glGetUniformLocation(shader,"ocean_storm"),wx_sea);
+    glUniform1f(glGetUniformLocation(shader,"ocean_gloom"),wx_gloom);
     glUniform3fv(glGetUniformLocation(shader,"ocean_sun"),1,sun.data());
     glUniform1f(glGetUniformLocation(shader,"ocean_sun_strength"),strength);
     return true;
