diff --git a/game/graphics/opengl_renderer/shaders/modern_glow.frag b/game/graphics/opengl_renderer/shaders/modern_glow.frag
new file mode 100644
index 00000000..59df3400
--- /dev/null
+++ b/game/graphics/opengl_renderer/shaders/modern_glow.frag
@@ -0,0 +1,41 @@
+#version 410 core
+// Rayonnement des sources de lumiere (lieux fermes) : les lampes, cristaux, bandes lumineuses et feux brillent
+// vraiment. Passe 0 : on garde ce qui est tres lumineux (en quart de resolution) ; passes 1 a 4 : flou large
+// (deux echelles) ; passe 5 : le halo deborde autour de la source et le coeur de la source s'eclaircit vers le blanc.
+in vec2 uv;
+out vec4 color;
+uniform sampler2D tex_T25;   // image de la scene (copie)
+uniform sampler2D tex_T27;   // tampon du halo
+uniform int glow_pass;
+uniform float glow_strength;
+
+float glowWeight(vec3 c) {
+  float mx = max(c.r, max(c.g, c.b)), mn = min(c.r, min(c.g, c.b));
+  float sat = (mx - mn) / max(mx, 1e-3);
+  // sources : tres lumineuses ; les couleurs franches (lampes jaunes, bandes bleues) comptent plus tot
+  return smoothstep(.62 - .22 * sat, .95 - .15 * sat, mx);
+}
+void main() {
+  if (glow_pass == 0) {
+    vec2 px = 1. / vec2(textureSize(tex_T25, 0));
+    vec3 sum = vec3(0.);
+    for (int y = -1; y <= 2; y++) for (int x = -1; x <= 2; x++) {
+      vec3 c = texture(tex_T25, uv + (vec2(x, y) - .5) * px).rgb;
+      sum += c * glowWeight(c);
+    }
+    color = vec4(sum / 16., 1.);
+  } else if (glow_pass <= 4) {
+    float step_ = glow_pass >= 3 ? 2.5 : 1.;
+    vec2 axis = (glow_pass == 1 || glow_pass == 3 ? vec2(1, 0) : vec2(0, 1)) / vec2(textureSize(tex_T27, 0)) * step_;
+    vec4 c = texture(tex_T27, uv) * .227027;
+    c += (texture(tex_T27, uv + axis * 1.384615) + texture(tex_T27, uv - axis * 1.384615)) * .316216;
+    c += (texture(tex_T27, uv + axis * 3.230769) + texture(tex_T27, uv - axis * 3.230769)) * .070270;
+    color = c;
+  } else {
+    vec3 scene = texture(tex_T25, uv).rgb;
+    vec3 glow = texture(tex_T27, uv).rgb;
+    float w = glowWeight(scene);
+    scene = mix(scene, mix(scene, vec3(1.), .55) * 1.08, w * .6 * glow_strength);   // coeur de la source
+    color = vec4(scene + glow * 1.6 * glow_strength, 1.);
+  }
+}
