     color.rgb = applySunShadow(color.rgb, arena_world, shadow_normal);   // ombres portees du soleil
@@ -1003,6 +1029,7 @@ void main() {
       // matieres deja eclairees par leur relief (roches, palais) : soleil stylise plus discret
       color.rgb = genshinLook(color.rgb, gn, palace_material != 0 ? .45 : 1.);
     }
+    if (interior_look > 0.) color.rgb = interiorGrade(color.rgb);
     }
