diff --git a/game/graphics/opengl_renderer/ModernGlow.h b/game/graphics/opengl_renderer/ModernGlow.h
new file mode 100644
index 00000000..f8ec5f7d
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernGlow.h
@@ -0,0 +1,92 @@
+#pragma once
+#include <algorithm>
+#include <memory>
+#include "game/graphics/opengl_renderer/ModernAO.h"
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/ocean/ModernOcean.h"
+
+// Rayonnement des sources de lumiere dans les lieux fermes (catacombes, mines, nid, salles du temple, egouts) :
+// avant, on voyait une zone eclairee mais la lampe elle-meme ne brillait pas. Halo large en quart de resolution
+// (deux echelles de flou), coeur de la source eclairci. Avant l'interface (le texte ne rayonne pas).
+// Test : pc-remaster-lighting bit 10 (1024) coupe ce rayonnement (avec l'eclairage d'interieur).
+class ModernGlow {
+ public:
+  ~ModernGlow() { clear(); }
+  void render(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    if (LightingState::flags.load() & 1024) return;
+    bool interior = false;
+    for (const char* prefix : {"comb", "mine", "nst", "sew", "templea", "templeb", "templec", "templed"})
+      interior = interior || ModernOcean::level_loaded(state, prefix);
+    if (!interior) return;
+    if (!m_shader) { m_shader = std::make_unique<Shader>("modern_glow", state->version); glGenVertexArrays(1, &m_vao); }
+    if (!m_shader->okay()) return;
+    GLint old_program, old_vao, old_read, old_draw, old_active, viewport[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &old_program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &old_vao);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &old_active); glGetIntegerv(GL_VIEWPORT, viewport);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST};
+    GLboolean enabled[5], color_mask[4], depth_write;
+    glGetBooleanv(GL_COLOR_WRITEMASK, color_mask); glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+    for (int i = 0; i < 5; i++) { enabled[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE); glDepthMask(GL_FALSE);
+    GLint saved27; glActiveTexture(GL_TEXTURE27); glGetIntegerv(GL_TEXTURE_BINDING_2D, &saved27);
+    m_shader->activate();
+    const auto id = m_shader->id();
+    m_scene.bind(state, id);
+    glUniform1i(glGetUniformLocation(id, "tex_T25"), 25);
+    glUniform1i(glGetUniformLocation(id, "tex_T27"), 27);
+    glUniform1f(glGetUniformLocation(id, "glow_strength"), 1.f);
+    const int w = std::max(1, state->render_fb_w / 4), h = std::max(1, state->render_fb_h / 4);
+    if (w != m_width || h != m_height) {
+      clear_targets(); m_width = w; m_height = h;
+      glGenFramebuffers(2, m_fbo); glGenTextures(2, m_texture);
+      glActiveTexture(GL_TEXTURE27);
+      for (int i = 0; i < 2; i++) {
+        glBindTexture(GL_TEXTURE_2D, m_texture[i]);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA16F, w, h, 0, GL_RGBA, GL_FLOAT, nullptr);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glBindFramebuffer(GL_FRAMEBUFFER, m_fbo[i]);
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_texture[i], 0);
+      }
+    }
+    glBindVertexArray(m_vao);
+    glViewport(0, 0, w, h);
+    const auto pass = glGetUniformLocation(id, "glow_pass");
+    glActiveTexture(GL_TEXTURE27);
+    for (int p = 0; p < 5; p++) {   // 0 : extraction -> A ; 1 : A -> B ; 2 : B -> A ; 3 : A -> B ; 4 : B -> A
+      glBindFramebuffer(GL_FRAMEBUFFER, m_fbo[p % 2 == 1 ? 1 : 0]);
+      glBindTexture(GL_TEXTURE_2D, p == 0 ? 0 : m_texture[p % 2 == 1 ? 0 : 1]);
+      glUniform1i(pass, p);
+      glDrawArrays(GL_TRIANGLES, 0, 3);
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, state->render_fb);
+    glViewport(0, 0, state->render_fb_w, state->render_fb_h);
+    glBindTexture(GL_TEXTURE_2D, m_texture[0]);
+    glUniform1i(pass, 5);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+
+    glBindTexture(GL_TEXTURE_2D, saved27);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+    glViewport(viewport[0], viewport[1], viewport[2], viewport[3]);
+    glBindVertexArray(old_vao); glUseProgram(old_program); glActiveTexture(old_active);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]); glDepthMask(depth_write);
+    for (int i = 0; i < 5; i++) if (enabled[i]) glEnable(flags[i]);
+  }
+
+ private:
+  void clear_targets() {
+    if (m_fbo[0]) glDeleteFramebuffers(2, m_fbo);
+    if (m_texture[0]) glDeleteTextures(2, m_texture);
+    m_fbo[0] = m_fbo[1] = m_texture[0] = m_texture[1] = 0;
+  }
+  void clear() { clear_targets(); if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+  std::unique_ptr<Shader> m_shader;
+  LiquidSnapshot m_scene;
+  GLuint m_vao = 0, m_fbo[2] = {}, m_texture[2] = {};
+  int m_width = 0, m_height = 0;
+};
