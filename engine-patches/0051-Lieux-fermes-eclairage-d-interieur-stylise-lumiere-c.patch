diff --git a/game/graphics/opengl_renderer/shaders/tfrag3.frag b/game/graphics/opengl_renderer/shaders/tfrag3.frag
index 11e9da44..1f7cb442 100644
--- a/game/graphics/opengl_renderer/shaders/tfrag3.frag
+++ b/game/graphics/opengl_renderer/shaders/tfrag3.frag
@@ -14,6 +14,7 @@ uniform vec4 fog_color;
 
 uniform int gfx_hack_no_tex;
 uniform float genshin_look;   // rendu du decor « facon Genshin » : 0 = d'origine, 1 = plein effet (voir GENSHIN_LOOK)
+uniform float interior_look;  // lieux fermes (catacombes, mines, nid, temple, egouts) : eclairage d'interieur stylise
 
 
 // Spargus arena prototype, morning lighting. World positions are GOAL units / 4096.
@@ -973,6 +974,29 @@ vec3 genshinLook(vec3 c, vec3 n, float relightScale) {
 }
 // GENSHIN_LOOK_END
 
+// ---------------------------------------------------------------- INTERIOR_LOOK
+// Interieurs facon Genshin : la lumiere precalculee du jeu (flaques des lampes, des feux, des cristaux) devient plus
+// franche et plus chaude ; la penombre n'est plus un brun sale mais une ombre fraiche, bleutee, un peu remontee
+// (on lit les formes dans le noir) ; couleurs plus vives. Le contraste lumiere chaude / ombre froide fait l'ambiance.
+vec3 interiorLight(vec3 L) {
+  float k = interior_look;
+  float y = dot(L, vec3(.2126, .7152, .0722));
+  float pool = smoothstep(.30, .95, y);
+  vec3 grey = vec3(y);
+  vec3 hue = mix(L, grey, .35 * k);                                       // teinte d'origine en partie gardee
+  vec3 warm = hue * mix(vec3(1.), vec3(1.20, 1.04, .82), k) * (1. + .35 * k * pool);   // flaques de lumiere
+  vec3 cool = hue * mix(vec3(1.), vec3(.80, .92, 1.25), k) + vec3(.035, .05, .085) * k;  // penombre fraiche
+  return mix(cool, warm, pool);
+}
+vec3 interiorGrade(vec3 c) {
+  float k = interior_look;
+  float y = dot(c, vec3(.2126, .7152, .0722));
+  float mx = max(c.r, max(c.g, c.b)), mn = min(c.r, min(c.g, c.b));
+  float sat = (mx - mn) / max(mx, 1e-3);
+  c = max(mix(vec3(y), c, 1. + k * (.15 + .35 * (1. - sat))), vec3(0.));   // vibrance
+  return c * (1. + .06 * k);
+}
+
