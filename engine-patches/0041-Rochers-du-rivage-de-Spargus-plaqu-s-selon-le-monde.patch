diff --git a/game/graphics/opengl_renderer/background/PalaceMaterials.h b/game/graphics/opengl_renderer/background/PalaceMaterials.h
index e956b1ef..207affca 100644
--- a/game/graphics/opengl_renderer/background/PalaceMaterials.h
+++ b/game/graphics/opengl_renderer/background/PalaceMaterials.h
@@ -96,10 +96,12 @@ class PalaceMaterials {
     static const float small_rockwall[4] = {6.6f, 5.3f, 1.f, -1.f};
     static const float interior_rock[4] = {10.5f, 11.0f, 1.f, -1.f};
     static const float spargus_mountain[4] = {27.8f, 20.2f, 0.f, 1.f};   // montagnes de Spargus (waswide)
+    static const float spargus_shore[4] = {8.3f, 18.8f, 1.f, -1.f};       // rochers du rivage (wascityb)
     if (name == "wstd-rockwall-01") return rockwall;
     if (name == "wstd-small-rockwall-01") return small_rockwall;
     if (name == "wstd-interior-rock01") return interior_rock;
     if (name == "wascity-outerwall-rock") return spargus_mountain;
+    if (name == "wascity-ocean-shore-rocks") return spargus_shore;
     return nullptr;
   }
   // Arene de Spargus : relief et reponse a la lumiere par matiere, sur toutes les grandes surfaces
