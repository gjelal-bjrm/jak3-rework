---
 game/graphics/opengl_renderer/WaterContacts.h            | 9 +++++++--
 game/graphics/opengl_renderer/ocean/ModernOcean.h        | 2 +-
 .../opengl_renderer/shaders/modern_ocean_surface.frag    | 8 ++++++--
 3 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/game/graphics/opengl_renderer/WaterContacts.h b/game/graphics/opengl_renderer/WaterContacts.h
index 0d6b6949..8ac511bc 100644
--- a/game/graphics/opengl_renderer/WaterContacts.h
+++ b/game/graphics/opengl_renderer/WaterContacts.h
@@ -57,12 +57,17 @@ inline void push_stroke(const float* packet, unsigned hand) {
   static std::array<float,2> times{-100.f,-100.f};
   const float t=LiquidSnapshot::seconds();
   const float x=packet[0]/4096.f,y=packet[1]/4096.f,z=packet[2]/4096.f;
-  if(std::abs(y-9.f)>.65f || t-times[hand]<.20f)return;
+  // Niveaux de mer des regions rendues (Spargus 9 m, port de Haven 0 m) : le coup de bras est rattache
+  // au niveau le plus proche ; le shader ignore les contacts eloignes de plus de 1 m de sa surface.
+  static constexpr float sea_levels[]={9.f,0.f};
+  float level=sea_levels[0];
+  for(float candidate:sea_levels)if(std::abs(y-candidate)<std::abs(y-level))level=candidate;
+  if(std::abs(y-level)>.65f || t-times[hand]<.20f)return;
   const float dx=x-last[hand][0],dy=y-last[hand][1],dz=z-last[hand][2];
   const float distance=std::sqrt(dx*dx+dy*dy+dz*dz);
   if(distance<.025f)return;
   const float speed=times[hand]<0.f ? 1.f : std::min(4.f,distance/std::max(.016f,t-times[hand]));
-  contacts[next]={x,9.f,z,t};strengths[next]=.030f+speed*.010f;
+  contacts[next]={x,level,z,t};strengths[next]=.030f+speed*.010f;
   static std::array<bool,2> logged{};
   if(!logged[hand]) {
     fmt::print("Prototype swim stroke: hand {}, animated contact {:.2f}, {:.2f}, {:.2f}\n",hand,x,y,z);
diff --git a/game/graphics/opengl_renderer/ocean/ModernOcean.h b/game/graphics/opengl_renderer/ocean/ModernOcean.h
index 53c92f48..e703cfec 100644
--- a/game/graphics/opengl_renderer/ocean/ModernOcean.h
+++ b/game/graphics/opengl_renderer/ocean/ModernOcean.h
@@ -30,7 +30,7 @@ inline const OceanRegion OCEAN_SPARGUS{"spargus", "was", 9.f, -60.f, 180.f,
 // tire vers le bleu a la demande de l'utilisateur.
 inline const OceanRegion OCEAN_HAVEN{"haven", "cty", OceanCoastMaskCity::LEVEL, -80.f, 260.f,
   OceanCoastMaskCity::ORIGIN_X, OceanCoastMaskCity::ORIGIN_Z, OceanCoastMaskCity::SIZE, OceanCoastMaskCity::cell, OceanCoastMaskCity::contains,
-  {.08f, .19f, .33f}, {.02f, .06f, .15f}, {.11f, .16f, .26f}, {.70f, .38f, .14f}, {.94f, .96f, 1.f}, {.02f, .06f, .12f}, .45f};
+  {.12f, .27f, .42f}, {.03f, .09f, .20f}, {.14f, .20f, .32f}, {.70f, .38f, .14f}, {.80f, .84f, .92f}, {.03f, .09f, .20f}, .7f};
 
 class ModernOcean {
  public:
diff --git a/game/graphics/opengl_renderer/shaders/modern_ocean_surface.frag b/game/graphics/opengl_renderer/shaders/modern_ocean_surface.frag
index b1f01991..908250ed 100644
--- a/game/graphics/opengl_renderer/shaders/modern_ocean_surface.frag
+++ b/game/graphics/opengl_renderer/shaders/modern_ocean_surface.frag
@@ -369,9 +369,13 @@ vec3 shadeModernOcean() {
   body+=ocean_shallow*.18*crest;
   float far=smoothstep(80.,700.,range);
   body=mix(body,ocean_far,far*.7);
+  // Ombrage des ondulations : la face des vaguelettes tournee vers le soleil s'eclaire, l'autre s'assombrit.
+  // Sans cela, vue du dessus, l'eau devient un plan uni ou les vagues n'existent plus.
+  float shade=dot(n,oceanSunDirection)*.5+.5;
+  body*=mix(.72,1.30,shade);
   // ---- Reflet : le ciel (avec soleil) et le decor proche ; Fresnel releve pour une surface bien miroir
   float facing=max(dot(n,v),0.);
-  float fresnel=.06+.94*pow(1.-facing,4.);
+  float fresnel=.09+.91*pow(1.-facing,4.);
   vec3 reflection=oceanReflection(p,n,v);
   vec3 result=mix(body,reflection,fresnel);
   // ---- Trainee de soleil : scintillement serre sur le grain, lobe doux sur les vaguelettes
@@ -388,7 +392,7 @@ vec3 shadeModernOcean() {
     float age=ocean_time-fluid_contacts[i].w;
     if(fluid_strength[i]<=0. || age<0. || age>2. || abs(fluid_contacts[i].y-ocean_level)>1.)continue;
     float d=length(p.xz-fluid_contacts[i].xz);
-    wake+=exp(-d*d/1.3-age*2.4)*smoothstep(.03,.10,fluid_strength[i])*.16;
+    wake+=exp(-d*d/1.6-age*2.0)*smoothstep(.03,.10,fluid_strength[i])*.26;
   }
   float shoreFoam=(1.-smoothstep(.10,.8,thickness))*(.35+.65*foamNoise)*.65;
   float crestFoam=smoothstep(.45,.9,crest)*smoothstep(5.,1.2,thickness)*foamNoise*.7;
