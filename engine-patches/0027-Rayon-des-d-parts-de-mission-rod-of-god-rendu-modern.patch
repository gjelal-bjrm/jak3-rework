diff --git a/game/graphics/opengl_renderer/ModernBeam.h b/game/graphics/opengl_renderer/ModernBeam.h
new file mode 100644
index 00000000..8a965bd7
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernBeam.h
@@ -0,0 +1,102 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <memory>
+#include <mutex>
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+
+// Rayon de lumiere des departs de mission (« rod-of-god » de task-arrow) : le modele natif (cylindre jaune
+// opaque d'apparence) est masque par GOAL, qui publie chaque image la position, le rayon et l'intensite.
+// Rendu moderne : puits de lumiere translucide et additif (coeur plus lumineux, bords doux, filets de
+// lumiere qui montent, s'estompe en hauteur), lueur douce au sol, fondu au contact du decor.
+namespace BeamState {
+struct Beam {
+  float x = 0, y = 0, z = 0, radius = 0, alpha = 0;
+  std::chrono::steady_clock::time_point stamp;
+};
+inline std::mutex mutex;
+inline std::array<Beam, 4> beams{};
+
+// io : x y z (unites du jeu), w = rayon (unites), puis alpha (0..1) au flottant suivant.
+inline void publish(const float* io) {
+  std::lock_guard<std::mutex> guard(mutex);
+  const auto now = std::chrono::steady_clock::now();
+  Beam b; b.x = io[0] / 4096.f; b.y = io[1] / 4096.f; b.z = io[2] / 4096.f;
+  b.radius = io[3] / 4096.f; b.alpha = io[4]; b.stamp = now;
+  if (!std::isfinite(b.x) || !std::isfinite(b.radius) || !std::isfinite(b.alpha)) return;
+  // meme rayon qu'une entree existante (a 1 m pres) ou emplacement le plus ancien
+  int slot = 0; auto oldest = now;
+  for (int i = 0; i < int(beams.size()); i++) {
+    const auto& e = beams[i];
+    if (std::abs(e.x - b.x) < 1.f && std::abs(e.z - b.z) < 1.f) { slot = i; oldest = {}; break; }
+    if (e.stamp < oldest) { oldest = e.stamp; slot = i; }
+  }
+  beams[slot] = b;
+}
+}  // namespace BeamState
+
+class ModernBeam {
+ public:
+  ~ModernBeam() { if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+  void render(SharedRenderState* state) {
+    if (state->version != GameVersion::Jak3 || !state->has_pc_data) return;
+    std::array<BeamState::Beam, 4> beams;
+    {
+      std::lock_guard<std::mutex> guard(BeamState::mutex);
+      beams = BeamState::beams;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    int live = 0;
+    for (auto& b : beams) {
+      if (now - b.stamp > std::chrono::milliseconds(250) || b.alpha <= .002f || b.radius <= .01f) b.alpha = 0.f;
+      else ++live;
+    }
+    if (!live) return;
+    if (!m_shader) { m_shader = std::make_unique<Shader>("modern_beam", state->version); glGenVertexArrays(1, &m_vao); }
+    if (!m_shader->okay()) return;
+    GLint program, vao, depth_func, active, src_rgb, dst_rgb, src_a, dst_a, eq_rgb, eq_a;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func); glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write);
+    glGetBooleanv(GL_COLOR_WRITEMASK, color_mask); glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb); glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_a); glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_a);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_a);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST};
+    GLboolean was[5];
+    for (int i = 0; i < 5; i++) { was[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+    m_shader->activate();
+    const GLuint id = m_shader->id();
+    m_scene.bind(state, id);   // profondeur de la scene : fondu doux au contact du decor
+    glUniform1i(glGetUniformLocation(id, "tex_T26"), 26);
+    glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
+    glUniform4fv(glGetUniformLocation(id, "cam_trans"), 1, state->camera_pos.data());
+    glUniform1f(glGetUniformLocation(id, "beam_time"), LiquidSnapshot::seconds());
+    glBindVertexArray(m_vao);
+    glEnable(GL_DEPTH_TEST); glDepthFunc(GL_GEQUAL); glDepthMask(GL_FALSE);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+    glEnable(GL_BLEND); glBlendEquation(GL_FUNC_ADD); glBlendFunc(GL_ONE, GL_ONE);
+    for (const auto& b : beams) {
+      if (b.alpha <= 0.f) continue;
+      glUniform4f(glGetUniformLocation(id, "beam_base"), b.x, b.y, b.z, b.radius);
+      glUniform1f(glGetUniformLocation(id, "beam_alpha"), std::min(b.alpha, 1.f));
+      glUniform1i(glGetUniformLocation(id, "beam_part"), 0);
+      glDrawArrays(GL_TRIANGLES, 0, 6);   // puits de lumiere
+      glUniform1i(glGetUniformLocation(id, "beam_part"), 1);
+      glDrawArrays(GL_TRIANGLES, 0, 6);   // lueur au sol
+    }
+    glUseProgram(program); glBindVertexArray(vao); glDepthFunc(depth_func); glDepthMask(depth_write);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]);
+    glBlendFuncSeparate(src_rgb, dst_rgb, src_a, dst_a); glBlendEquationSeparate(eq_rgb, eq_a);
+    for (int i = 0; i < 5; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+    glActiveTexture(active);
+  }
+
+ private:
+  std::unique_ptr<Shader> m_shader;
+  LiquidSnapshot m_scene;
+  GLuint m_vao = 0;
+};
