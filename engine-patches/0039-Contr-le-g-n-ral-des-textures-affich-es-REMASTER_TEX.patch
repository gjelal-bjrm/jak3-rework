     const int kind=state->version==GameVersion::Jak3 && texture>=0 &&
         size_t(texture)<m_kinds.size() ? m_kinds[texture] : 0;
     glUniform1i(glGetUniformLocation(program,"palace_material"),kind);
@@ -151,6 +158,8 @@ class PalaceMaterials {
   }
