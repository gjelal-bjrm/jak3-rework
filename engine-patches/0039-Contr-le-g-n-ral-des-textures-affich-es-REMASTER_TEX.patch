+// Inventaire : noms et tailles des textures de chaque niveau d'un dossier (copies comprises), en JSON.
+int list_textures(const fs::path& directory,const fs::path& output) {
+  json result=json::object();
+  for(const auto& entry:fs::directory_iterator(directory)) {
+    if(entry.path().extension()!=".fr3")continue;
+    try {
+      auto level=read_native_level(entry.path());
+      json textures=json::array();
+      for(const auto& t:level.textures)textures.push_back({t.debug_name,t.w,t.h});
+      result[entry.path().stem().string()]=textures;
+    }catch(const std::exception& error){fmt::print(stderr,"{} : {}\n",entry.path().string(),error.what());}
+  }
+  file_util::write_text_file(output,result.dump());
+  fmt::print("Texture inventory: {} levels\n",result.size());
+  return 0;
+}
+
 int main(int argc,char** argv) {
+  if(argc==4&&std::string(argv[1])=="--list-textures")return list_textures(argv[2],argv[3]);
   if(argc==5&&std::string(argv[1])=="--audit-bvh-coverage")
     return audit_static_bvh_coverage(argv[2],argv[3],argv[4]);
   if(argc==5&&std::string(argv[1])=="--compare-native")return compare_native(argv[2],argv[3],argv[4]);
