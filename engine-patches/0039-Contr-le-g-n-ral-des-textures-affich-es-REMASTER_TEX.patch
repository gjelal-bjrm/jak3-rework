+// Controle general des textures (variable d'environnement REMASTER_TEXTURE_AUDIT=1) : a la premiere utilisation
+// de chaque texture de decor (tfrag, tie, shrub), note dans le journal son niveau, son nom et la taille de la
+// texture reellement liee sur la carte graphique. Permet de verifier qu'une texture HD est bien affichee.
+class TextureAudit {
+ public:
+  static bool enabled() {
+    static const bool on = std::getenv("REMASTER_TEXTURE_AUDIT") != nullptr;
+    return on;
+  }
+  static void record(const std::string& level, const std::string& name) {
+    static std::unordered_set<std::string> seen;
+    if (!seen.insert(level + "/" + name).second) return;
+    GLint w = 0, h = 0;
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_WIDTH, &w);
+    glGetTexLevelParameteriv(GL_TEXTURE_2D, 0, GL_TEXTURE_HEIGHT, &h);
+    lg::info("Texture audit: {} {} {}x{}", level, name, w, h);
+  }
+};
