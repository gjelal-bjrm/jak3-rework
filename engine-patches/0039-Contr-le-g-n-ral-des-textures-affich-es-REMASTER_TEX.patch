     const bool arena = level.level_name.rfind("wasstad", 0) == 0;
+    m_level = level.level_name;
+    if (TextureAudit::enabled()) {           // controle : noms de toutes les textures, dans tous les niveaux
+      m_all_names.clear();
+      for (const auto& texture : level.textures) m_all_names.push_back(texture.debug_name);
+    }
     if (level.level_name != "waspala" && !market && !arena) return;
     int count=0, high_res=0;
     for (const auto& texture : level.textures) {
@@ -42,6 +47,8 @@ class PalaceMaterials {
     }
   }
   void bind(GLuint program, int texture, const SharedRenderState* state) const {
+    if (TextureAudit::enabled() && texture >= 0 && size_t(texture) < m_all_names.size())
