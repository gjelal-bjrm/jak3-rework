diff --git a/game/graphics/opengl_renderer/PalaceFireSources.inc b/game/graphics/opengl_renderer/PalaceFireSources.inc
new file mode 100644
index 00000000..92ca22ea
--- /dev/null
+++ b/game/graphics/opengl_renderer/PalaceFireSources.inc
@@ -0,0 +1,28 @@
+// Foyers du palais de Spargus (24 braseros ; flammes natives deja coupees dans WASPALA.DGO).
+// Extrait de l ancien shader palace_fire.vert : x, y, z (m), rayon, hauteur, empreinte, fond du combustible.
+constexpr float kPalaceFires[24][7] = {
+  {2068.347656,245.195191,-439.520416,0.850, 3.500, 0.896473, -0.602500},
+  {2044.332520,260.605389,-427.963776,1.750, 7.000, 1.500000, 0.000000},
+  {2012.435425,256.637372,-416.933777,1.200, 5.000, 1.000000, 0.000000},
