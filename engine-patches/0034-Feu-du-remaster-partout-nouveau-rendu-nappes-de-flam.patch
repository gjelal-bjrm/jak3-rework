diff --git a/game/graphics/opengl_renderer/ModernFire.h b/game/graphics/opengl_renderer/ModernFire.h
new file mode 100644
index 00000000..df35ebae
--- /dev/null
+++ b/game/graphics/opengl_renderer/ModernFire.h
@@ -0,0 +1,235 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <functional>
+#include <map>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+#include "common/log/log.h"
+#include "game/graphics/opengl_renderer/Shader.h"
+#include "game/graphics/opengl_renderer/BucketRenderer.h"
+#include "game/graphics/opengl_renderer/CityFireSources.h"
+#include "game/graphics/opengl_renderer/FireField.h"
+#include "game/graphics/opengl_renderer/ModernAO.h"
+#include "game/graphics/opengl_renderer/background/LiquidSnapshot.h"
+#include "game/graphics/opengl_renderer/loader/Loader.h"
+
+namespace PalaceFireTable {
+#include "PalaceFireSources.inc"
+}
+
+// Feu du remaster, partout dans le jeu (remplace le prototype du palais et de la ville).
+// Foyers : les 24 braseros du palais, les 61 feux ajustes de la ville (part-spawners) et, partout ailleurs, les
+// flammes natives « flame01 » reperees par Sprite3, regroupees en foyers suivis d'une image a l'autre.
+// Rendu (avant l'eau, pour que les reflets et la refraction les voient) :
+//   1. lumiere vacillante sur le decor proche et air qui tremble au-dessus des flammes (image entiere) ;
+//   2. flammes : trois nappes par foyer tournees vers la camera, langues decoupees par une turbulence qui monte,
+//      coeur jaune-blanc, bords orange puis rouges, bouts qui se detachent en haut (style peint, bords nets) ;
+//   3. etincelles qui s'envolent en tournoyant.
+class ModernFire {
+ public:
+  struct Source {
+    float x, y, z, r, h, seed, strength;
+  };
+
+  ~ModernFire() { if (m_vao) glDeleteVertexArrays(1, &m_vao); }
+
+  bool enabled() const { return LightingState::flags.load() & 4; }
+
+  void render(SharedRenderState* state) {
+    FireField::enabled = enabled();
+    if (!FireField::enabled || !state->has_pc_data || state->version != GameVersion::Jak3) return;
+    if (m_render_frame == state->frame_idx) return;
+    m_render_frame = state->frame_idx;
+    const float now = LiquidSnapshot::seconds();
+    const float ex = state->camera_pos[0] / 4096.f, ey = state->camera_pos[1] / 4096.f, ez = state->camera_pos[2] / 4096.f;
+    track(FireField::take(state->frame_idx), now);
+    std::vector<Source> sources = gather(state, now);
+    if (sources.empty()) return;
+    // du plus loin au plus proche (melange additif : l'ordre ne change que les etincelles)
+    auto d2 = [&](const Source& s) { return (s.x - ex) * (s.x - ex) + (s.y - ey) * (s.y - ey) + (s.z - ez) * (s.z - ez); };
+    std::sort(sources.begin(), sources.end(), [&](const Source& a, const Source& b) { return d2(a) < d2(b); });
+    if (sources.size() > kMaxFlames) sources.resize(kMaxFlames);
+    if (!m_flames) init(state);
+    if (!m_flames->okay() || !m_light->okay() || !m_sparks->okay()) return;
+
+    GLint program, vao, depth_func, active, src_rgb, dst_rgb, src_alpha, dst_alpha, eq_rgb, eq_alpha;
+    GLboolean depth_write, color_mask[4];
+    glGetIntegerv(GL_CURRENT_PROGRAM, &program); glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    glGetIntegerv(GL_DEPTH_FUNC, &depth_func); glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &src_rgb); glGetIntegerv(GL_BLEND_DST_RGB, &dst_rgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &src_alpha); glGetIntegerv(GL_BLEND_DST_ALPHA, &dst_alpha);
+    glGetIntegerv(GL_BLEND_EQUATION_RGB, &eq_rgb); glGetIntegerv(GL_BLEND_EQUATION_ALPHA, &eq_alpha);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &depth_write); glGetBooleanv(GL_COLOR_WRITEMASK, color_mask);
+    const GLenum flags[] = {GL_DEPTH_TEST, GL_BLEND, GL_CULL_FACE, GL_SCISSOR_TEST, GL_STENCIL_TEST, GL_PROGRAM_POINT_SIZE};
+    GLboolean was[6];
+    for (int i = 0; i < 6; i++) { was[i] = glIsEnabled(flags[i]); glDisable(flags[i]); }
+    glBindVertexArray(m_vao);
+    glDepthMask(GL_FALSE); glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_FALSE);
+
+    // tableaux des foyers (lumiere : les 12 plus proches)
+    const int n = int(sources.size());
+    std::vector<float> pos(4 * n), info(4 * n);
+    for (int i = 0; i < n; i++) {
+      pos[4 * i] = sources[i].x; pos[4 * i + 1] = sources[i].y; pos[4 * i + 2] = sources[i].z; pos[4 * i + 3] = sources[i].r;
+      info[4 * i] = sources[i].h; info[4 * i + 1] = sources[i].seed; info[4 * i + 2] = sources[i].strength; info[4 * i + 3] = 0;
+    }
+    auto bind = [&](Shader& shader, int count) {
+      shader.activate();
+      const GLuint id = shader.id();
+      glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
+      glUniform4fv(glGetUniformLocation(id, "cam_trans"), 1, state->camera_pos.data());
+      glUniform1f(glGetUniformLocation(id, "fire_time"), now);
+      glUniform1i(glGetUniformLocation(id, "fire_count"), count);
+      glUniform4fv(glGetUniformLocation(id, "fire_pos"), count, pos.data());
+      glUniform4fv(glGetUniformLocation(id, "fire_info"), count, info.data());
+      glUniform1f(glGetUniformLocation(id, "viewport_height"), float(state->render_fb_h));
+      m_scene.bind(state, id);
+    };
+    // 1. lumiere et air chaud (remplace l'image : lit la copie de la scene)
+    bind(*m_light, std::min(n, 12));
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    // 2. flammes (additives, cachees par le decor)
+    bind(*m_flames, n);
+    glEnable(GL_BLEND); glBlendEquation(GL_FUNC_ADD); glBlendFunc(GL_ONE, GL_ONE);
+    glEnable(GL_DEPTH_TEST); glDepthFunc(GL_GEQUAL);
+    glDrawArraysInstanced(GL_TRIANGLES, 0, 6, n * 3);
+    // 3. etincelles
+    bind(*m_sparks, n);
+    glEnable(GL_PROGRAM_POINT_SIZE);
+    glDrawArrays(GL_POINTS, 0, n * kSparks);
+
+    glUseProgram(program); glBindVertexArray(vao); glDepthFunc(depth_func); glDepthMask(depth_write);
+    glBlendFuncSeparate(src_rgb, dst_rgb, src_alpha, dst_alpha); glBlendEquationSeparate(eq_rgb, eq_alpha);
+    glColorMask(color_mask[0], color_mask[1], color_mask[2], color_mask[3]); glActiveTexture(active);
+    for (int i = 0; i < 6; i++) { if (was[i]) glEnable(flags[i]); else glDisable(flags[i]); }
+  }
+
+ private:
+  static constexpr size_t kMaxFlames = 48;
+  static constexpr int kSparks = 12;
+  struct Tracked {
+    Source s;
+    float seen = 0, born = 0;
+  };
+
+  void init(SharedRenderState* state) {
+    m_flames = std::make_unique<Shader>("modern_fire", state->version);
+    m_light = std::make_unique<Shader>("modern_fire_light", state->version);
+    m_sparks = std::make_unique<Shader>("modern_fire_sparks", state->version);
+    glGenVertexArrays(1, &m_vao);
+    CityFireSources::ready();          // les feux ajustes de la ville ne dessinent plus leurs flammes natives
+    lg::info("Feu du remaster : palais, ville et flammes natives remplacees partout");
+  }
+
+  // Regroupe les particules de flamme de l'image precedente en foyers et les suit d'une image a l'autre.
+  void track(const std::vector<FireField::Particle>& parts, float now) {
+    if (!parts.empty()) {
+      const float cell = 1.1f;
+      std::unordered_map<long long, std::vector<int>> grid;
+      auto key = [&](float x, float z) {
+        return (long long)std::floor(x / cell) * 1000003LL + (long long)std::floor(z / cell);
+      };
+      for (int i = 0; i < int(parts.size()); i++) grid[key(parts[i].x, parts[i].z)].push_back(i);
+      std::vector<int> parent(parts.size());
+      for (size_t i = 0; i < parent.size(); i++) parent[i] = int(i);
+      std::function<int(int)> find = [&](int a) { return parent[a] == a ? a : parent[a] = find(parent[a]); };
+      for (int i = 0; i < int(parts.size()); i++) {
+        const auto& p = parts[i];
+        for (int dx = -1; dx <= 1; dx++)
+          for (int dz = -1; dz <= 1; dz++) {
+            auto it = grid.find(key(p.x + dx * cell, p.z + dz * cell));
+            if (it == grid.end()) continue;
+            for (int j : it->second) {
+              const auto& q = parts[j];
+              if (std::abs(q.x - p.x) < cell && std::abs(q.z - p.z) < cell && std::abs(q.y - p.y) < 3.f)
+                parent[find(i)] = find(j);
+            }
+          }
+      }
+      std::map<int, std::vector<int>> clusters;
+      for (int i = 0; i < int(parts.size()); i++) clusters[find(i)].push_back(i);
+      for (auto& [root, members] : clusters) {
+        float w = 0, cx = 0, cz = 0, base = 1e9f, top = -1e9f, size = 0;
+        for (int i : members) {
+          const auto& p = parts[i];
+          const float wi = std::max(p.alpha, .02f) * std::max(p.size, .05f);
+          w += wi; cx += wi * p.x; cz += wi * p.z; size += p.size;
+          base = std::min(base, p.y - p.size * .35f); top = std::max(top, p.y + p.size * .5f);
+        }
+        cx /= w; cz /= w; size /= float(members.size());
+        float spread = 0;
+        for (int i : members) {
+          const auto& p = parts[i];
+          const float wi = std::max(p.alpha, .02f) * std::max(p.size, .05f);
+          spread += wi * ((p.x - cx) * (p.x - cx) + (p.z - cz) * (p.z - cz));
+        }
+        spread = std::sqrt(spread / w);
+        Source s{cx, base, cz, std::clamp(spread * 1.3f + size * .35f, .18f, 3.f),
+                 std::clamp((top - base) * 1.1f, .45f, 7.f), 0.f, 1.f};
+        // foyer deja suivi ?
+        Tracked* best = nullptr; float bd = 1e9f;
+        for (auto& t : m_tracked) {
+          const float d = std::hypot(t.s.x - s.x, t.s.z - s.z);
+          if (d < std::max(1.2f, t.s.r * 1.5f) && std::abs(t.s.y - s.y) < 3.f && d < bd) { bd = d; best = &t; }
+        }
+        if (best) {
+          auto& t = best->s;
+          t.x += (s.x - t.x) * .12f; t.z += (s.z - t.z) * .12f; t.y += (s.y - t.y) * .08f;
+          t.r += (s.r - t.r) * .06f; t.h += (s.h - t.h) * .06f;
+          best->seen = now;
+        } else {
+          Tracked t; t.s = s; t.s.seed = float(m_tracked.size() * 7 + 3) * .731f; t.seen = t.born = now;
+          m_tracked.push_back(t);
+        }
+      }
+    }
+    // intensite : monte en 0,3 s, s'eteint 0,5 s apres la derniere flamme native
+    for (auto& t : m_tracked) {
+      const float rise = std::clamp((now - t.born) / .3f, 0.f, 1.f);
+      const float fall = 1.f - std::clamp((now - t.seen - .15f) / .5f, 0.f, 1.f);
+      t.s.strength = rise * fall;
+    }
+    m_tracked.erase(std::remove_if(m_tracked.begin(), m_tracked.end(), [&](const Tracked& t) { return now - t.seen > .7f; }),
+                    m_tracked.end());
+  }
+
+  std::vector<Source> gather(SharedRenderState* state, float now) {
+    std::vector<Source> out;
+    unsigned regions = 0; bool palace = false;
+    for (auto* level : state->loader->get_in_use_levels()) {
+      const auto& name = level->level->level_name;
+      if (name == "wascitya") regions |= 1u << 1;
+      if (name == "wascityb") regions |= 1u << 2;
+      if (name == "waspala") palace = true;
+    }
+    if (palace) {                      // braseros : flamme posee sur les braises (fond du combustible)
+      for (int i = 0; i < 24; i++) {
+        const auto* f = PalaceFireTable::kPalaceFires[i];
+        // braseros sur pied (fond de braises connu) : juste sous le bord ; vasques murales : plus profondes
+        const float base = f[6] < 0.f ? f[1] + f[6] * .3f : f[1] + f[4] * .30f - .2f;
+        out.push_back({f[0], base, f[2], f[3] * 1.f, f[4] * .6f, float(i) * 1.713f, 1.f});
+      }
+    }
+    if (regions) {
+      for (const auto& c : CityFireSources::snapshot(regions, state->camera_pos.data()))
+        out.push_back({c.position[0], c.position[1] - .3f, c.position[2], c.position[3] * .6f, c.height * .8f, c.seed, 1.f});
+    }
+    for (const auto& t : m_tracked)
+      if (t.s.strength > .01f) out.push_back(t.s);
+    // au-dela de 150 m, le feu natif lointain n'est de toute facon plus lisible
+    const float ex = state->camera_pos[0] / 4096.f, ez = state->camera_pos[2] / 4096.f;
+    out.erase(std::remove_if(out.begin(), out.end(), [&](const Source& s) {
+      return std::hypot(s.x - ex, s.z - ez) > 150.f; }), out.end());
+    (void)now;
+    return out;
+  }
+
+  std::unique_ptr<Shader> m_flames, m_light, m_sparks;
+  LiquidSnapshot m_scene;
+  GLuint m_vao = 0;
+  u64 m_render_frame = UINT64_MAX;
+  std::vector<Tracked> m_tracked;
+};
