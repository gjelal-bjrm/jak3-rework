-  float dsum=0.,step=140.;
-  for(int i=1;i<=3;i++){
+  float dsum=0.,step=210.;
+  for(int i=1;i<=2;i++){
     vec3 q=p+L*step*float(i);
     if(q.y>CLOUD_TOP+50.)break;
     dsum+=cloudDensity(q,coverage,.7)*step;
   }
-  return exp(-dsum*.0075);
+  return exp(-dsum*.0060);
 }
