       float theta=atan(local.y,local.x);
-      float wobble=.0022*sin(theta*5.+sky_time*.9)+.0012*sin(theta*9.-sky_time*1.7);
-      float ring=exp(-pow((angle-.040-wobble)*420.,2.))*(.45+.55*noise(vec2(theta*3.+sky_time*.4,sky_time*.2)));
-      // quatre aigrettes fines
-      float spikes=(exp(-abs(local.x)*900.)*exp(-abs(local.y)*40.)+exp(-abs(local.y)*900.)*exp(-abs(local.x)*40.))*smoothstep(.06,.0,angle);
-      vec3 star=core*coreDisc*2.4*pulse+violet*halo*pulse+violet*spikes*.9;
-      result=mix(result,dark,ring*.40*smoothstep(.0,.008,angle));
-      result+=star;
-      result+=violet*ring*.12;
+      // battement sourd : lent, avec un second coup plus faible
+      float beat=pow(max(sin(sky_time*1.55),0.),12.)+.45*pow(max(sin(sky_time*1.55-.9),0.),12.);
+      vec3 violet=vec3(.58,.30,1.);
+      vec3 rimColor=mix(vec3(.85,.72,1.),vec3(1.),.35);
+      // 1. zone corrompue : le ciel s'assombrit et se desature autour du vaisseau (rayon ~2,5 deg)
+      float corrupt=exp(-angle*angle/(2.*.030*.030));
+      vec3 grey=vec3(dot(result,vec3(.3,.5,.2)));
+      result=mix(result,mix(grey,vec3(.10,.05,.16),.5),corrupt*.40);
+      // 2. rais sombres continus qui partent du disque, lents, irreguliers en longueur
+      float rayNoise=noise(vec2(theta*4.5+sky_time*.04,.5))*.7+noise(vec2(theta*11.-sky_time*.07,3.1))*.3;
+      float rayLen=.03+.06*rayNoise;
+      float rays=smoothstep(.55,.85,rayNoise)*smoothstep(rayLen,rayLen*.3,angle)*smoothstep(.011,.016,angle);
