     std::lock_guard<std::mutex> guard(WeatherLook::mutex);
diff --git a/game/graphics/opengl_renderer/background/Hfrag.cpp b/game/graphics/opengl_renderer/background/Hfrag.cpp
index c1fc9c9c..40e93f1a 100644
--- a/game/graphics/opengl_renderer/background/Hfrag.cpp
+++ b/game/graphics/opengl_renderer/background/Hfrag.cpp
@@ -214,6 +214,41 @@ void Hfrag::load_hfrag_level(const std::string& load_name,
   lev->hfrag = &data->level->hfrag;
   lev->wang_texture = data->textures.at(data->level->hfrag.wang_tree_tex_id[0]);
   lev->sand_hd_texture = 0;
+  // remaster : couleur moyenne des carreaux de sable. Le carreau (8 m, sans niveaux de detail) grésille au loin
+  // (un texel au hasard par pixel : on y reconnait l'ancien sol) ; au loin, le shader utilise cette moyenne.
+  {
+    const auto& tile = data->level->textures.at(data->level->hfrag.wang_tree_tex_id[0]);
+    double sum[4] = {0., 0., 0., 0.};
+    for (u32 px : tile.data)
+      for (int k = 0; k < 4; k++) sum[k] += double((px >> (8 * k)) & 0xff);
+    const double n = double(std::max<size_t>(tile.data.size(), 1)) * 255.;
+    for (int k = 0; k < 4; k++) lev->tile_mean[k] = float(sum[k] / n);
+  }
+  // remaster : couleurs de l'eau peinte (grande cascade du desert : pente du terrain peinte en bleu-vert), reperees
+  // une fois pour toutes. Les 8 palettes du terrain sont des intensites (gris) que l'heure melange avec des poids
+  // par canal ; au couchant, le sable a l'ombre bleuit et, juge sur la couleur du moment, il devenait de l'eau par
+  // taches. On juge donc la couleur que donnent les poids de 13 h par beau temps (releves en jeu, heure stable).
+  {
+    static constexpr int kNoon[8][3] = {{26, 33, 38}, {0, 0, 0},    {27, 25, 20}, {82, 75, 60},
+                                        {0, 0, 0},    {33, 33, 33}, {32, 32, 32}, {64, 64, 64}};
+    const auto& tod = lev->hfrag->time_of_day_colors;
+    auto smooth = [](float e0, float e1, float x) {
+      const float t = std::clamp((x - e0) / (e1 - e0), 0.f, 1.f);
+      return t * t * (3.f - 2.f * t);
+    };
+    lev->water_mask.assign(tod.color_count, 0);
+    int count = 0;
+    for (u32 i = 0; i < tod.color_count; i++) {
+      float c[3] = {0.f, 0.f, 0.f};
+      for (int k = 0; k < 8; k++)
+        for (int ch = 0; ch < 3; ch++) c[ch] += float(kNoon[k][ch]) * tod.read(i, k, ch);
+      const float r = std::max(c[0], 1.f);
+      const float m = smooth(1.16f, 1.30f, c[2] / r) * smooth(1.08f, 1.16f, c[1] / r);
+      lev->water_mask[i] = u8(std::lround(m * 255.f));
+      if (m > .5f) count++;
+    }
+    lg::info("Hfrag {} : {} couleurs d'eau peinte sur {}", load_name, count, tod.color_count);
+  }
   // remaster : carte des hauteurs du terrain (le maillage est une grille 512 x 512 de sommets espaces de 8 m ;
   // vi = x + 512 z). Sert a calculer au pixel la pente des dunes (eclairage du relief, rides, paillettes).
   {
@@ -434,6 +469,8 @@ void Hfrag::render_hfrag_level(Hfrag::HfragLevel* lev,
 
   // generate time of day texture
   interp_time_of_day(pc_data.camera.itimes, lev->hfrag->time_of_day_colors, m_color_result.data());
+  // remaster : alpha (inutilise par le dessin) = eau peinte, fixe quelle que soit l'heure
+  for (u32 i = 0; i < lev->num_colors && i < lev->water_mask.size(); i++) m_color_result[i][3] = lev->water_mask[i];
   glActiveTexture(GL_TEXTURE10);
   glBindTexture(GL_TEXTURE_1D, lev->time_of_day_texture);
   glTexSubImage1D(GL_TEXTURE_1D, 0, 0, lev->num_colors, GL_RGBA, GL_UNSIGNED_INT_8_8_8_8_REV,
@@ -490,6 +527,10 @@ void Hfrag::render_hfrag_level(Hfrag::HfragLevel* lev,
       glUniform3fv(glGetUniformLocation(program, "weather_sun_color"), 1, sun_color.data());
       glUniform3fv(glGetUniformLocation(program, "weather_sky"), 1, sky.data());
       glUniform1f(glGetUniformLocation(program, "weather_sun_strength"), sun_strength);
+      float cloud;
+      { std::lock_guard<std::mutex> guard(WeatherState::mutex); cloud = WeatherState::cloud_cover(); }
+      glUniform1f(glGetUniformLocation(program, "weather_cloud"), cloud);
+      glUniform4fv(glGetUniformLocation(program, "sand_tile_mean"), 1, lev->tile_mean);
     }
     // sable HD (texture ajoutee au niveau du desert) : unite 4, repetee, avec niveaux de mip
     glUniform1i(glGetUniformLocation(program, "sand_hd"), 4);
diff --git a/game/graphics/opengl_renderer/background/Hfrag.h b/game/graphics/opengl_renderer/background/Hfrag.h
index b2344894..45a63335 100644
--- a/game/graphics/opengl_renderer/background/Hfrag.h
+++ b/game/graphics/opengl_renderer/background/Hfrag.h
@@ -37,6 +37,8 @@ class Hfrag : public BucketRenderer {
     GLuint wang_texture;
     GLuint sand_hd_texture = 0;   // remaster : sable HD pose selon le monde (0 : absent)
     GLuint height_texture = 0;    // remaster : hauteurs du terrain (grille 512 x 512, 8 m) -> relief eclaire au pixel
+    float tile_mean[4] = {.5f, .5f, .5f, .5f};   // remaster : couleur moyenne des carreaux (lointains sans grésillement)
+    std::vector<u8> water_mask;   // remaster : eau peinte (cascade) par couleur, reperee sur la palette de midi
 
     MontageTexture montage_texture[kNumBuckets];
     GLuint montage_vertices;
diff --git a/game/graphics/opengl_renderer/shaders/hfrag.frag b/game/graphics/opengl_renderer/shaders/hfrag.frag
index 83661856..2ccf68fd 100644
--- a/game/graphics/opengl_renderer/shaders/hfrag.frag
+++ b/game/graphics/opengl_renderer/shaders/hfrag.frag
@@ -7,6 +7,7 @@ in vec2 tex_coord;
 in float fogginess;
 in vec3 world_pos;   // metres
 in vec3 eye_pos;     // metres
+in float water_mask;  // eau peinte (cascade du desert), 0..1
 uniform sampler2D tex_T0;
 uniform vec4 fog_color;
 
@@ -30,7 +31,9 @@ uniform vec3 weather_sky;
 uniform float weather_sun_strength;
 uniform int sand_detail;   // bit 0 : tout ; bits 1..3 : rides, grain, teintes (tests)
 uniform int sand_debug;    // test : couleur des sommets seule
-uniform float sand_time;   // s (animation de l'eau peinte sur le terrain)
+uniform float sand_time;   // s (animation de l'eau peinte sur le terrain, ombres des nuages)
+uniform float weather_cloud;   // couverture nuageuse de la meteo (0..1) : ombres des nuages sur les dunes
+uniform vec4 sand_tile_mean;   // couleur moyenne du carreau d'origine (au loin, a la place du carreau qui grésille)
 
 // SUN_SHADOW_BEGIN (meme calcul que tfrag3.frag)
 uniform int shadow_on;
@@ -93,6 +96,15 @@ vec3 duneNormal(vec2 q) {
   float hd = texture(sand_height, uv - vec2(0., t)).r, hu = texture(sand_height, uv + vec2(0., t)).r;
   return normalize(vec3(-(hr - hl) / (4096. * 16.), 1., -(hu - hd) / (4096. * 16.)));
 }
+// pente des grandes formes seulement (ecart de 48 m) : les bosses de quelques dizaines de metres n'y comptent pas
+vec3 duneNormalWide(vec2 q) {
+  if (sand_height_on == 0) return vec3(0., 1., 0.);
+  const float t = 1. / 512.;
+  vec2 uv = (q / 8. + .5) * t;
+  float hl = texture(sand_height, uv - vec2(3. * t, 0.)).r, hr = texture(sand_height, uv + vec2(3. * t, 0.)).r;
+  float hd = texture(sand_height, uv - vec2(0., 3. * t)).r, hu = texture(sand_height, uv + vec2(0., 3. * t)).r;
+  return normalize(vec3(-(hr - hl) / (4096. * 48.), 1., -(hu - hd) / (4096. * 48.)));
+}
 
 // ---------------------------------------------------------------- rides de vent
 const vec2 WIND = vec2(.83, .56);
@@ -125,6 +137,42 @@ vec2 rippleSlope(vec2 q, float footprint) {
   return s;
 }
 
+// grandes ondulations de vent (22 m et 47 m) : dessinees par le soleil, visibles jusqu'a l'horizon (les rides fines
+// s'effacent au loin, celles-ci restent : de loin, le desert garde son dessin)
+// ondulation continue (pas de zones vides : de petites taches d'ombre isolees ressemblaient a des trous)
+float dune(vec2 q, float lambda, float amp, float seed) {
+  vec2 d = normalize(WIND + vec2(.15, -.10));   // un peu tournees par rapport aux rides fines
+  float warp = sandNoise(q * (.065 / lambda) + seed) * 2.2 + sandNoise(q * (.28 / lambda) + seed * 1.7) * .45;
+  float f = fract(dot(q, d) / lambda + warp);
+  float h = f < .72 ? f / .72 : (1. - f) / .28;
+  h = h * h * (3. - 2. * h);
+  float patchy = .55 + .45 * smoothstep(-.6, .4, sandNoise(q * (.03 / lambda) + 3.1 + seed));
+  return h * amp * patchy;
+}
+vec2 macroSlope(vec2 q, float footprint) {
+  float v1 = 1. - smoothstep(4., 9., footprint), v2 = 1. - smoothstep(8., 18., footprint);
+  if (v2 <= 0. || (sand_detail & 2) == 0) return vec2(0.);
+  float e = max(.8, footprint * .5);
+  vec2 s = vec2(0.);
+  if (v1 > 0.) {
+    float h0 = dune(q, 22., .9, 31.);
+    s += v1 * vec2(dune(q + vec2(e, 0.), 22., .9, 31.) - h0, dune(q + vec2(0., e), 22., .9, 31.) - h0) / e;
+  }
+  float g0 = dune(q, 47., 1.7, 57.);
+  s += v2 * vec2(dune(q + vec2(e, 0.), 47., 1.7, 57.) - g0, dune(q + vec2(0., e), 47., 1.7, 57.) - g0) / e;
+  return s;
+}
+
+// ombres des nuages qui glissent sur le desert (meme calcul dans tfrag3.frag : roches et sable ensemble) :
+// grandes taches douces (plusieurs centaines de metres, bords flous), ~3 m/s ; de petites taches nettes
+// ressemblaient a des salissures sur le sable
+float cloudShadow(vec2 q, float t) {
+  vec2 p = q / 700. + t * vec2(.0036, .0022);
+  float n = sandNoise(p) * .60 + sandNoise(p * 2.3 + 7.3) * .28 + sandNoise(p * 5.1 + 3.1) * .12;
+  float threshold = mix(.62, -.25, clamp(weather_cloud, 0., 1.));   // plus de nuages -> plus d'ombres
+  return smoothstep(threshold - .25, threshold + .25, n);
+}
+
 // ---------------------------------------------------------------- sable HD peint (texture Codex) en fin detail
 uniform sampler2D sand_hd;
 uniform int sand_hd_on;
@@ -154,11 +202,12 @@ vec3 genshinSand(vec3 c0) {
   vec2 q = P.xz;
   vec3 V = normalize(eye_pos - P);
   float footprint = max(length(dFdx(P)), length(dFdy(P)));   // metres par pixel
+  vec2 dxq = dFdx(P.xz), dyq = dFdy(P.xz);   // (derivees hors des branches : paillettes lointaines)
   vec3 Lsun = normalize(weather_sun_dir);
   float day = smoothstep(-.02, .22, Lsun.y) * clamp(weather_sun_strength, .25, 1.);
   // lumiere rasante stylisee pour le modele : sous un soleil haut, les dunes gardent un flanc d'ombre lisible
   vec2 hdir = normalize(Lsun.xz + vec2(1e-4));
-  float ly = clamp(Lsun.y, .14, .38);
+  float ly = clamp(Lsun.y, .20, .42);
   vec3 L = vec3(hdir.x * sqrt(1. - ly * ly), ly, hdir.y * sqrt(1. - ly * ly));
 
   // teinte : sable chaud et sature, luminosite du jeu (heure du jour, lieux assombris par les artistes)
@@ -169,18 +218,22 @@ vec3 genshinSand(vec3 c0) {
 
   // relief : dunes (carte des hauteurs) + rides
   vec3 nT = duneNormal(q);
-  vec2 slope = rippleSlope(q, footprint);
-  vec3 n = normalize(nT + vec3(-slope.x, 0., -slope.y));
-  vec3 sunTint = vec3(1.10, 1.00, .84);
-  vec3 shadeTint = vec3(.52, .40, .47);          // ombre chaude, legerement violette (lumiere du ciel et du sable)
+  vec3 nW = duneNormalWide(q);
+  vec2 slope = rippleSlope(q, footprint) + macroSlope(q, footprint);
+  // rampe ombre / lumiere : grandes dunes et rides ; le relief moyen (bosses de 15-40 m) est modele en douceur
+  // plus bas (sans basculer dans l'ombre : sinon des taches sombres isolees au loin)
+  vec3 n = normalize(nW + vec3(-slope.x, 0., -slope.y));
+  vec3 sunTint = vec3(1.16, 1.04, .86);   // soleil de desert franc
