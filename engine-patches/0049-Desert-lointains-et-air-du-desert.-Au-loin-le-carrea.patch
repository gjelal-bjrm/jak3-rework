       glUniformMatrix4fv(glGetUniformLocation(id, "pc_camera"), 1, GL_FALSE, state->prototype_camera);
       glUniform3f(glGetUniformLocation(id, "wx_eye"), eye[0], eye[1], eye[2]);
@@ -153,12 +160,15 @@ class ModernWeather {
       glUniform1f(glGetUniformLocation(id, "wx_arena"), arena);
       glUniform1f(glGetUniformLocation(id, "wx_arena_level"), 11.5f);   // surface de la lave
       glUniform1f(glGetUniformLocation(id, "wx_desert"), desert);
+      glUniform1f(glGetUniformLocation(id, "wx_heat"), heat);
