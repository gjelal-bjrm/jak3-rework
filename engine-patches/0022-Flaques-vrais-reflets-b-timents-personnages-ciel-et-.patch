+// Reflets des flaques : copie de l'image precedente (couleur + profondeur, avant le brouillard, la pluie et
+// l'interface) avec sa camera. Le sol est dessine tot dans l'image : il ne peut pas lire l'image en cours.
+// Les flaques y lancent un rayon reflechi (batiments, personnages, ciel et nuages) ; un image de retard.
+namespace WeatherReflect {
+inline GLuint fbo = 0, color = 0, depth = 0;
+inline int width = 0, height = 0;
+inline float camera[16] = {}, inverse[16] = {}, eye[3] = {}, viewport[4] = {};
+inline bool valid = false;
+
+// Inverse d'une matrice 4x4 (Gauss-Jordan) ; meme disposition en entree et en sortie.
+inline bool invert(const float* m, float* out) {
+  double a[4][8];
+  for (int r = 0; r < 4; r++) for (int c = 0; c < 4; c++) { a[r][c] = m[c * 4 + r]; a[r][c + 4] = r == c; }
+  for (int c = 0; c < 4; c++) {
+    int pivot = c;
+    for (int r = c + 1; r < 4; r++) if (std::abs(a[r][c]) > std::abs(a[pivot][c])) pivot = r;
+    if (std::abs(a[pivot][c]) < 1e-20) return false;
+    if (pivot != c) for (int k = 0; k < 8; k++) std::swap(a[c][k], a[pivot][k]);
+    const double d = a[c][c];
+    for (int k = 0; k < 8; k++) a[c][k] /= d;
+    for (int r = 0; r < 4; r++) if (r != c) { const double f = a[r][c]; for (int k = 0; k < 8; k++) a[r][k] -= f * a[c][k]; }
+  }
+  for (int r = 0; r < 4; r++) for (int c = 0; c < 4; c++) out[c * 4 + r] = float(a[r][c + 4]);
+  return true;
+}
+
+// Appele une fois par image, avant le brouillard et les precipitations (bucket GENERIC_WARP).
+inline void capture(SharedRenderState* state) {
+  float puddles;
+  { std::lock_guard<std::mutex> guard(WeatherState::mutex); puddles = WeatherState::puddles * WeatherState::outdoor; }
+  if (puddles < .01f || state->version != GameVersion::Jak3 || !state->has_pc_data) { valid = false; return; }
+  GLint old_read, old_draw, vp[4];
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &old_read); glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &old_draw);
+  glGetIntegerv(GL_VIEWPORT, vp);
+  if (width != state->render_fb_w || height != state->render_fb_h || !fbo) {
+    if (color) glDeleteTextures(1, &color);
+    if (depth) glDeleteTextures(1, &depth);
+    if (fbo) glDeleteFramebuffers(1, &fbo);
+    width = state->render_fb_w; height = state->render_fb_h;
+    GLint active; glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+    glGenFramebuffers(1, &fbo); glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glActiveTexture(GL_TEXTURE21);
+    glGenTextures(1, &color); glBindTexture(GL_TEXTURE_2D, color);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, color, 0);
+    glActiveTexture(GL_TEXTURE22);
+    glGenTextures(1, &depth); glBindTexture(GL_TEXTURE_2D, depth);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH24_STENCIL8, width, height, 0, GL_DEPTH_STENCIL, GL_UNSIGNED_INT_24_8, nullptr);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_COMPARE_MODE, GL_NONE);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_TEXTURE_2D, depth, 0);
+    glActiveTexture(active);
+  }
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST);
+  glDisable(GL_SCISSOR_TEST);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, state->render_fb);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo);
+  glBlitFramebuffer(0, 0, width, height, 0, 0, width, height, GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT, GL_NEAREST);
+  if (scissor) glEnable(GL_SCISSOR_TEST);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, old_read); glBindFramebuffer(GL_DRAW_FRAMEBUFFER, old_draw);
+  std::memcpy(camera, state->prototype_camera, sizeof(camera));
+  float negated[16];
+  for (int i = 0; i < 16; i++) negated[i] = -camera[i];
+  valid = invert(negated, inverse);
+  eye[0] = state->camera_pos[0] / 4096.f; eye[1] = state->camera_pos[1] / 4096.f; eye[2] = state->camera_pos[2] / 4096.f;
+  for (int i = 0; i < 4; i++) viewport[i] = float(vp[i]);
+}
+
+inline void bind(GLuint program) {
+  const GLint on = glGetUniformLocation(program, "weather_reflect");
+  if (on < 0) return;
+  glUniform1i(on, valid ? 1 : 0);
+  if (!valid) return;
+  GLint active; glGetIntegerv(GL_ACTIVE_TEXTURE, &active);
+  glActiveTexture(GL_TEXTURE21); glBindTexture(GL_TEXTURE_2D, color);
+  glActiveTexture(GL_TEXTURE22); glBindTexture(GL_TEXTURE_2D, depth);
+  glActiveTexture(active);
+  glUniform1i(glGetUniformLocation(program, "weather_prev_color"), 21);
+  glUniform1i(glGetUniformLocation(program, "weather_prev_depth"), 22);
+  glUniformMatrix4fv(glGetUniformLocation(program, "weather_prev_camera"), 1, GL_FALSE, camera);
+  glUniformMatrix4fv(glGetUniformLocation(program, "weather_prev_inverse"), 1, GL_FALSE, inverse);
+  glUniform3fv(glGetUniformLocation(program, "weather_prev_eye"), 1, eye);
+  glUniform4fv(glGetUniformLocation(program, "weather_prev_viewport"), 1, viewport);
+}
+}  // namespace WeatherReflect
