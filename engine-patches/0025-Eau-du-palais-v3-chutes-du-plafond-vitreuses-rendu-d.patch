+  result+=vec3(1.0,0.82,0.55)*glint*0.55;
   float nearFade=smoothstep(0.5,2.2,length(cam_trans.xyz/4096.0-world));
   result=mix(texture(tex_T25,screen).rgb,result,nearFade);
   color=vec4(result,1.0);
